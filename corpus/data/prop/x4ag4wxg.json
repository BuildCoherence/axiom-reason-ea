   (logic_is_actual : LogicIsActual)\n    (units_are_not_portions : A UnitsAreNotPortions)\n    (hotdogs_have_unit_fillings : A HotdogsHaveUnitFillings) :\n    A NoHotdogIsASandwich :=\n  logic_is_actual.mp _ _\n    (logic_is_actual.mp _ _\n      (logic_is_actual.actual_intro _\n        (fun unp hhuf hotdog hotdog_is h => by\n          obtain ⟨_bread, filling, _bread_of, filling_of, _bounds, portion⟩ := h\n          exact unp filling (hhuf hotdog filling hotdog_is filling_of) portion))\n      units_are_not_portions)\n    hotdogs_have_unit_fillings\n\nend Sandwich\n\nend v289fr59\n","source_tokens":[{"binder_role":null,"byte_end":1615,"byte_start":1608,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"keyword","qualified_name":null,"text":"theorem","token_id":"v289fr59.Sandwich.no_hotdog_is_a_sandwich::src::0","token_role":null},{"binder_role":"def_site","byte_end":1639,"byte_start":1616,"def_id":"vzhpn66r","hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":"v289fr59.Sandwich.no_hotdog_is_a_sandwich","text":"no_hotdog_is_a_sandwich","token_id":"v289fr59.Sandwich.no_hotdog_is_a_sandwich::src::1","token_role":null},{"binder_role":null,"byte_end":1645,"byte_start":1644,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"(","token_id":"v289fr59.Sandwich.no_hotdog_is_a_sandwich::src::2","token_role":null},{"binder_role":"def_site","byte_end":1660,"byte_start":1645,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"logic_is_actual","token_id":"v289fr59.Sandwich.no_hotdog_is_a_sandwich::src::3","token_role":null},{"binder_role":null,"byte_end":1662,"byte_start":1661,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"v289fr59.Sandwich.no_hotdog_is_a_sandwich::src::4","token_role":null},{"binder_role":"use_site","byte_end":1676,"byte_start":1663,"def_