atible_psych_states : A (∀ p t, ¬ (p can-bring-about (p calm-at t ∧ p hypervigilant-at t))))\n    (some_young_parent : A (∃ p t, YoungParent.At p t))\n    (parents_must_be_calm_and_hyperviligant : A CalmHypervigilanceParentingStandard)\n  : False :=\n  logic_is_actual.consistency\n    (logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.mp _ _\n          (logic_is_actual.actual_intro _\n            (fun incompat some_yp std =>\n              calm_hypervigilance_standard_refuted ought_implies_can incompat some_yp std))\n          incompatible_psych_states)\n        some_young_parent)\n      parents_must_be_calm_and_hyperviligant)\n\nend Parenting\n\nend qg6hprvj\n","source_tokens":[{"binder_role":null,"byte_end":1467,"byte_start":1460,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"keyword","qualified_name":null,"text":"theorem","token_id":"qg6hprvj.Parenting.calm_hypervigilance_standard_asserted_is_false::src::0","token_role":null},{"binder_role":"def_site","byte_end":1514,"byte_start":1468,"def_id":"b0zkppw9","hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":"qg6hprvj.Parenting.calm_hypervigilance_standard_asserted_is_false","text":"calm_hypervigilance_standard_asserted_is_false","token_id":"qg6hprvj.Parenting.calm_hypervigilance_standard_asserted_is_false::src::1","token_role":null},{"binder_role":null,"byte_end":1520,"byte_start":1519,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"(","token_id":"qg6hprvj.Parenting.calm_hypervigilance_standard_asserted_is_false::src::2","token_role":null},{"binder_role":"def_site","byte_end":1535,"byte_start":1520,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"logic_is_actual","token_id":"qg6hprvj.Parenting.calm_hypervigilance_standard_asserted_is_false::src::3","token_role":null},{"binder_role":null,"byte_end":1537,"byte_start":15