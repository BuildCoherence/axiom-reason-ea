{"holders":{"con":[],"pro":[],"proposition_id":"pvc20kjh"},"proposition":{"acknowledgements":{"acknowledged_undecided":0},"adoptable":true,"defined_by":null,"endcap_eligible":true,"equivalences":[],"holder_rows":[],"holders":0,"negation_proposition_id":"xsstg3gk","p":{"author":{"child":{"children":[{"node":"text","text":"A "},{"child":{"node":"text","text":"HumanOrganismsExistFromFertilizationToDeath"},"node":"tag","tag":{"binder_role":"use_site","def_id":"xba155tz","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"wz5zekgq.HumanLifeMoralWorth.HumanOrganismsExistFromFertilizationToDeath","subexpr_pos":"/1","text":"HumanOrganismsExistFromFertilizationToDeath","token_id":"wz5zekgq.HumanLifeMoralWorth.human_organism_protected_from_fertilization_to_death::author/premise::1","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/","text":"A HumanOrganismsExistFromFertilizationToDeath","token_id":"wz5zekgq.HumanLifeMoralWorth.human_organism_protected_from_fertilization_to_death::author/premise::0","token_role":null}},"empty":{"child":{"children":[{"node":"text","text":"Axiom.Actual "},{"child":{"node":"text","text":"wz5zekgq.HumanLifeMoralWorth.HumanOrganismsExistFromFertilizationToDeath"},"node":"tag","tag":{"binder_role":"use_site","def_id":"xba155tz","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"wz5zekgq.HumanLifeMoralWorth.HumanOrganismsExistFromFertilizationToDeath","subexpr_pos":"/1","text":"wz5zekgq.HumanLifeMoralWorth.HumanOrganismsExistFromFertilizationToDeath","token_id":"wz5zekgq.HumanLifeMoralWorth.human_organism_protected_from_fertilization_to_death::empty/premise::1","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/","text":"Axiom.Actual wz5zekgq.HumanLifeMoralWorth.HumanOrganismsExistFromFertilizationToDeath","token_id":"wz5zekgq.HumanLifeMoralWorth.human_organism_protected_from_fertilization_to_death::empty/premise::0","token_role":null}}},"p_author_source":{"author_byte_range":{"end":2496,"start":2451},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.j12bzjgj\n\nopen t0d1zdc3\nopen gwcwyrvb\nopen j12bzjgj\nopen c424c6bg\nopen BFO\n\nnamespace wz5zekgq\n\nnamespace HumanLifeMoralWorth\n\nrigid universal HumanOrganism extends Object := \"living human organism\"\nrigid universal Fertilization extends Process := \"fertilization\"\nrigid universal Death extends Process := \"death\"\n\nrelation HasInherentMoralWorth : HumanOrganism :=\n  \"has inherent moral worth regardless of developmental stage, size, ability, health, or dependence\"\nrelation HasSeriousMoralClaimNotToBeIntentionallyKilledAt : HumanOrganism → TemporalRegion :=\n  \"has a serious moral claim not to be intentionally killed at\"\n\ndef CompletesAt (p : Process) (i : TemporalInstant) : Prop :=\n  ∃ tr : TemporalRegion, ProcessOccupiesTemporalRegion p tr ∧ HasLastInstant tr i\n\ndef IsBetweenInclusive (t start finish : TemporalInstant) : Prop :=\n  ¬ Precedes t start ∧ ¬ Precedes finish t\n\ndef ExistsFromFertilizationToDeath (h : HumanOrganism) (f : Fertilization) (d : Death) : Prop :=\n  ∃ conception termination : TemporalInstant,\n    CompletesAt f conception ∧ CompletesAt d termination ∧\n      ∀ t : TemporalInstant, ExistsAt h t ↔ IsBetweenInclusive t conception termination\n\ndef HumanOrganismsExistFromFertilizationToDeath : Prop :=\n  ∀ h : HumanOrganism, ∃ f : Fertilization, ∃ d : Death,\n    ExistsFromFertilizationToDeath h f d\n\ndef EveryHumanOrganismHasInherentMoralWorth : Prop :=\n  ∀ h : HumanOrganism, HasInherentMoralWorth h\n\ndef InherentMoralWorthGivesClaimWheneverItExists : Prop :=\n  ∀ h : HumanOrganism, ∀ t : Time,\n    HasInherentMoralWorth h → ExistsAt h t →\n      HasSeriousMoralClaimNotToBeIntentionallyKilledAt h t\n\ndef EveryHumanOrganismIsProtectedWheneverItExists : Prop :=\n  ∀ h : HumanOrganism, ∀ t : Time,\n    ExistsAt h t → HasSeriousMoralClaimNotToBeIntentionallyKilledAt h t\n\ndef EveryHumanOrganismIsProtectedFromFertilizationToDeath : Prop :=\n  ∀ h : HumanOrganism, ∃ f : Fertilization, ∃ d : Death,\n    ∃ conception termination : TemporalInstant,\n      CompletesAt f conception ∧ CompletesAt d termination ∧\n        ∀ t : TemporalInstant, IsBetweenInclusive t conception termination →\n          HasSeriousMoralClaimNotToBeIntentionallyKilledAt h t\n\ntheorem human_organism_protected_from_fertilization_to_death\n    (logic_is_actual : LogicIsActual)\n    (human_organisms_exist_from_fertilization_to_death :\n      A HumanOrganismsExistFromFertilizationToDeath)\n    (every_human_organism_has_inherent_moral_worth :\n      A EveryHumanOrganismHasInherentMoralWorth)\n    (inherent_moral_worth_gives_claim_whenever_it_exists :\n      A InherentMoralWorthGivesClaimWheneverItExists) :\n    A EveryHumanOrganismIsProtectedFromFertilizationToDeath := by\n  exact\n    logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.mp _ _\n          (logic_is_actual.actual_intro _\n            (by\n              intro exist hasWorth worthGivesClaim h\n              obtain ⟨f, d, conception, termination, hFert, hDeath, hExistsIff⟩ := exist h\n              refine ⟨f, d, conception, termination, hFert, hDeath, ?_⟩\n              intro t hBetween\n              exact worthGivesClaim h t (hasWorth h) ((hExistsIff t).mpr hBetween)))\n          human_organisms_exist_from_fertilization_to_death)\n        every_human_organism_has_inherent_moral_worth)\n      inherent_moral_worth_gives_claim_whenever_it_exists\n\nend HumanLifeMoralWorth\n\nend wz5zekgq\n","source_tokens":[{"binder_role":null,"byte_end":2296,"byte_start":2289,"def_id":null,"hover_kind":null,"inlined_type_summary":null,