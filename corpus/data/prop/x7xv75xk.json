{"holders":{"con":[],"pro":[{"axiom_name":"compatibilism_preserves_responsi_x7xv75xk","inconsistent":false,"provenance":"axiom","snapshot_def_id":"b1ccchet","username":"sam"}],"proposition_id":"x7xv75xk"},"proposition":{"acknowledgements":{"acknowledged_undecided":0},"adoptable":true,"defined_by":{"axiom_name":"compatibilism_preserves_responsi_x7xv75xk","file_id":"t9e0stky","publisher":"sam","wrapper_def_id":"brc184vk"},"endcap_eligible":true,"equivalences":[],"holder_rows":[{"axiom_name":"compatibilism_preserves_responsi_x7xv75xk","inconsistent":false,"provenance":"axiom","snapshot_def_id":"b1ccchet","username":"sam"}],"holders":1,"negation_proposition_id":"ywmvgcd8","p":{"author":{"child":{"children":[{"node":"text","text":"A "},{"child":{"node":"text","text":"SelfSourcingSuffices"},"node":"tag","tag":{"binder_role":"use_site","def_id":"xqtnb2sj","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"stb24v62.SelfSourcingSuffices","subexpr_pos":"/1","text":"SelfSourcingSuffices","token_id":"stb24v62.compatibilism_preserves_responsibility::author/premise::1","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/","text":"A SelfSourcingSuffices","token_id":"stb24v62.compatibilism_preserves_responsibility::author/premise::0","token_role":null}},"empty":{"child":{"children":[{"node":"text","text":"Axiom.Actual "},{"child":{"node":"text","text":"stb24v62.SelfSourcingSuffices"},"node":"tag","tag":{"binder_role":"use_site","def_id":"xqtnb2sj","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"stb24v62.SelfSourcingSuffices","subexpr_pos":"/1","text":"stb24v62.SelfSourcingSuffices","token_id":"stb24v62.compatibilism_preserves_responsibility::empty/premise::1","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/","text":"Axiom.Actual stb24v62.SelfSourcingSuffices","token_id":"stb24v62.compatibilism_preserves_responsibility::empty/premise::0","token_role":null}}},"p_author_source":{"author_byte_range":{"end":2419,"start":2397},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.a4hsz51v\nimport A.ta3nj1a4\nimport A.r59jf3ak\n\nopen a4hsz51v\nopen ta3nj1a4\nopen r59jf3ak\nopen t0d1zdc3\n\nnamespace stb24v62\n\nrigid universal Person extends Object := \"person\"\nrigid universal Action extends Process := \"action\"\n\ndef Determinism : Prop :=\n  \"every event is fully fixed by prior states of the world together with the laws of nature\"\n\nrelation CouldHaveDoneOtherwise : Person \"could have done otherwise than performing\" Action\nrelation SelfSources : Person \"performs from their own uncoerced reasons-responsive deliberation\" Action\nrelation MorallyResponsibleFor : Person \"is morally responsible for\" Action\n\nscoped notation:50 a \" could-have-done-otherwise-than \" x => CouldHaveDoneOtherwise a x\nscoped notation:50 a \" self-sources \" x => SelfSources a x\nscoped notation:50 a \" morally-responsible-for \" x => MorallyResponsibleFor a x\n\n-- Shared metaphysics: both camps accept these.\ndef DeterminismExcludesAlternatives : Prop :=\n  Determinism → ∀ a x : Type, ¬ (a could-have-done-otherwise-than x)\n\ndef SomeoneSelfSourcesAnAction : Prop :=\n  ∃ a x : Type, a self-sources x\n\n-- The hard determinist's moral axiom (the Principle of Alternative Possibilities).\ndef AlternativePossibilitiesRequired : Prop :=\n  ∀ a x : Type, (a morally-responsible-for x) → (a could-have-done-otherwise-than x)\n\n-- The compatibilist's moral axiom.\ndef SelfSourcingSuffices : Prop :=\n  ∀ a x : Type, (a self-sources x) → (a morally-responsible-for x)\n\ndef NoOneIsMorallyResponsible : Prop :=\n  ∀ a x : Type, ¬ (a morally-responsible-for x)\n\ndef SomeoneIsMorallyResponsible : Prop :=\n  ∃ a x : Type, a morally-responsible-for x\n\ntheorem hard_determinism_denies_responsibility\n    (logic_is_actual : LogicIsActual)\n    (pap : A AlternativePossibilitiesRequired)\n    (excl : A DeterminismExcludesAlternatives)\n    (det : A Determinism) :\n    A NoOneIsMorallyResponsible :=\n  logic_is_actual.mp _ _\n    (logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _\n          (fun (pap : AlternativePossibilitiesRequired)\n               (excl : DeterminismExcludesAlternatives)\n               (det : Determinism) a x hr =>\n            excl det a x (pap a x hr)))\n        pap)\n      excl)\n    det\n\ntheorem compatibilism_preserves_responsibility\n    (logic_is_actual : LogicIsActual)\n    (det : A Determinism)\n    (suff : A SelfSourcingSuffices)\n    (someone : A SomeoneSelfSourcesAnAction) :\n    A SomeoneIsMorallyResponsible :=\n  logic_is_actual.mp _ _\n    (logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _\n          (fun (_ : Determinism)\n               (suff : SelfSourcingSuffices)\n               (someone : SomeoneSelfSourcesAnAction) =>\n            someone.elim fun a hx => hx.elim fun x h => ⟨a, x, suff a x h⟩))\n        det)\n      suff)\n    someone\n\ntheorem the_disagreement_is_moral\n    (logic_is_actual : LogicIsActual)\n    (pap : A AlternativePossibilitiesRequired)\n    (suff : A SelfSourcingSuffices)\n    (excl : A DeterminismExcludesAlternatives)\n    (det : A Determinism)\n    (someone : A SomeoneSelfSourcesAnAction) :\n    False :=\n  logic_is_actual.consistency\n    (logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.mp _ _\n          (logic_is_actual.mp _ _\n            (logic_is_actual.mp _ _\n              (logic_is_actual.actual_intro _\n                (fun (pap : AlternativePossibilitiesRequired)\n                     (suff : SelfSourcingSuffices)\n                     (excl : DeterminismExcludesAlternatives)\n                     (det : Determinism)\n                     (someone : SomeoneSelfSourcesAnAction) =>\n                  someone.elim fun a hx => hx.elim fun x h =>\n                    excl det a x (pap a x (suff a x h))))\n              pap)\n            suff)\n          excl)\n        det)\n      someone)\n\nend stb24v62\n","source_tokens":[{"binder_role":null,"byte_end":2281,"byte_start":2274,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"keyword","qualified_name":null,"text":"theorem","token_id":"stb24v62.compatibilism_preserves_responsibility::src::0","token_role":null},{"binder_role":"def_site","byte_end":2320,"byte_start":2282,"def_id":"ksn02rmw","hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":"stb24v62.compatibilism_preserves_responsibility","text":"compatibilism_preserves_responsibility","token_id":"stb24v62.compatibilism_preserves_responsibility::src::1","token_role":null},{"binder_role":null,"byte_end":2326,"byte_start":2325,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"(","token_id":"stb24v62.compatibilism_preserves_responsibility::src::2","token_role":null},{"binder_role":"def_site","byte_end":2341,"byte_start":2326,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"logic_is_actual","token_id":"stb24v62.compatibilism_preserves_responsibility::src::3","token_role":null},{"binder_role":null,"byte_end":2343,"byte_start":2342,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"stb24v62.compatibilism_preserves_responsibility::src::4","token_role":null},{"binder_role":"use_site","byte_end":2357,"byte_start":2344,"def_id":"t45qx6q7","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"t0d1zdc3.LogicIsActual","text":"LogicIsActual","token_id":"stb24v62.compatibilism_preserve