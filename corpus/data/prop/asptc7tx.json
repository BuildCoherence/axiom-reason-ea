{"holders":{"con":[],"pro":[],"proposition_id":"asptc7tx"},"proposition":{"acknowledgements":{"acknowledged_undecided":0},"adoptable":true,"defined_by":null,"endcap_eligible":true,"equivalences":[],"holder_rows":[],"holders":0,"negation_proposition_id":"w5bpgrj7","p":{"author":{"child":{"node":"text","text":"FoolUnderstandsTheWords"},"node":"tag","tag":{"binder_role":"use_site","def_id":"x2tmebar","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"m63bd0fm.FoolUnderstandsTheWords","subexpr_pos":"/","text":"FoolUnderstandsTheWords","token_id":"m63bd0fm.exists_in_the_understanding::author/premise::0","token_role":null}},"empty":{"child":{"node":"text","text":"m63bd0fm.FoolUnderstandsTheWords"},"node":"tag","tag":{"binder_role":"use_site","def_id":"x2tmebar","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"m63bd0fm.FoolUnderstandsTheWords","subexpr_pos":"/","text":"m63bd0fm.FoolUnderstandsTheWords","token_id":"m63bd0fm.exists_in_the_understanding::empty/premise::0","token_role":null}}},"p_author_source":{"author_byte_range":{"end":1942,"start":1919},"file_content":"import Axiom\nimport A.gwcwyrvb\n\nopen gwcwyrvb\n\nnamespace m63bd0fm\n\n-- Anselm's ontological argument (Proslogion II), as reconstructed in\n-- https://plato.stanford.edu/entries/ontological-arguments/ (section 6)\n\ndef FoolUnderstandsTheWords : Prop :=\n  A (\"when the fool hears the words 'that than which no greater can be conceived' he understands those words\" : Prop)\ndef WhateverIsUnderstoodExistsInTheUnderstanding : Prop :=\n  A (\"whatever is understood exists in the understanding\" : Prop)\ndef ExistsInTheUnderstanding : Prop :=\n  A (\"that than which no greater can be conceived exists in the understanding\" : Prop)\ndef CanBeConceivedToExistInReality : Prop :=\n  A (\"if that than which no greater can be conceived exists in the understanding, it can be conceived to exist in reality\" : Prop)\ndef GreaterIfInReality : Prop :=\n  A (\"that than which no greater can be conceived is greater if it exists in reality than if it exists only in the understanding\" : Prop)\ndef NothingGreaterConceivable : Prop :=\n  A (\"it is impossible to conceive of something greater than that than which no greater can be conceived\" : Prop)\ndef ExistsInReality : Prop :=\n  A (\"that than which no greater can be conceived exists in reality\" : Prop)\ndef GodIsThatThanWhichNoGreaterCanBeConceived : Prop :=\n  A (\"God is that than which no greater can be conceived\" : Prop)\ndef GodExistsInReality : Prop :=\n  A (\"God exists in reality\" : Prop)\n\ndef ExistsInUnderstandingBridge : Prop :=\n  FoolUnderstandsTheWords ∧ WhateverIsUnderstoodExistsInTheUnderstanding →\n    ExistsInTheUnderstanding\n\ndef ExistsInRealityBridge : Prop :=\n  ExistsInTheUnderstanding ∧ CanBeConceivedToExistInReality ∧\n    GreaterIfInReality ∧ NothingGreaterConceivable →\n      ExistsInReality\n\ndef GodExistsBridge : Prop :=\n  GodIsThatThanWhichNoGreaterCanBeConceived ∧ ExistsInReality →\n    GodExistsInReality\n\ntheorem exists_in_the_understanding\n    (i : FoolUnderstandsTheWords)\n    (ii : WhateverIsUnderstoodExistsInTheUnderstanding)\n    (iii_bridge : ExistsInUnderstandingBridge)\n  : ExistsInTheUnderstanding :=\n  iii_bridge ⟨i, ii⟩\n\ntheorem exists_in_reality\n    (i : FoolUnderstandsTheWords)\n    (ii : WhateverIsUnderstoodExistsInTheUnderstanding)\n    (iii_bridge : ExistsInUnderstandingBridge)\n    (iv : CanBeConceivedToExistInReality)\n    (v : GreaterIfInReality)\n    (vi : NothingGreaterConceivable)\n    (vii_bridge : ExistsInRealityBridge)\n  : ExistsInReality :=\n  vii_bridge ⟨exists_in_the_understanding i ii iii_bridge, iv, v, vi⟩\n\n-- Anselm's identification: \"and this you are, O Lord our God\" (Proslogion II)\ntheorem god_exists_in_reality\n    (i : FoolUnderstandsTheWords)\n    (ii : WhateverIsUnderstoodExistsInTheUnderstanding)\n    (iii_bridge : ExistsInUnderstandingBridge)\n    (iv : CanBeConceivedToExistInReality)\n    (v : GreaterIfInReality)\n    (vi : NothingGreaterConceivable)\n    (vii_bridge : ExistsInRealityBridge)\n    (viii : GodIsThatThanWhichNoGreaterCanBeConceived)\n    (god_bridge : GodExistsBridge)\n  : GodExistsInReality :=\n  god_bridge ⟨viii, exists_in_reality i ii iii_bridge iv v vi vii_bridge⟩\n\nend m63bd0fm\n","source_tokens":[{"binder_role":null,"byte_end":1881,"byte_start":1874,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"keyword","qualified_name":null,"text":"theorem","token_id":"m63bd0fm.exists_in_the_understanding::src::0","token_role":null},{"binder_role":"def_site","byte_end":1909,"byte_start":1882,"def_id":"c0v7z6g9","hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":"m63bd0fm.exists_in_the_understanding","text":"exists_in_the_understanding","token_id":"m63bd0fm.exists_in_the_understanding::src::1","token_role":null},{"binder_role":null,"byte_end":1915,"byte_start":1914,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"(","token_id":"m63bd0fm.exists_in_the_understanding::src::2","token_role":null},{"binder_role":"def_site","byte_end":1916,"byte_start":1915,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"i","token_id":"m63bd0fm.exists_in_the_understanding::src::3","token_role":null},{"binder_role":null,"byte_end":1918,"byte_start":1917,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"m63bd0fm.exists_in_the_understanding::src::4","token_role":null},{"binder_role":"use_site","byte_end":1942,"byte_start":1919,"def_id":"x2tmebar","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"m63bd0fm.FoolUnderstandsTheWords","text":"FoolUnderstandsTheWords","token_id":"m63bd0fm.exists_in_the_understanding::src::5","token_role":null},{"binder_role":null,"byte_end":1943,"byte_start":1942,"def