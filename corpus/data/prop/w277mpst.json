 have a duty to perfect our moral character\"\ndef MistreatingAnimalsCorruptsMoralCharacter : Prop :=\n  \"when we mistreat animals, we corrupt our moral character\"\ndef CommercialExploitationIsMistreatment : Prop :=\n  \"exploiting animals for commercial gain is mistreating them\"\ndef EatingMeatCommerciallyExploitsAnimals : Prop :=\n  \"eating meat exploits animals for commercial gain\"\ndef MustNotMistreatAnimals : Prop :=\n  \"we mustn't mistreat animals\"\ndef MustNotEatMeat : Prop :=\n  \"we mustn't eat meat\"\n\ndef NoMistreatBridge : Prop :=\n  DutyToPerfectMoralCharacter ∧ MistreatingAnimalsCorruptsMoralCharacter →\n    MustNotMistreatAnimals\n\ndef NoEatMeatBridge : Prop :=\n  MustNotMistreatAnimals ∧ CommercialExploitationIsMistreatment ∧\n    EatingMeatCommerciallyExploitsAnimals →\n      MustNotEatMeat\n\ntheorem actual_and (h : LogicIsActual) {p q : Prop} (hp : A p) (hq : A q) :\n    A (p ∧ q) :=\n  h.mp _ _ (h.mp _ _ (h.actual_intro _ (@And.intro p q)) hp) hq\n\ntheorem no_mistreat\n    (logic_is_actual : LogicIsActual)\n    (duty_to_perfect : A DutyToPerfectMoralCharacter)\n    (mistreating_corrupts : A MistreatingAnimalsCorruptsMoralCharacter)\n    (no_mistreat_bridge : A NoMistreatBridge)\n  : A MustNotMistreatAnimals :=\n  logic_is_actual.mp _ _ no_mistreat_bridge\n    (actual_and logic_is_actual duty_to_perfect mistreating_corrupts)\n\ntheorem no_eat_meat\n    (logic_is_actual : LogicIsActual)\n    (duty_to_perfect : A DutyToPerfectMoralCharacter)\n    (mistreating_corrupts : A MistreatingAnimalsCorruptsMoralCharacter)\n    (no_mistreat_bridge : A NoMistreatBridge)\n    (exploitation_is_mistreatment : A CommercialExploitationIsMistreatment)\n    (eating_meat_exploits : A EatingMeatCommerciallyExploitsAnimals)\n    (no_eat_meat_bridge : A NoEatMeatBridge)\n  : A MustNotEatMeat :=\n  logic_is_actual.mp _ _ no_eat_meat_bridge\n    (actual_and logic_is_actual\n      (no_mistreat logic_is_actual duty_to_perfect mistreating_corrupts\n        no_mistreat_bridge)\n      (actual_and logic_is_actual exploitation_is_mistreatment\n        eating_meat_exploits))\n\nend kqjyfmgp\n","source_tokens":[{"binder_role":null,"byte_end":1555,"byte_start":1548,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"keyword","qualified_name":null,"text":"theorem","token_id":"kqjyfmgp.no_eat_meat::src::0","token_role":null},{"binder_role":"def_site","byte_end":1567,"byte_start":1556,"def_id":"af4mw8tz","hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":"kqjyfmgp.no_eat_meat","text":"no_eat_meat","token_id":"kqjyfmgp.no_eat_meat::src::1","token_role":null},{"binder_role":null,"byte_end":1573,"byte_start":1572,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"(","token_id":"kqjyfmgp.no_eat_meat::src::2","token_role":null},{"binder_role":"def_site","byte_end":1588,"byte_start":1573,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"logic_is_actual","token_id":"kqjyfmgp.no_eat_meat::src::3","token_role":null},{"binder_role":null,"byte_end":1590,"byte_start":1589,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"kqjyfmgp.no_eat_meat::src::4","token_role":null},{"binder_role":"use_site","byte_end":1604,"byte_start":1591,"def_id":"t45qx6q7","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"t0d1zdc3.LogicIsActual","text":"LogicIsActual","token_id":"kqjyfmgp.no_eat_meat::src::5","token_role":null},{"binder_role":null,"byte_end":1605,"byte_start":1604,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":")","token_id":"kqjyfmgp.no_eat_meat::src::6","token_role":null},{"binder_role":null,"byte_end":1611,"byte_start":1610,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"(","token_id":"kqjyf