{"holders":{"con":[],"pro":[],"proposition_id":"vz5mrqmq"},"proposition":{"acknowledgements":{"acknowledged_undecided":0},"adoptable":true,"defined_by":null,"endcap_eligible":true,"equivalences":[],"holder_rows":[],"holders":0,"negation_proposition_id":"rjn34e39","p":{"author":{"child":{"node":"text","text":"MammalsCanExperience"},"node":"tag","tag":{"binder_role":"use_site","def_id":"aqmme89n","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"wbgpfv88.MammalsCanExperience","subexpr_pos":"/","text":"MammalsCanExperience","token_id":"wbgpfv88.mammals_can_experience::author/conclusion::0","token_role":null}},"empty":{"child":{"node":"text","text":"wbgpfv88.MammalsCanExperience"},"node":"tag","tag":{"binder_role":"use_site","def_id":"aqmme89n","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"wbgpfv88.MammalsCanExperience","subexpr_pos":"/","text":"wbgpfv88.MammalsCanExperience","token_id":"wbgpfv88.mammals_can_experience::empty/conclusion::0","token_role":null}}},"p_author_source":{"author_byte_range":{"end":1509,"start":1489},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.j12bzjgj\n\nopen t0d1zdc3\nopen gwcwyrvb\nopen j12bzjgj\nopen c424c6bg\n\nnamespace wbgpfv88\n\nuniverse u\n\nopen BFO\n\nrelation Permissible : Prop := \"permissible\"\ndef Unnecessary : Sort u → Prop := \"unnecessary\"\nrelation Produces : Prop → Type := \"produces\"\n\nrelation CausesHarm : Prop := \"causes harm\"\nrelation CanExperience : Type := \"can experience\"\nrelation HasCNS : Type := \"has CNS\"\nrigid universal Mammal extends Object := \"mammal\"\nrelation CausesEnslavementOf : Prop → Type := \"causes enslavement of\"\n\ndef EnslavementHarms := ∀ p : Prop, ∀ e : Type,\n  CanExperience e → CausesEnslavementOf p e → CausesHarm p\n\ndef UnnecessaryHarmImpermissible := ∀ p : Prop,\n  CausesHarm p → Unnecessary p → ¬ Permissible p\n\ndef UnnecessaryProduction := ∀ p : Prop, (∀ product : Type,\n  Produces p product → Unnecessary product) → Unnecessary p\n\ndef AnimalAg21Cent : Prop := \"doing animal agriculture in the 21st century\"\n\ndef UnnecessaryAg := A (∀ product : Type,\n  (Produces AnimalAg21Cent product → Unnecessary product))\n\ndef AgEnslavesMammals := A (∃ e : Type, Mammal.Is e ∧ CausesEnslavementOf AnimalAg21Cent e)\n\ndef CNSCanExperience := ∀ e : Type, HasCNS e → CanExperience e\n\ndef MammalsHaveCNS := ∀ e : Type, Mammal.Is e → HasCNS e\n\ndef MammalsCanExperience := ∀ e : Type, Mammal.Is e → CanExperience e\n\ntheorem mammals_can_experience\n    (h₁ : CNSCanExperience) (h₂ : MammalsHaveCNS)\n  : MammalsCanExperience := by\n intro e\n intro is_mammal\n exact h₁ e (h₂ e is_mammal)\n\ntheorem animal_ag_impermissible\n    (logic_is_actual : LogicIsActual) (ag_unness : UnnecessaryAg) (ag_enslaves : AgEnslavesMammals)\n    (cns_can_ex : CNSCanExperience) (mammal_cns : MammalsHaveCNS)\n    (unness_harm_imperm : UnnecessaryHarmImpermissible) (unness_prod : UnnecessaryProduction)\n    (slavery_harms : EnslavementHarms)\n  : ¬ A (Permissible AnimalAg21Cent) := by\n  have mammal_ex := mammals_can_experience cns_can_ex mammal_cns\n  -- Harm: ag enslaves a mammal, mammals can experience, and enslaving an\n  -- experiencer harms. Lift that whole inference and fire it at the actual\n  -- enslavement fact (the witness stays inside the box — no Barcan needed).\n  have harm_rule :\n      (∃ e : Type, Mammal.Is e ∧ CausesEnslavementOf AnimalAg21Cent e) → CausesHarm AnimalAg21Cent :=\n    fun ⟨e, hmam, hens⟩ => slavery_harms AnimalAg21Cent e (mammal_ex e hmam) hens\n  have ag_harms : A (CausesHarm AnimalAg21Cent) :=\n    logic_is_actual.mp _ _ (logic_is_actual.actual_intro _ harm_rule) ag_enslaves\n  -- Unnecessary: everything ag produces is unnecessary, so ag is unnecessary.\n  have ag_unnecessary : A (Unnecessary AnimalAg21Cent) :=\n    logic_is_actual.mp _ _\n      (logic_is_actual.actual_intro _ (unness_prod AnimalAg21Cent)) ag_unness\n  -- Unnecessary harm is impermissible.\n  have ag_not_perm : A (¬ Permissible AnimalAg21Cent) :=\n    logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _ (unness_harm_imperm AnimalAg21Cent)) ag_harms)\n      ag_unnecessary\n  -- Were it actually permissible, that would make False actual — impossible.\n  intro ag_perm\n  exact logic_is_actual.consistency (logic_is_actual.mp _ _ ag_not_perm ag_perm)\n\nend wbgpfv88\n","source_tokens":[{"binder_role":null,"byte_end":1407,"byte_start":1400,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"keyword","qualified_name":null,"text":"theorem","token_id":"wbgpfv88.mammals_can_experience::src::0","token_role":null},{"binder_role":"def_site","byte_end":1430,"byte_start":1408,"def_id":"jcckjcc9","hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":"wbgpfv88.mammals_can_experience","text":"mammals_can_experience","token_id":"wbgpfv88.mammals_can_experience::src::1","token_role":null},{"binder_role":null,"byte_end":1436,"byte_start":1435,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"(","token_id":"wbgpfv88.mammals_can_experience::src::2","token_role":null},{"binder_role":"def_site","byte_end":1440,"byte_start":1436,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"h₁","token_id":"wbgpfv88.mammals_can_experience::src::3","token_role":null},{"binder_role":null,"byte_end":1442,"byte_start":1441,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"wbgpfv88.mammals_can_experience::src::4","token_role":null},{"binder_role":"use_site","byte_end":1459,"byte_start":1443,"def_id":"q08zwxks","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"wbgpfv88.CNSCanExperience","text":"CNSCanExperience","token_id":"wbgpfv88.mammals_can_experience::src::5","token_role":null},{