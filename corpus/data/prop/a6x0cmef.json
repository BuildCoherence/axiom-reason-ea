{"holders":{"con":[],"pro":[],"proposition_id":"a6x0cmef"},"proposition":{"acknowledgements":{"acknowledged_undecided":0},"adoptable":true,"defined_by":null,"endcap_eligible":true,"equivalences":[],"holder_rows":[],"holders":0,"negation_proposition_id":"j0ea6hdk","p":{"author":{"child":{"node":"text","text":"DollyPartonIsRichAndNotImmoral"},"node":"tag","tag":{"binder_role":"use_site","def_id":"aa198b3r","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"qfqvcx4c.DollyPartonIsRichAndNotImmoral","subexpr_pos":"/","text":"DollyPartonIsRichAndNotImmoral","token_id":"qfqvcx4c.named_counterexample_refutes::author/premise::0","token_role":null}},"empty":{"child":{"node":"text","text":"qfqvcx4c.DollyPartonIsRichAndNotImmoral"},"node":"tag","tag":{"binder_role":"use_site","def_id":"aa198b3r","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"qfqvcx4c.DollyPartonIsRichAndNotImmoral","subexpr_pos":"/","text":"qfqvcx4c.DollyPartonIsRichAndNotImmoral","token_id":"qfqvcx4c.named_counterexample_refutes::empty/premise::0","token_role":null}}},"p_author_source":{"author_byte_range":{"end":1619,"start":1589},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.d4qbfhxh\nimport A.xhnxzf59\nimport A.nwtxrh89\nimport A.n82pf9zy\n\nopen nwtxrh89\nopen n82pf9zy\n\nopen d4qbfhxh\nopen xhnxzf59\nopen t0d1zdc3\n\nnamespace qfqvcx4c\n\nrelation Rich : Person := \"is rich\"\n\nscoped postfix:max \" is-rich\" => Rich\n\ndef EveryRichPersonIsImmoral : Prop :=\n  ∀ p : Person, p is-rich → p is-immoral\n\ndef NotEveryRichPersonIsImmoral : Prop :=\n  ¬ EveryRichPersonIsImmoral\n\ndef SomeRichPersonIsNotImmoral : Prop :=\n  ∃ p : Person, p is-rich ∧ ¬ (p is-immoral)\n\ndef DollyParton : Type := \"Dolly Parton\"\n\ndef DollyPartonIsRichAndNotImmoral : Prop :=\n  DollyParton is-rich ∧ ¬ (DollyParton is-immoral)\n\ndef EveryPersonIsImmoral : Prop :=\n  ∀ p : Person, p is-immoral\n\ndef OnlyRichPeopleAreImmoral : Prop :=\n  ∀ p : Person, p is-immoral → p is-rich\n\nrelation SameCircumstancesExceptWealth : Person → Person :=\n  \"has the same morally relevant circumstances except wealth as\"\n\nscoped infix:50 \" same-circumstances-except-wealth \" => SameCircumstancesExceptWealth\n\nstructure TwoPeopleDifferingInWealth where\n  p1 : Person\n  p2 : Person\n  p1Character : MoralCharacter\n  p2Character : MoralCharacter\n  p1_is_rich : p1 is-rich\n  p2_is_not : ¬ (p2 is-rich)\n  p1_has_character : p1 has-moral-character p1Character\n  p2_has_character : p2 has-moral-character p2Character\n  all_else_equal : p1 same-circumstances-except-wealth p2\n\ndef AllElseEqualTheRichPersonIsLessMoral : Prop :=\n  ∀ s : TwoPeopleDifferingInWealth, s.p1Character less-moral-than s.p2Character\n\ntheorem named_counterexample_refutes\n    (h : DollyPartonIsRichAndNotImmoral) : SomeRichPersonIsNotImmoral :=\n  ⟨⟨DollyParton, Rich.inst0 h.1⟩, h.1, h.2⟩\n\ntheorem some_refutes_every\n    (h : SomeRichPersonIsNotImmoral) : NotEveryRichPersonIsImmoral :=\n  fun every => h.elim fun p hp => hp.2 (every p hp.1)\n\ntheorem not_every_means_some\n    (h : NotEveryRichPersonIsImmoral) : SomeRichPersonIsNotImmoral :=\n  Classical.byContradiction fun no_counterexample =>\n    h fun p rich =>\n      Classical.byContradiction fun not_immoral =>\n        no_counterexample ⟨p, rich, not_immoral⟩\n\ntheorem everyone_immoral_confirms_the_claim\n    (everyone : EveryPersonIsImmoral) : EveryRichPersonIsImmoral :=\n  fun p _ => everyone p\n\ntheorem everyone_immoral_rejects_only_rich\n    (everyone : EveryPersonIsImmoral)\n    (someone_not_rich : ∃ p : Person, ¬ (p is-rich)) :\n    ¬ OnlyRichPeopleAreImmoral :=\n  fun only_rich => someone_not_rich.elim fun p not_rich =>\n    not_rich (only_rich p (everyone p))\n\ntheorem disagreement_is_contradiction\n    (logic_is_actual : LogicIsActual)\n    (every : A EveryRichPersonIsImmoral)\n    (some_not : A SomeRichPersonIsNotImmoral) : False :=\n  logic_is_actual.consistency\n    (logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _ some_refutes_every)\n        some_not)\n      every)\n\ntheorem immoral_non_rich_twin_makes_rich_twin_immoral\n    (coherent : MoralComparisonIsCoherent)\n    (immoral_below : ImmoralBelowNonImmoral)\n    (rich_less_moral : AllElseEqualTheRichPersonIsLessMoral)\n    (s : TwoPeopleDifferingInWealth)\n    (immoral : s.p2 is-immoral) :\n    s.p1 is-immoral :=\n  Classical.byContradiction fun not_immoral =>\n    more_moral_asymmetric coherent s.p2Character s.p1Character\n      (rich_less_moral s)\n      (immoral_below s.p2 s.p1 s.p2Character s.p1Character\n        s.p2_has_character s.p1_has_character\n        immoral not_immoral)\n\nend qfqvcx4c\n","source_tokens":[{"binder_role":null,"byte_end":1550,"byte_start":1543,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"keyword","qualified_name":null,"text":"theorem","token_id":"qfqvcx4c.named_counterexample_refutes::src::0","token_role":null},{"binder_role":"def_site","byte_end":1579,"byte_start":1551,"def_id":"c3svk7cf","hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":"qfqvcx4c.named_counterexample_refutes","text":"named_counterexample_refutes","token_id":"qfqvcx4c.named_counterexample_refutes::src::1","token_role":null},{"binder_role":null,"byte_end":1585,"byte_start":1584,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"(","token_id":"qfqvcx4c.named_counterexample_refutes::src::2","token_role":null},{"binder_role":"def_site","byte_end":1586,"byte_start":1585,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"h","token_id":"qfqvcx4c.named_counterexample_refutes::src::3","token_role":null},{"binder_role":null,"byte_end":1588,"byte_start":1587,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"q