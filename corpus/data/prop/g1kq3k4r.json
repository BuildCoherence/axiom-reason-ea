1_by_modus_ponens p1 p2 no_mistreat_bridge, p3, p4⟩\n\nend mbsxqzvd\n","source_tokens":[{"binder_role":null,"byte_end":754,"byte_start":747,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"keyword","qualified_name":null,"text":"theorem","token_id":"mbsxqzvd.must_not_eat_meat::src::0","token_role":null},{"binder_role":"def_site","byte_end":772,"byte_start":755,"def_id":"smpgxsjc","hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":"mbsxqzvd.must_not_eat_meat","text":"must_not_eat_meat","token_id":"mbsxqzvd.must_not_eat_meat::src::1","token_role":null},{"binder_role":null,"byte_end":778,"byte_start":777,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"(","token_id":"mbsxqzvd.must_not_eat_meat::src::2","token_role":null},{"binder_role":"def_site","byte_end":780,"byte_start":778,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"p1","token_id":"mbsxqzvd.must_not_eat_meat::src::3","token_role":null},{"binder_role":null,"byte_end":782,"byte_start":781,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"mbsxqzvd.must_not_eat_meat::src::4","token_role":null},{"binder_role":"use_site","byte_end":785,"byte_start":783,"def_id":"ypmb2ezy","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"mbsxqzvd.P1","text":"P1","token_id":"mbsxqzvd.must_not_eat_meat::src::5","token_role":null},{"binder_role":null,"byte_end":786,"byte_start":785,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":")","token_id":"mbsxqzvd.must_not_eat_meat::src::6","token_role":null},{"binder_role":null,"byte_end":788,"byte_start":787,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"(","token_id":"mbsxqzvd.must_not_eat_meat::src::7","token_role":null},{"