ngleAndMarriedSoldiers : Prop :=\n  (∃ s : Soldier, (s is-single) ∧ (TheComplex houses s)) ∧\n  (∃ s : Soldier, (s is-married) ∧ (TheComplex houses s))\n\nend ComplexSentence\n\nend cpymj1kb\n"}
