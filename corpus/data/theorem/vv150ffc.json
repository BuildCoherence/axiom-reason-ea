ary) (backend : Backend)\n    (hIrreversible : irreversible boundary)\n    (hAuthorized : authorized boundary backend) :\n    backend = Backend.exact := by\n  rw [hAuthorized]\n  exact irreversible_boundary_requires_exact boundary hIrreversible\n\nend CommunicativeArithmeticGuard\n\nend j81b1gmr\n"}
