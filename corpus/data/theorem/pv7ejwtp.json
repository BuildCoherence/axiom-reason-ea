salAtUnder.mem parentAt) (c424c6bg.UniversalAtUnder.parent u)","token_id":"cnp2js9w.universalAtUnder_bridge::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"∀ (u : Type) (parentAt : Type → Type → Prop) (x t : Type),   jz5twd51.UniversalAtUnder u parentAt x t ↔ c424c6bg.UniversalAtUnder u parentAt x t","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun u parentAt x t =>\n  Iff.intro\n    (fun h =>\n      c424c6bg.UniversalAtUnder.mk (jz5twd51.UniversalAtUnder.mem parentAt) (jz5twd51.UniversalAtUnder.parent u))\n    fun h => jz5twd51.UniversalAtUnder.mk (c424c6bg.UniversalAtUnder.mem parentAt) (c424c6bg.UniversalAtUnder.parent u)","token_id":"cnp2js9w.universalAtUnder_bridge::empty/value::0","token_role":null}}}},"file_content":"import A.c424c6bg\nimport A.jz5twd51\n\nopen jz5twd51\n\nnamespace cnp2js9w\n\n/-- The V2 classifier classes coincide with `c424c6bg`'s: both are transparent\n    wrappers over bfo-raw's shared `InstanceOf`, so V1↔V2 universals and\n    relations are provably equivalent, not merely bridged by an axiom. -/\n\ntheorem universalAt_bridge (u x t : Type) :\n    UniversalAt u x t ↔ c424c6bg.UniversalAt u x t :=\n  ⟨fun h => ⟨h.mem⟩, fun h => ⟨h.mem⟩⟩\n\ntheorem universalAtUnder_bridge (u : Type) (parentAt : Type → Type → Prop) (x t : Type) :\n    UniversalAtUnder u parentAt x t ↔ c424c6bg.UniversalAtUnder u parentAt x t :=\n  ⟨fun h => ⟨h.mem, h.parent⟩, fun h => ⟨h.mem, h.parent⟩⟩\n\ntheorem rigidlyIs_bridge (atPred : Type → Type → Prop) (x : Type) :\n    RigidlyIs atPred x ↔ c424c6bg.RigidlyIs atPred x :=\n  ⟨fun h => ⟨h.mem⟩, fun h => ⟨h.mem⟩⟩\n\ntheorem rigidlyIsUnder_bridge (atPred : Type → Type → Prop) (parentIs : Type → Prop) (x : Type) :\n    RigidlyIsUnder atPred parentIs x ↔ c424c6bg.RigidlyIsUnder atPred parentIs x :=\n  ⟨fun h => ⟨h.mem, h.parent⟩, fun h => ⟨h.mem, h.parent⟩⟩\n\nend cnp2js9w\n"}
