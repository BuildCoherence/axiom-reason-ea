rent::empty/value::3","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"psdq1das","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.Is","subexpr_pos":"/1/0","text":"mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.Is x","token_id":"mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.Is.toParent::empty/value::2","token_role":null}},{"node":"text","text":"] =>\n  "},{"child":{"children":[{"node":"text","text":"c424c6bg.RigidlyIsUnder.parent "},{"child":{"node":"text","text":"mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.At"},"node":"tag","tag":{"binder_role":"use_site","def_id":"sgde4phb","hover_kind":"term","inlined_type_summary":"Type → Type → Prop","kind":"type","qualified_name":"mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.At","subexpr_pos":"/1/1/0/0/0/1","text":"mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.At","token_id":"mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.Is.toParent::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"j12bzjgj.BFO.Object.Is x","kind":"stdlib","qualified_name":"c424c6bg.RigidlyIsUnder.parent","subexpr_pos":"/1/1","text":"c424c6bg.RigidlyIsUnder.parent mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.At","token_id":"mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.Is.toParent::empty/value::4","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"∀ (x : Type) [mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.Is x], j12bzjgj.BFO.Object.Is x","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun x [mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.Is x] =>\n  c424c6bg.RigidlyIsUnder.parent mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.At","token_id":"mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.Is.toParent::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.j12bzjgj\n\nopen t0d1zdc3\nopen gwcwyrvb\nopen j12bzjgj\nopen c424c6bg\nopen BFO\n\nnamespace mnpz4yrv\n\nnamespace HumanLifeMoralWorth\n\nrigid universal HumanOrganism extends Object := \"living human organism\"\nrigid universal Fertilization extends Process := \"fertilization\"\n\nrelation BeginsToExistWhenFertilizationIsComplete :\n  HumanOrganism → Fertilization := \"begins to exist when fertilization is complete\"\nrelation HasInherentMoralWorth : HumanOrganism :=\n  \"has inherent moral worth regardless of developmental stage, size, ability, health, or dependence\"\nrelation HasSeriousMoralClaimNotToBeIntentionallyKilled : HumanOrganism :=\n  \"has a serious moral claim not to be intentionally killed\"\n\ndef FertilizationBeginsHumanOrganismExistence : Prop :=\n  ∀ h : HumanOrganism, ∃ f : Fertilization,\n    BeginsToExistWhenFertilizationIsComplete h f\n\ndef EveryHumanOrganismHasInherentMoralWorth : Prop :=\n  ∀ h : HumanOrganism, HasInherentMoralWorth h\n\ndef InherentMoralWorthGivesSeriousClaimNotToBeIntentionallyKilled : Prop :=\n  ∀ h : HumanOrganism,\n    HasInherentMoralWorth h →\n      HasSeriousMoralClaimNotToBeIntentionallyKilled h\n\ndef EveryHumanOrganismHasSeriousMoralClaimFromFertilization : Prop :=\n  ∀ h : HumanOrganism,\n    (∃ f : Fertilization, BeginsToExistWhenFertilizationIsComplete h f) ∧\n      HasSeriousMoralClaimNotToBeIntentionallyKilled h\n\ntheorem human_organism_has_serious_moral_claim_from_fertilization\n    (logic_is_actual : LogicIsActual)\n    (fertilization_begins_human_organism_existence :\n      A FertilizationBeginsHumanOrganismExistence)\n    (every_human_organism_has_inherent_moral_worth :\n      A EveryHumanOrganismHasInherentMoralWorth)\n    (inherent_moral_worth_gives_serious_claim_not_to_be_intentionally_killed :\n      A InherentMoralWorthGivesSeriousClaimNotToBeIntentionallyKilled) :\n    A EveryHumanOrganismHasSeriousMoralClaimFromFertilization := by\n  exact\n    logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.mp _ _\n          (logic_is_actual.actual_intro _\n            (by\n              intro begins hasWorth worthGivesClaim h\n              exact ⟨begins h, worthGivesClaim h (hasWorth h)⟩))\n          fertilization_begins_human_organism_existence)\n        every_human_organism_has_inherent_moral_worth)\n      inherent_moral_worth_gives_serious_claim_not_to_be_intentionally_killed\n\nend HumanLifeMoralWorth\n\nend mnpz4yrv\n"}
