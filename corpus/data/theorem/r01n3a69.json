mmunicativeArithmeticGuard.Backend.fp32.sizeOf_spec::empty/conclusion::1","token_role":null}},{"node":"text","text":" = "},{"child":{"node":"text","text":"1"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Nat","kind":"stdlib","qualified_name":"OfNat.ofNat","subexpr_pos":"/1","text":"1","token_id":"j81b1gmr.CommunicativeArithmeticGuard.Backend.fp32.sizeOf_spec::empty/conclusion::3","token_role":"num_lit"}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Eq","subexpr_pos":"/","text":"sizeOf j81b1gmr.CommunicativeArithmeticGuard.Backend.fp32 = 1","token_id":"j81b1gmr.CommunicativeArithmeticGuard.Backend.fp32.sizeOf_spec::empty/conclusion::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\n\nnamespace j81b1gmr\n\nnamespace CommunicativeArithmeticGuard\n\ninductive Boundary\n  | internal\n  | persisted\n  | externalAction\n  | humanReview\n\ndef irreversible : Boundary → Prop\n  | .internal => False\n  | .persisted => True\n  | .externalAction => True\n  | .humanReview => True\n\ninductive Backend\n  | fp32\n  | exact\n\ndef selectedBackend : Boundary → Backend\n  | .internal => .fp32\n  | .persisted => .exact\n  | .externalAction => .exact\n  | .humanReview => .exact\n\ndef authorized (boundary : Boundary) (backend : Backend) : Prop :=\n  backend = selectedBackend boundary\n\ntheorem irreversible_boundary_requires_exact\n    (boundary : Boundary) (h : irreversible boundary) :\n    selectedBackend boundary = Backend.exact := by\n  cases boundary <;> simp [irreversible, selectedBackend] at h ⊢\n\ntheorem authorized_irreversible_output_is_exact\n    (boundary : Boundary) (backend : Backend)\n    (hIrreversible : irreversible boundary)\n    (hAuthorized : authorized boundary backend) :\n    backend = Backend.exact := by\n  rw [hAuthorized]\n  exact irreversible_boundary_requires_exact boundary hIrreversible\n\nend CommunicativeArithmeticGuard\n\nend j81b1gmr\n"}
