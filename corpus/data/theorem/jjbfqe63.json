":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/0/1","text":"t","token_id":"qg6hprvj.Parenting.instYoungParentAtToParent::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"r947bax0","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"qg6hprvj.Parenting.YoungParent.At","subexpr_pos":"/1/1/0","text":"qg6hprvj.Parenting.YoungParent.At x t","token_id":"qg6hprvj.Parenting.instYoungParentAtToParent::empty/value::3","token_role":null}},{"node":"text","text":"] => "},{"child":{"children":[{"node":"text","text":"mwh5b5da.UniversalAtUnder.parent "},{"child":{"node":"text","text":"qg6hprvj.Parenting.YoungParent.U"},"node":"tag","tag":{"binder_role":"use_site","def_id":"dwt6bghm","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"qg6hprvj.Parenting.YoungParent.U","subexpr_pos":"/1/1/1/0/0/0/0/1","text":"qg6hprvj.Parenting.YoungParent.U","token_id":"qg6hprvj.Parenting.instYoungParentAtToParent::empty/value::7","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"nrhqjxz5.Person.At x t","kind":"stdlib","qualified_name":"mwh5b5da.UniversalAtUnder.parent","subexpr_pos":"/1/1/1","text":"mwh5b5da.UniversalAtUnder.parent qg6hprvj.Parenting.YoungParent.U","token_id":"qg6hprvj.Parenting.instYoungParentAtToParent::empty/value::6","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"∀ (x t : Type) [qg6hprvj.Parenting.YoungParent.At x t], nrhqjxz5.Person.At x t","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun x t [qg6hprvj.Parenting.YoungParent.At x t] => mwh5b5da.UniversalAtUnder.parent qg6hprvj.Parenting.YoungParent.U","token_id":"qg6hprvj.Parenting.instYoungParentAtToParent::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.a4hsz51v\nimport A.ta3nj1a4\nimport A.r59jf3ak\nimport A.nrhqjxz5\n\nopen nrhqjxz5\n\nnamespace qg6hprvj\n\nnamespace Parenting\n\nopen a4hsz51v\n\nopen ta3nj1a4\nopen r59jf3ak\n\nopen t0d1zdc3\n\nuniversal YoungParent extends Person := \"parent of a young child\"\n\nrelation ObligatedTo : Person \"is obligated to bring it about that\" Prop\nrelation CanBringAbout : Person \"is able to bring it about that\" Prop\nrelation HypervigilantAt : Person \"is in a state of hypervigilance at\" TemporalRegion\nrelation CalmAt : Person \"is in a state of physiological calm at\" TemporalRegion\n\nscoped notation:50 x:51 \" obligated-to \" q:51 => ObligatedTo x q\nscoped notation:50 x:51 \" can-bring-about \" q:51 => CanBringAbout x q\nscoped notation:50 x:51 \" hypervigilant-at \" t:51 => HypervigilantAt x t\nscoped notation:50 x:51 \" calm-at \" t:51 => CalmAt x t\n\ndef CalmHypervigilanceParentingStandard : Prop :=\n  ∀ p t, YoungParent.At p t → p obligated-to (p calm-at t ∧ p hypervigilant-at t)\n\ntheorem calm_hypervigilance_standard_refuted\n    (ought_implies_can : ∀ p q, p obligated-to q → p can-bring-about q)\n    (incompatible_psych_states : ∀ p t, ¬ (p can-bring-about (p calm-at t ∧ p hypervigilant-at t)))\n    (some_young_parent : ∃ p t, YoungParent.At p t)\n  : ¬ CalmHypervigilanceParentingStandard := by\n  intro std\n  obtain ⟨p, t, h⟩ := some_young_parent\n  exact incompatible_psych_states p t (ought_implies_can p _ (std p t h))\n\ntheorem calm_hypervigilance_standard_asserted_is_false\n    (logic_is_actual : LogicIsActual)\n    (ought_implies_can : ∀ p q, p obligated-to q → p can-bring-about q)\n    (incompatible_psych_states : A (∀ p t, ¬ (p can-bring-about (p calm-at t ∧ p hypervigilant-at t))))\n    (some_young_parent : A (∃ p t, YoungParent.At p t))\n    (parents_must_be_calm_and_hyperviligant : A CalmHypervigilanceParentingStandard)\n  : False :=\n  logic_is_actual.consistency\n    (logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.mp _ _\n          (logic_is_actual.actual_intro _\n            (fun incompat some_yp std =>\n              calm_hypervigilance_standard_refuted ought_implies_can incompat some_yp std))\n          incompatible_psych_states)\n        some_young_parent)\n      parents_must_be_calm_and_hyperviligant)\n\nend Parenting\n\nend qg6hprvj\n"}
