wh5b5da.RigidlyIsUnder.parent "},{"child":{"node":"text","text":"npec8rkc.CapabilitySet.At"},"node":"tag","tag":{"binder_role":"use_site","def_id":"sq8xq1bv","hover_kind":"term","inlined_type_summary":"Type → Type → Prop","kind":"type","qualified_name":"npec8rkc.CapabilitySet.At","subexpr_pos":"/1/1/0/0/0/1","text":"npec8rkc.CapabilitySet.At","token_id":"npec8rkc.instCapabilitySetIsToParent::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"ta3nj1a4.GenericallyDependentContinuant.Is x","kind":"stdlib","qualified_name":"mwh5b5da.RigidlyIsUnder.parent","subexpr_pos":"/1/1","text":"mwh5b5da.RigidlyIsUnder.parent npec8rkc.CapabilitySet.At","token_id":"npec8rkc.instCapabilitySetIsToParent::empty/value::4","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"∀ (x : Type) [npec8rkc.CapabilitySet.Is x], ta3nj1a4.GenericallyDependentContinuant.Is x","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun x [npec8rkc.CapabilitySet.Is x] => mwh5b5da.RigidlyIsUnder.parent npec8rkc.CapabilitySet.At","token_id":"npec8rkc.instCapabilitySetIsToParent::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.ta3nj1a4\nimport A.r59jf3ak\n\nopen ta3nj1a4\nopen r59jf3ak\n\n-- Hunter Ash: https://x.com/ArtemisConsort/status/2030019327928492320\n-- BFO-register version of Workspace/AIConsciousnessDilemma.lean\n\nopen t0d1zdc3\n\nnamespace npec8rkc\n\nrigid universal AISystem extends Object := \"AI system\"\nrigid universal CapabilitySet extends GenericallyDependentContinuant := \"set of capabilities\"\n\nrelation PossessesAt : Object \"possesses\" CapabilitySet \"at\" TemporalRegion\nrelation ConsciousAt : Object \"is conscious at\" TemporalRegion\n\ndef AICanNeverBeConscious : Prop :=\n  ∀ s : Type, AISystem.Is s → ∀ t : Type, ¬ ConsciousAt s t\n\ndef SufficesForConsciousness (c : Type) : Prop :=\n  ∀ s t : Type, PossessesAt s c t → ConsciousAt s t\n\ndef SomeCapabilitiesSufficeForConsciousness : Prop :=\n  ∃ c : Type, CapabilitySet.Is c ∧ SufficesForConsciousness c\n\ndef ConsciousnessLinkedToCapabilitiesAIWillNeverPossess : Prop :=\n  ∃ c : Type, CapabilitySet.Is c ∧ SufficesForConsciousness c ∧\n    ∀ s t : Type, AISystem.Is s → ¬ PossessesAt s c t\n\ntheorem denying_ai_consciousness_requires_one_of_two_beliefs\n    (logic_is_actual : LogicIsActual)\n    (skeptic : A AICanNeverBeConscious) :\n    A ConsciousnessLinkedToCapabilitiesAIWillNeverPossess ∨\n      A (¬ SomeCapabilitiesSufficeForConsciousness) :=\n  (Classical.em SomeCapabilitiesSufficeForConsciousness).elim\n    (fun suff =>\n      Or.inl (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _\n          (fun never_conscious =>\n            suff.elim fun c hc =>\n              ⟨c, hc.1, hc.2, fun s t s_ai s_has =>\n                never_conscious s s_ai t (hc.2 s t s_has)⟩))\n        skeptic))\n    (fun not_suff => Or.inr (logic_is_actual.actual_intro _ not_suff))\n\nend npec8rkc\n"}
