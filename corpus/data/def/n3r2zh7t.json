id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/","text":"Axiom.Actual (Axiom.getSemantics \"exploiting animals for commercial gain is mistreating them\")","token_id":"mbsxqzvd.P3::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.gwcwyrvb\n\nopen gwcwyrvb\n\nnamespace mbsxqzvd\n\n-- https://reddit.com/r/askphilosophy/comments/g2002v/\n\ndef P1 := A (\"we have a duty to perfect our moral character\" : Prop)\ndef P2 := A (\"when we mistreat animals, we corrupt our moral character\" : Prop)\ndef P3 := A (\"exploiting animals for commercial gain is mistreating them\" : Prop)\ndef P4 := A (\"eating meat exploits animals for commercial gain\" : Prop)\ndef C1 := A (\"we mustn't mistreat animals\" : Prop)\ndef C2 := A (\"we mustn't eat meat\" : Prop)\n\ndef no_mistreat : Prop := P1 ∧ P2 → C1\n\ndef no_eat_meat : Prop := C1 ∧ P3 ∧ P4 → C2\n\ntheorem c1_by_modus_ponens\n    (p1 : P1) (p2 : P2) (no_mistreat_bridge : no_mistreat)\n  : C1 :=\n  no_mistreat_bridge ⟨p1, p2⟩\n\ntheorem must_not_eat_meat\n    (p1 : P1) (p2 : P2) (no_mistreat_bridge : no_mistreat)\n    (p3 : P3) (p4 : P4) (no_eat_meat_bridge : no_eat_meat)\n  : C2 :=\n  no_eat_meat_bridge ⟨c1_by_modus_ponens p1 p2 no_mistreat_bridge, p3, p4⟩\n\nend mbsxqzvd\n","members":[],"source_lines":{"end":12,"start":12},"theorem_statement":null},"referenced_by":[{"def_id":"smpgxsjc","display_kind":"theorem","file_id":"mbsxqzvd","kind":"theorem","local_name":"must_not_eat_meat","qualified_name":"mbsxqzvd.must_not_eat_meat"},{"def_id":"w6ydztrt","display_kind":"definition","file_id":"mbsxqzvd","kind":"definition","local_name":"no_eat_meat","qualified_name":"mbsxqzvd.no_eat_meat"}]}
