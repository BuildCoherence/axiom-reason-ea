2788,"def_id":"q36nbnas","hover_kind":"term","inlined_type_summary":"Type → Prop","kind":"type","qualified_name":"t8grzs37.NonAgePunishmentRelevantCircumstances","text":"NonAgePunishmentRelevantCircumstances","token_id":"t8grzs37.TwoConcreteMurderCases::src::56","token_role":null},{"binder_role":"use_site","byte_end":2837,"byte_start":2826,"def_id":"hfpynx81","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"t8grzs37.ChildMurder","text":"ChildMurder","token_id":"t8grzs37.TwoConcreteMurderCases::src::57","token_role":null},{"binder_role":"use_site","byte_end":2841,"byte_start":2838,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"notation","qualified_name":"Iff","text":"↔","token_id":"t8grzs37.TwoConcreteMurderCases::src::58","token_role":null},{"binder_role":"use_site","byte_end":2885,"byte_start":2848,"def_id":"q36nbnas","hover_kind":"term","inlined_type_summary":"Type → Prop","kind":"type","qualified_name":"t8grzs37.NonAgePunishmentRelevantCircumstances","text":"NonAgePunishmentRelevantCircumstances","token_id":"t8grzs37.TwoConcreteMurderCases::src::59","token_role":null},{"binder_role":"use_site","byte_end":2897,"byte_start":2886,"def_id":"ey30gwdx","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"t8grzs37.AdultMurder","text":"AdultMurder","token_id":"t8grzs37.TwoConcreteMurderCases::src::60","token_role":null}],"type_tokens":{"author":null,"empty":{"child":{"node":"text","text":"Prop"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Prop","token_id":"t8grzs37.TwoConcreteMurderCases::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.r59jf3ak\nimport A.ta3nj1a4\n\nopen r59jf3ak\nopen ta3nj1a4\n\nopen t0d1zdc3\nopen gwcwyrvb\n\nnamespace t8grzs37\n\nrigid universal Person extends Object := \"person\"\nuniversal Child extends Person := \"child\"\nrigid universal Murder extends Process := \"murder\"\nrigid universal PunishmentSpecification extends GenericallyDependentContinuant := \"punishment specification\"\n\nrelation MurdersIn : Person → Person → Murder := \"murders in\"\nrelation DeservesPunishmentFor : Person → Process → PunishmentSpecification :=\n  \"deserves punishment specification for\"\nrelation GreaterPunishmentThan : PunishmentSpecification → PunishmentSpecification := \"is greater than\"\nrelation NonAgePunishmentRelevantCircumstances : Murder := \"punishment relevant circumstances other than victim's age\"\n\nstructure MurderCase where\n  murder : Murder\n  murderer : Person\n  victim : Person\n  punishment : PunishmentSpecification\n  murders_in :\n    MurdersIn murderer victim murder\n  deserved_punishment :\n    DeservesPunishmentFor murderer murder punishment\n\ndef VictimIsChild (mc : MurderCase) :=\n  ∃ t, Child.At mc.victim t ∧ OccupiesTemporalRegion mc.murder t\n\ndef SameNonVictimAgeCircumstances (mc1 mc2 : MurderCase) :=\n  (NonAgePunishmentRelevantCircumstances mc1.murder) ↔ (NonAgePunishmentRelevantCircumstances mc2.murder)\n\ndef ChildMurderDeservesGreaterPunishmentThanNonChildMurder : Prop :=\n  ∀ mc1 mc2 : MurderCase, SameNonVictimAgeCircumstances mc1 mc2 →\n    VictimIsChild mc1 → ¬ VictimIsChild mc2 →\n      GreaterPunishmentThan mc1.punishment mc2.punishment\n\ndef Murderer : Type := \"The Marjory Stoneman Douglas High School shooter\"\ndef ChildVictim : Type := \"Alyssa Alhadeff\"\ndef ChildMurder : Type := \"the murder of Alyssa Alhadeff\"\ndef ChildCasePunishmentSpec : Type :=\n  \"the punishment specification deserved for the murder of Alyssa Alhadeff\"\n\ndef AdultVictim : Type := \"Chris Hixon\"\ndef AdultMurder : Type := \"the murder of Chris Hixon\"\ndef AdultCasePunishmentSpec : Type :=\n  \"the punishment specification deserved for the murder of Chris Hixon\"\n\nstructure TwoConcreteMurderCases : Prop where\n  child_case_involvement :\n    MurdersIn Murderer ChildVictim ChildMurder\n  child_case_deserved_punishment :\n    DeservesPunishmentFor Murderer ChildMurder ChildCasePunishmentSpec\n  child_case_victim_is_child :\n    ∃ t, Child.At ChildVictim t ∧ OccupiesTemporalRegion ChildMurder t\n  non_child_case_involvement :\n    MurdersIn Murderer AdultVictim AdultMurder\n  non_child_case_deserved_punishment :\n    DeservesPunishmentFor Murderer AdultMurder AdultCasePunishmentSpec\n  non_child_case_victim_is_not_child :\n    ¬ ∃ t, Child.At AdultVictim t ∧ OccupiesTemporalRegion AdultMurder t\n  same_non_victim_age_circumstances :\n    NonAgePunishmentRelevantCircumstances ChildMurder ↔\n      NonAgePunishmentRelevantCircumstances AdultMurder\n\ntheorem child_case_deserves_greater_punishment\n    (logic_is_actual : LogicIsActual)\n    (principle : A ChildMurderDeservesGreaterPunishmentThanNonChildMurder)\n    (cases : A TwoConcreteMurderCases) :\n    A (GreaterPunishmentThan\n      ChildCasePunishmentSpec\n      AdultCasePunishmentSpec) := by\n  exact\n    logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _\n          (fun (principle : ChildMurderDeservesGreaterPunishmentThanNonChildMurder)\n               (cases : TwoConcreteMurderCases) => by\n            letI : Person.Is Murderer := cases.child_case_involvement.inst0\n            letI : Person.Is ChildVictim := cases.child_case_involvement.inst1\n            letI : Murder.Is ChildMurder := cases.child_case_involvement.inst2\n            letI : PunishmentSpecification.Is ChildCasePunishmentSpec :=\n              cases.child_case_deserved_punishment.inst2\n            letI : Person.Is AdultVictim := cases.non_child_case_involvement.inst1\n            letI : Murder.Is AdultMurder := cases.non_child_case_involvement.inst2\n            letI : PunishmentSpecification.Is AdultCasePunishmentSpec :=\n              cases.non_child_case_deserved_punishment.inst2\n            let childCase : MurderCase :=\n              { murder := ChildMurder\n                murderer := Murderer\n                victim := ChildVictim\n                punishment := ChildCasePunishmentSpec\n                murders_in := cases.child_case_involvement\n                deserved_punishment := cases.child_case_deserved_punishment }\n            let nonChildCase : MurderCase :=\n              { murder := AdultMurder\n                murderer := Murderer\n                victim := AdultVictim\n                punishment := AdultCasePunishmentSpec\n                murders_in := cases.non_child_case_involvement\n                deserved_punishment := cases.non_child_case_deserved_punishment }\n            have sameCircumstances : SameNonVictimAgeCircumstances childCase nonChildCase :=\n              cases.same_non_victim_age_circumstances\n            have childVictimIsChild : VictimIsChild childCase :=\n              cases.child_case_victim_is_child\n            have nonChildVictimIsNotChild : ¬ VictimIsChild nonChildCase :=\n              cases.non_child_case_victim_is_not_child\n            exact principle childCase nonChildCase\n              sameCircumstances\n              childVictimIsChild\n              nonChildVictimIsNotChild))\n        principle)\n      cases\n\nend t8grzs37\n","members":[{"conclusion_prop":"fq41qr40","def_id":"yd1xms4e","display_kind":"field","kind":"theorem","local_name":"TwoConcreteMurderCases.child_case_involvement","qualified_name":"t8grzs37.TwoConcreteMurderCases.child_case_involvement"},{"def_id":"w3rw7naz","display_kind":"constructor","kind":"constructor","local_name":"TwoConcreteMurderCases.mk","qualified_name":"t8grzs37.TwoConcreteMurderCases.mk"},{"conclusion_prop":"zqc8qpeq","def_id":"mt6n6v6a","display_kind":"field","kind":"theorem","local_name":"TwoConcreteMurderCases.child_case_deserved_punishment","qualified_name":"t8grzs37.TwoConcreteMurderCases.child_case_deserved_punishment"},{"conclusion_prop":"emv67j6k","def_id":"aevcm9wj","display_kind":"field","kind":"theorem","local_name":"TwoConcreteMurderCases.child_case_victim_is_child","qualified_name":"t8grzs37.TwoConcreteMurderCases.child_case_victim_is_child"},{"conclusion_prop":"y6z3cpr8","def_id":"x1w0fgwn","display_kind":"field","kind":"theorem","local_name":"TwoConcreteMurderCases.non_child_case_involvement","qualified_name":"t8grzs37.TwoConcreteMurderCases.non_child_case_involvement"},{"conclusion_prop":"trjazz81","def_id":"a9yb7ted","display_kind":"field","kind":"theorem","local_name":"TwoConcreteMurderCases.non_child_case_deserved_punishment","qualified_name":"t8grzs37.TwoConcreteMurderCases.non_child_case_deserved_punishment"},{"conclusion_prop":"srtj2brd","def_id":"ft3ngpgv","display_kind":"field","kind":"theorem","local_name":"TwoConcreteMurderCases.non_child_case_victim_is_not_child","qualified_name":"t8grzs37.TwoConcreteMurderCases.non_child_case_victim_is_not_child"},{"conclusion_prop":"q8hgyya6","def_id":"wzdw5b5d","display_kind":"field","kind":"theorem","local_name":"TwoConcreteMurderCases.same_non_victim_age_circumstances","qualified_name":"t8grzs37.TwoConcreteMurderCases.same_non_victim_age_circumstances"}],"source_lines":{"end":73,"start":58},"theorem_statement":null},"referenced_by":[{"def_id":"qwdftt8h","display_kind":"theorem","file_id":"t8grzs37","kind":"theorem","local_name":"child_case_deserves_greater_punishment","qualified_name":"t8grzs37.child_case_deserves_greater_punishment"},{"def_id":"mt6n6v6a","display_kind":"field","file_id":"t8grzs37","kind":"theorem","local_name":"TwoConcreteMurderCases.child_case_deserved_punishment","qualified_name":"t8grzs37.TwoConcreteMurderCases.child_case_deserved_punishment"},{"def_id":"yd1xms4e","display_kind":"field","file_id":"t8grzs37","kind":"theorem","local_name":"TwoConcreteMurderCases.child_case_involvement","qualified_name":"t8grzs37.TwoConcreteMurderCases.child_case_involvement"},{"def_id":"aevcm9wj","display_kind":"field","file_id":"t8grzs37","kind":"theorem","local_