ple_are_immoral), (\"i_am_a_person\", i_am_a_person), (\"metabias_is_a_person\", metabias_is_a_person), (\"everyone_makes_mistakes\", everyone_makes_mistakes)]\n\naxiom user_axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1784339390)\n\ndef userAxioms : UserAxioms \"sam\" 1784339390 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend wwqc19pp\n","members":[],"source_lines":{"end":29,"start":29},"theorem_statement":null},"referenced_by":[{"def_id":"pntrt8vq","display_kind":"definition","file_id":"d26agzaz","kind":"definition","local_name":"metabias_is_a_person","qualified_name":"d26agzaz.metabias_is_a_person"},{"def_id":"z0wcz7a5","display_kind":"definition","file_id":"h3cfdqwq","kind":"definition","local_name":"metabias_is_a_person","qualified_name":"h3cfdqwq.metabias_is_a_person"},{"def_id":"mazwdea0","display_kind":"definition","file_id":"h8b5ehpf","kind":"definition","local_name":"metabias_is_a_person","qualified_name":"h8b5ehpf.metabias_is_a_person"},{"def_id":"qhzc6fm8","display_kind":"definition","file_id":"s593tfe3","kind":"definition","local_name":"metabias_is_a_person","qualified_name":"s593tfe3.metabias_is_a_person"},{"def_id":"tth1z8wf","display_kind":"definition","file_id":"t9e0stky","kind":"definition","local_name":"metabias_is_a_person","qualified_name":"t9e0stky.metabias_is_a_person"},{"def_id":"wnnzf2aq","display_kind":"definition","file_id":"td0atmnm","kind":"definition","local_name":"metabias_is_a_person","qualified_name":"td0atmnm.metabias_is_a_person"},{"def_id":"xz8aes3w","display_kind":"definition","file_id":"wwqc19pp","kind":"definition","local_name":"userAxiomsList","qualified_name":"wwqc19pp.userAxiomsList"}]}
