t_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend fs83ayjj\n","members":[],"source_lines":{"end":16,"start":16},"theorem_statement":null},"referenced_by":[{"def_id":"cvr64nvv","display_kind":"definition","file_id":"fs83ayjj","kind":"definition","local_name":"ImmoralBelowNonImmoral","qualified_name":"fs83ayjj.ImmoralBelowNonImmoral"},{"def_id":"acst99t4","display_kind":"definition","file_id":"fs83ayjj","kind":"definition","local_name":"LessMoralThan","qualified_name":"fs83ayjj.LessMoralThan"},{"def_id":"twf6r0hq","display_kind":"definition","file_id":"fs83ayjj","kind":"definition","local_name":"MoralComparisonIsCoherent.casesOn","qualified_name":"fs83ayjj.MoralComparisonIsCoherent.casesOn"},{"def_id":"zkkqvvcg","display_kind":"constructor","file_id":"fs83ayjj","kind":"constructor","local_name":"MoralComparisonIsCoherent.mk","qualified_name":"fs83ayjj.MoralComparisonIsCoherent.mk"},{"def_id":"bxwqkjj7","display_kind":"field","file_id":"fs83ayjj","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_irreflexive","qualified_name":"fs83ayjj.MoralComparisonIsCoherent.more_moral_irreflexive"},{"def_id":"g24vtrsn","display_kind":"field","file_id":"fs83ayjj","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_transitive","qualified_name":"fs83ayjj.MoralComparisonIsCoherent.more_moral_transitive"},{"def_id":"z70vtk98","display_kind":"theorem","file_id":"fs83ayjj","kind":"theorem","local_name":"more_moral_asymmetric","qualified_name":"fs83ayjj.more_moral_asymmetric"}]}
