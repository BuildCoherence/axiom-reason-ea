tion.recipientNodes o ∧\n      kdvdwae2.CapabilityCompressionTransferObservation.compressedSignalUnits o ≤\n          kdvdwae2.CapabilityCompressionTransferObservation.sourceEntropyUnits o ∧\n        kdvdwae2.CapabilityCompressionTransferObservation.validatedRecipientUses o ≤\n            kdvdwae2.CapabilityCompressionTransferObservation.transferredSignals o ∧\n          kdvdwae2.CapabilityCompressionTransferObservation.isolatedModelValidatedUses o ≤\n              kdvdwae2.CapabilityCompressionTransferObservation.recipientNodes o ∧\n            kdvdwae2.CapabilityCompressionTransferObservation.routedModelValidatedUses o ≤\n              kdvdwae2.CapabilityCompressionTransferObservation.recipientNodes o","token_id":"kdvdwae2.WellFormedCapabilityCompressionTransferObservation::empty/value::7","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"And","subexpr_pos":"/1","text":"0 < kdvdwae2.CapabilityCompressionTransferObservation.sourceEntropyUnits o ∧\n    0 < kdvdwae2.CapabilityCompressionTransferObservation.recipientNodes o ∧\n      kdvdwae2.CapabilityCompressionTransferObservation.compressedSignalUnits o ≤\n          kdvdwae2.CapabilityCompressionTransferObservation.sourceEntropyUnits o ∧\n        kdvdwae2.CapabilityCompressionTransferObservation.validatedRecipientUses o ≤\n            kdvdwae2.CapabilityCompressionTransferObservation.transferredSignals o ∧\n          kdvdwae2.CapabilityCompressionTransferObservation.isolatedModelValidatedUses o ≤\n              kdvdwae2.CapabilityCompressionTransferObservation.recipientNodes o ∧\n            kdvdwae2.CapabilityCompressionTransferObservation.routedModelValidatedUses o ≤\n              kdvdwae2.CapabilityCompressionTransferObservation.recipientNodes o","token_id":"kdvdwae2.WellFormedCapabilityCompressionTransferObservation::empty/value::2","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"kdvdwae2.CapabilityCompressionTransferObservation → Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun o =>\n  0 < kdvdwae2.CapabilityCompressionTransferObservation.sourceEntropyUnits o ∧\n    0 < kdvdwae2.CapabilityCompressionTransferObservation.recipientNodes o ∧\n      kdvdwae2.CapabilityCompressionTransferObservation.compressedSignalUnits o ≤\n          kdvdwae2.CapabilityCompressionTransferObservation.sourceEntropyUnits o ∧\n        kdvdwae2.CapabilityCompressionTransferObservation.validatedRecipientUses o ≤\n            kdvdwae2.CapabilityCompressionTransferObservation.transferredSignals o ∧\n          kdvdwae2.CapabilityCompressionTransferObservation.isolatedModelValidatedUses o ≤\n              kdvdwae2.CapabilityCompressionTransferObservation.recipientNodes o ∧\n            kdvdwae2.CapabilityCompressionTransferObservation.routedModelValidatedUses o ≤\n              kdvdwae2.CapabilityCompressionTransferObservation.recipientNodes o","token_id":"kdvdwae2.WellFormedCapabilityCompressionTransferObservation::empty/value::0","token_role":null}}}},"file_content":"import Axiom\n\nnamespace kdvdwae2\n\nstructure CapabilityCompressionTransferObservation where\n  sourceEntropyUnits : Nat\n  compressedSignalUnits : Nat\n  recipientNodes : Nat\n  transferredSignals : Nat\n  validatedRecipientUses : Nat\n  sourceCostCents : Nat\n  compressionCostCents : Nat\n  transferCostCents : Nat\n  validationCostCents : Nat\n  recipientCorrectionWork : Nat\n  isolatedModelCostCents : Nat\n  isolatedModelValidatedUses : Nat\n  routedModelCostCents : Nat\n  routedModelValidatedUses : Nat\n\n\ndef WellFormedCapabilityCompressionTransferObservation (o : CapabilityCompressionTransferObservation) : Prop :=\n  0 < o.sourceEntropyUnits ∧\n    0 < o.recipientNodes ∧\n    o.compressedSignalUnits ≤ o.sourceEntropyUnits ∧\n    o.validatedRecipientUses ≤ o.transferredSignals ∧\n    o.isolatedModelValidatedUses ≤ o.recipientNodes ∧\n    o.routedModelValidatedUses ≤ o.recipientNodes\n\n\ndef StephLikeNetworkCapabilityCost (o : CapabilityCompressionTransferObservation) : Nat :=\n  o.sourceCostCents +\n    o.compressionCostCents +\n    o.transferCostCents +\n    o.validationCostCents\n\n\ndef NetworkedCompressionReachesRecipients (o : CapabilityCompressionTransferObservation) : Prop :=\n  o.validatedRecipientUses * o.recipientNodes ≥\n    o.isolatedModelValidatedUses * o.recipientNodes ∧\n    o.validatedRecipientUses ≥ o.routedModelValidatedUses\n\n\ndef NetworkedCompressionHasLowerCost (o : CapabilityCompressionTransferObservation) : Prop :=\n  StephLikeNetworkCapabilityCost o < o.isolatedModelCostCents ∧\n    StephLikeNetworkCapabilityCost o < o.routedModelCostCents\n\ndef connected_compression_capabilityPayload :=\n  \"A connected human capability can add value beyond source-level reasoning when it absorbs high-entropy input, compresses it into a recipient-legible signal, selects or reaches connected recipient nodes, and produces validated recipient use. The capability therefore includes compression, translation, routing, and recipient absorption rather than summarization alone.\"\naxiom connected_compression_capability_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", connected_compression_capabilityPayload, 1786205891)\ndef connected_compression_capability : Axiom.Statement \"hitchhiker2thefuture\" connected_compression_capabilityPayload 1786205891 := ⟨connected_compression_capability_auth⟩\n\ndef isolated_model_is_not_network_parity_controlPayload :=\n  \"An isolated model is a necessary baseline for a connected-compression experiment, but it is not an equivalent network control. It receives the source task without the recipient graph, recipient-specific context, routing path, or downstream absorption receipts. A routed model control must be evaluated separately.\"\naxiom isolated_model_is_not_network_parity_control_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", isolated_model_is_not_network_parity_controlPayload, 1786205891)\ndef isolated_model_is_not_network_parity_control : Axiom.Statement \"hitchhiker2thefuture\" isolated_model_is_not_network_parity_controlPayload 1786205891 := ⟨isolated_model_is_not_network_parity_control_auth⟩\n\ndef capability_compression_transfer_protocolPayload :=\n  \"Evaluate a connected compression capability on redacted high-entropy source packets with a frozen recipient set. Compare a human source node, an isolated model, and a model with equivalent recipient profiles and routing. Measure source entropy, compressed signal size, transfer cost, recipient-specific translation, validated recipient uses, recipient correction work, source and model costs, and reuse. Do not count a summary as a successful transfer unless a recipient uses the signal or passes a blinded absorption test.\"\naxiom capability_compression_transfer_protocol_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", capability_compression_transfer_protocolPayload, 1786205891)\ndef capability_compression_transfer_protocol : Axiom.Statement \"hitchhiker2thefuture\" capability_compression_transfer_protocolPayload 1786205891 := ⟨capability_compression_transfer_protocol_auth⟩\n\ndef networked_capability_cost_boundaryPayload :=\n  \"The cost of a connected compression capability is source acquisition plus compression, transfer, and validation cost. A lower cost than an isolated or routed model is admissible only when recipient usefulness and correction burden are measured on the same task suite. A smaller message is not automatically better compression, and temporal proximity is not proof of causal transfer.\"\naxiom networked_capability_cost_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", networked_capability_cost_boundaryPayload, 1786205891)\ndef networked_capability_cost_boundary : Axiom.Statement \"hitchhiker2thefuture\" networked_capability_cost_boundaryPayload 1786205891 := ⟨networked_capability_cost_boundary_auth⟩\n\nend kdvdwae2\n","members":[],"source_lines":{"end":28,"start":22},"theorem_statement":null},"referenced_by":[]}
