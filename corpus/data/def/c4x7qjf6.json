nstCoeBeliefConception._proof_1::empty/conclusion::4","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"gkgyz9dr","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"xmafsdvf.Information.Conception.Is","subexpr_pos":"/1","text":"xmafsdvf.Information.Conception.Is (Subtype.val v)","token_id":"av93fgyq.AxiomaticThinking.instCoeBeliefConception._proof_1::empty/conclusion::3","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"∀ (v : av93fgyq.AxiomaticThinking.Belief), xmafsdvf.Information.Conception.Is (Subtype.val v)","token_id":"av93fgyq.AxiomaticThinking.instCoeBeliefConception._proof_1::empty/conclusion::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.j12bzjgj\nimport A.azt4989z\nimport A.xmafsdvf\nimport A.rwj5ranz\n\nopen xmafsdvf\nopen rwj5ranz\n\nopen t0d1zdc3\nopen gwcwyrvb\nopen j12bzjgj\nopen c424c6bg\nopen BFO\nopen azt4989z\nopen Information\n\nnamespace av93fgyq\n\nnamespace AxiomaticThinking\n\nrigid universal Belief extends Conception := \"belief\"\nrigid universal Action extends Process := \"action\"\n\nrelation Affirms : Belief → Prop := \"affirms\"\nrelation Does : Person → Action := \"does\"\nrelation ExistsInThePerceivedPhysicalSpaceOf : Prop → Person :=\n  \"exists in the perceived physical space of\"\n\nscoped infixl:50 \" affirms \" => Affirms\nscoped infixl:50 \" does \" => Does\nscoped infixl:50 \" exists-in-perceived-physical-space-of \" => ExistsInThePerceivedPhysicalSpaceOf\n\ndef BeliefCanBeContradictory : Prop :=\n  ∃ b : Belief, ∃ p : Prop, (b affirms p) ∧ (b affirms ¬p)\n\ndef MyPerceivedSpaceIsActuality : Prop :=\n  ∀ p : Prop, (p exists-in-perceived-physical-space-of MetaBias) ↔ A p\n\ntheorem my_physical_space_not_contradictory\n    (logic_is_actual : LogicIsActual)\n    (my_perceived_space_is_actuality : MyPerceivedSpaceIsActuality) :\n    ∀ p : Prop, ¬ ((p exists-in-perceived-physical-space-of MetaBias)\n      ∧ ((¬ p) exists-in-perceived-physical-space-of MetaBias)) := by\n  intro p hp\n  have h1 : A p := (my_perceived_space_is_actuality p).mp hp.1\n  have h2 : A (¬ p) := (my_perceived_space_is_actuality (¬ p)).mp hp.2\n  exact logic_is_actual.consistency (logic_is_actual.mp p False h2 h1)\n\nrigid universal Communication extends Process := \"act of communication\"\n\nrelation OwnerOf : Person → Communication := \"is owner of\"\nrelation RecipientOf : Person → Communication := \"is recipient of\"\nrelation Communicates : Communication → Belief := \"communicates\"\nrelation MoreExplicitThan : Communication → Communication := \"is more explicit than\"\n\nscoped infixl:50 \" owner-of \" => OwnerOf\nscoped infixl:50 \" recipient-of \" => RecipientOf\nscoped infixl:50 \" communicates \" => Communicates\nscoped infixl:50 \" more-explicit-than \" => MoreExplicitThan\n\nrelation DerivedFrom : Belief → Belief := \"is derived from\"\nscoped infixl:50 \" derived-from \" => DerivedFrom\n\ndef Premise (b : Belief) : Prop :=\n  ¬ ∃ b' : Belief, b derived-from b'\n\nrelation HoldsBelief : Person → Belief := \"holds belief\"\nscoped infixl:50 \" holds-belief \" => HoldsBelief\n\nrigid universal Inference extends Process := \"inference\"\n\nrelation Concludes : Inference → Belief := \"concludes\"\nrelation Assumes : Inference → Belief := \"assumes\"\nrelation MoreCoherentThan : Inference → Inference := \"is more coherent than\"\n\nscoped infixl:50 \" concludes \" => Concludes\nscoped infixl:50 \" assumes \" => Assumes\nscoped infixl:50 \" more-coherent-than \" => MoreCoherentThan\n\ndef HoldsContradiction (per : Person) (b : Belief) : Prop :=\n  ∃ b' : Belief, ∃ p : Prop,\n    (per holds-belief b) ∧ (per holds-belief b') ∧ (b affirms p) ∧ (b' affirms ¬p)\n\nend AxiomaticThinking\n\nend av93fgyq\n","members":[],"source_lines":{"end":24,"start":24},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"tgpt9czb","tokens":{"author":null,"empty":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"v"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"v","token_id":"av93fgyq.AxiomaticThinking.instCoeBeliefConception._proof_1::empty/conclusion::1","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"av93fgyq.AxiomaticThinking.Belief"},"node":"tag","tag":{"binder_role":"use_site","def_id":"e5qe2rc3","hover_kind":"term","inlined_type_summary":"Type 1","kind":"type","qualified_name":"av93fgyq.AxiomaticThinking.Belief","subexpr_pos":"/0","text":"av93fgyq.AxiomaticThinking.Belief","token_id":"av93fgyq.AxiomaticThinking.instCoeBeliefConception._proof_1::empty/conclusion::2","token_role":null}},{"node":"text","text":"), "},{"child":{"children":[{"node":"text","text":"xmafsdvf.Information.Conception.Is "},{"child":{"children":[{"node":"text","text":"(Subtype.val "},{"child":{"node":"text","text":"v"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1","text":"v","token_id":"av93fgyq.AxiomaticThinking.instCoeBeliefConception._proof_1::empty/conclusion::5","token_role":null}},{"node":"text","text":")"}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"stdlib","qualified_name":"Subtype.val","subexpr_pos":"/1/1","text":"(Subtype.val v)","token_id":"av93fgyq.AxiomaticThinking.instCoeBeliefConception._proof_1::empty/conclusion::4","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"gkgyz9dr","hover_kind":"term","inlined_type_summary":"Pr