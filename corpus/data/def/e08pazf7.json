sACombinationOf\ninfixl:50 \" has-function \" => HasFunction\n\ndef ConceptionsOriginateFromObservations : Prop :=\n  A (∀ o : Observer, ∀ x : Type, ∀ c : Conception,\n    Entity x →\n    o observes x →\n    Conceptualizes o x c →\n    c is-a-combination-of InformationBits)\n\ndef ResultsInAProcess (x : Type) : Prop :=\n  ∃ f : Function, x has-function f ∧ ∃ p : Process, HasRealization f p\n\ndef ToolHasGeneralProperties (x : Type) : Prop :=\n  Tool.Is x ∧ x is-a-combination-of Conceptions ∧ ResultsInAProcess x\n\ndef DidNotExistBefore (x : Type) : Prop :=\n  ∃ t : Time, ExistsAt x t ∧ ∃ t₀ : Time, Precedes t₀ t ∧ ¬ ExistsAt x t₀\n\ndef Invention (x : Type) : Prop :=\n  ToolHasGeneralProperties x ∧ DidNotExistBefore x\n\nend Information\n\nend xmafsdvf\n","members":[],"source_lines":{"end":19,"start":19},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"gdyy2akp","tokens":{"author":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"x "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"x ","token_id":"xmafsdvf.Information.Conception.At.toParent::author/conclusion::1","token_role":null}},{"child":{"node":"text","text":"t"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"t","token_id":"xmafsdvf.Information.Conception.At.toParent::author/conclusion::2","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/1/0","text":"Type","token_id":"xmafsdvf.Information.Conception.At.toParent::author/conclusion::3","token_role":null}},{"node":"text","text":") ["},{"child":{