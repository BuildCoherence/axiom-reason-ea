= \"has moral character\"\nrelation MoreMoralThan : MoralCharacter → MoralCharacter := \"is more moral than\"\n\npostfix:max \" is-immoral\" => Immoral\ninfix:50 \" has-moral-character \" => HasMoralCharacter\ninfix:50 \" more-moral-than \" => MoreMoralThan\n\nabbrev LessMoralThan (a b : Type) : Prop := MoreMoralThan b a\n\ninfix:50 \" less-moral-than \" => LessMoralThan\n\nstructure MoralComparisonIsCoherent : Prop where\n  more_moral_irreflexive : ∀ m : MoralCharacter, ¬ (m more-moral-than m)\n  more_moral_transitive :\n    ∀ a b c : MoralCharacter,\n      a more-moral-than b → b more-moral-than c → a more-moral-than c\n\ndef ImmoralBelowNonImmoral : Prop :=\n  ∀ (p q : Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend pv802k7b\n","members":[],"source_lines":{"end":17,"start":17},"theorem_statement":null},"referenced_by":[{"def_id":"hxvqzd7x","display_kind":"definition","file_id":"pv802k7b","kind":"definition","local_name":"ImmoralBelowNonImmoral","qualified_name":"pv802k7b.ImmoralBelowNonImmoral"},{"def_id":"ym5wtddb","display_kind":"definition","file_id":"zk1mxe7x","kind":"definition","local_name":"DollyPartonIsRichAndNotImmoral","qualified_name":"zk1mxe7x.DollyPartonIsRichAndNotImmoral"},{"def_id":"qradv18j","display_kind":"definition","file_id":"zk1mxe7x","kind":"definition","local_name":"EveryPersonIsImmoral","qualified_name":"zk1mxe7x.EveryPersonIsImmoral"},{"def_id":"jh2pn6n2","display_kind":"definition","file_id":"zk1mxe7x","kind":"definition","local_name":"EveryRichPersonIsImmoral","qualified_name":"zk1mxe7x.EveryRichPersonIsImmoral"},{"def_id":"dq2vr0pn","display_kind":"theorem","file_id":"zk1mxe7x","kind":"theorem","local_name":"immoral_non_rich_twin_makes_rich_twin_immoral","qualified_name":"zk1mxe7x.immoral_non_rich_twin_makes_rich_twin_immoral"},{"def_id":"rpzw4agz","display_kind":"theorem","file_id":"zk1mxe7x","kind":"theorem","local_name":"named_counterexample_refutes","qualified_name":"zk1mxe7x.named_counterexample_refutes"},{"def_id":"xr1zwy2x","display_kind":"theorem","file_id":"zk1mxe7x","kind":"theorem","local_name":"not_every_means_some","qualified_name":"zk1mxe7x.not_every_means_some"},{"def_id":"bb1ey9rv","display_kind":"definition","file_id":"zk1mxe7x","kind":"definition","local_name":"OnlyRichPeopleAreImmoral","qualified_name":"zk1mxe7x.OnlyRichPeopleAreImmoral"},{"def_id":"jc41espr","display_kind":"theorem","file_id":"zk1mxe7x","kind":"theorem","local_name":"some_refutes_every","qualified_name":"zk1mxe7x.some_refutes_every"},{"def_id":"zd9wb65m","display_kind":"definition","file_id":"zk1mxe7x","kind":"definition","local_name":"SomeRichPersonIsNotImmoral","qualified_name":"zk1mxe7x.SomeRichPersonIsNotImmoral"}]}
