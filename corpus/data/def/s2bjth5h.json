:"/1/1/1/0/1/1","text":"e","token_id":"jh3kw4vp.AgEnslavesMammals::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"xst3pfm3","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"jh3kw4vp.Mammal.Is","subexpr_pos":"/1/1/1/0/1","text":"jh3kw4vp.Mammal.Is e","token_id":"jh3kw4vp.AgEnslavesMammals::empty/value::4","token_role":null}},{"node":"text","text":" ∧ "},{"child":{"children":[{"node":"text","text":"jh3kw4vp.CausesEnslavementOf "},{"child":{"node":"text","text":"jh3kw4vp.AnimalAg21Cent"},"node":"tag","tag":{"binder_role":"use_site","def_id":"d6dx9qm6","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"jh3kw4vp.AnimalAg21Cent","subexpr_pos":"/1/1/1/1/0/1","text":"jh3kw4vp.AnimalAg21Cent","token_id":"jh3kw4vp.AgEnslavesMammals::empty/value::7","token_role":null}},{"node":"text","text":" "},{"child":{"node":"text","text":"e"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1/1/1","text":"e","token_id":"jh3kw4vp.AgEnslavesMammals::empty/value::8","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"mw11sway","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"jh3kw4vp.CausesEnslavementOf","subexpr_pos":"/1/1/1/1","text":"jh3kw4vp.CausesEnslavementOf jh3kw4vp.AnimalAg21Cent e","token_id":"jh3kw4vp.AgEnslavesMammals::empty/value::6","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"And","subexpr_pos":"/1/1/1","text":"jh3kw4vp.Mammal.Is e ∧ jh3kw4vp.CausesEnslavementOf jh3kw4vp.AnimalAg21Cent e","token_id":"jh3kw4vp.AgEnslavesMammals::empty/value::3","token_role":null}},{"node":"text","text":")"}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Exists","subexpr_pos":"/1","text":"(∃ e, jh3kw4vp.Mammal.Is e ∧ jh3kw4vp.CausesEnslavementOf jh3kw4vp.AnimalAg21Cent e)","token_id":"jh3kw4vp.AgEnslavesMammals::empty/value::1","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/","text":"Axiom.Actual (∃ e, jh3kw4vp.Mammal.Is e ∧ jh3kw4vp.CausesEnslavementOf jh3kw4vp.AnimalAg21Cent e)","token_id":"jh3kw4vp.AgEnslavesMammals::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.xhnxzf59\nimport A.d4qbfhxh\n\nopen xhnxzf59\nopen d4qbfhxh\nopen mwh5b5da\n\nopen t0d1zdc3\nopen gwcwyrvb\n\nnamespace jh3kw4vp\n\nuniverse u\n\nrelation Permissible : Prop := \"permissible\"\ndef Unnecessary : Sort u → Prop := \"unnecessary\"\nrelation Produces : Prop → Type := \"produces\"\n\nrelation CausesHarm : Prop := \"causes harm\"\nrelation CanExperience : Type := \"can experience\"\nrelation HasCNS : Type := \"has CNS\"\nrigid universal Mammal extends Object := \"mammal\"\nrelation CausesEnslavementOf : Prop → Type := \"causes enslavement of\"\n\ndef EnslavementHarms := ∀ p : Prop, ∀ e : Type,\n  CanExperience e → CausesEnslavementOf p e → CausesHarm p\n\ndef UnnecessaryHarmImpermissible := ∀ p : Prop,\n  CausesHarm p → Unnecessary p → ¬ Permissible p\n\ndef UnnecessaryProduction := ∀ p : Prop, (∀ product : Type,\n  Produces p product → Unnecessary product) → Unnecessary p\n\ndef AnimalAg21Cent : Prop := \"doing animal agriculture in the 21st century\"\n\ndef UnnecessaryAg := A (∀ product : Type,\n  (Produces AnimalAg21Cent product → Unnecessary product))\n\ndef AgEnslavesMammals := A (∃ e : Type, Mammal.Is e ∧ CausesEnslavementOf AnimalAg21Cent e)\n\ndef CNSCanExperience := ∀ e : Type, HasCNS e → CanExperience e\n\ndef MammalsHaveCNS := ∀ e : Type, Mammal.Is e → HasCNS e\n\ndef MammalsCanExperience := ∀ e : Type, Mammal.Is e → CanExperience e\n\ntheorem mammals_can_experience\n    (h₁ : CNSCanExperience) (h₂ : MammalsHaveCNS)\n  : MammalsCanExperience := by\n intro e\n intro is_mammal\n exact h₁ e (h₂ e is_mammal)\n\ntheorem animal_ag_impermissible\n    (logic_is_actual : LogicIsActual) (ag_unness : UnnecessaryAg) (ag_enslaves : AgEnslavesMammals)\n    (cns_can_ex : CNSCanExperience) (mammal_cns : MammalsHaveCNS)\n    (unness_harm_imperm : UnnecessaryHarmImpermissible) (unness_prod : UnnecessaryProduction)\n    (slavery_harms : EnslavementHarms)\n  : ¬ A (Permissible AnimalAg21Cent) := by\n  have mammal_ex := mammals_can_experience cns_can_ex mammal_cns\n  -- Harm: ag enslaves a mammal, mammals can experience, and enslaving an\n  -- experiencer harms. Lift that whole inference and fire it at the actual\n  -- enslavement fact (the witness stays inside the box — no Barcan needed).\n  have harm_rule :\n      (∃ e : Type, Mammal.Is e ∧ CausesEnslavementOf AnimalAg21Cent e) → CausesHarm AnimalAg21Cent :=\n    fun ⟨e, hmam, hens⟩ => slavery_harms AnimalAg21Cent e (mammal_ex e hmam) hens\n  have ag_harms : A (CausesHarm AnimalAg21Cent) :=\n    logic_is_actual.mp _ _ (logic_is_actual.actual_intro _ harm_rule) ag_enslaves\n  -- Unnecessary: everything ag produces is unnecessary, so ag is unnecessary.\n  have ag_unnecessary : A (Unnecessary AnimalAg21Cent) :=\n    logic_is_actual.mp _ _\n      (logic_is_actual.actual_intro _ (unness_prod AnimalAg21Cent)) ag_unness\n  -- Unnecessary harm is impermissible.\n  have ag_not_perm : A (¬ Permissible AnimalAg21Cent) :=\n    logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _ (unness_harm_imperm AnimalAg21Cent)) ag_harms)\n      ag_unnecessary\n  -- Were it actually permissible, that would make False actual — impossible.\n  intro ag_perm\n  exact logic_is_actual.consistency (logic_is_actual.mp _ _ ag_not_perm ag_perm)\n\nend jh3kw4vp\n","members":[],"source_lines":{"end":42,"start":42},"theorem_statement":null},"referenced_by":[{"def_id":"k0fexfht","display_kind":"theorem","file_id":"jh3kw4vp","kind":"theorem","local_name":"animal_ag_impermissible","qualified_name":"jh3kw4vp.animal_ag_impermissible"}]}
