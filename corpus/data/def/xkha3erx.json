olds = (\"world where Nazis won WWII\" : Prop → Prop)\n  nazis_won : holds NazisWon\n  -- This world is a \"fork\" of the actual world.\n  -- This Prop asserts it's the exact same as the actual world up until 1939.\n  pre1939 : ∀ p, A p → A (OccurredBefore1939 p) → holds p\n\n-- The more formal version of the example claim.\ndef NazisWonUSASpeakGerman :=\n  ∀ w : NazisWonWWIIWorld, w.holds GermanOfficialLanguageUSA2026\n\nend HypotheticalWorldExample\n\n-- Optionally, one could assert that the semantic string is definitionally equal to the more formal version.\ndef NazisWonUSASpeakGermanDef : Prop :=\n  NazisWonUSASpeakGerman = HypotheticalWorldExample.NazisWonUSASpeakGerman\n\n\nend q59pcv3b\n","members":[{"def_id":"yanm1vkj","display_kind":"constructor","kind":"constructor","local_name":"HypotheticalWorldExample.OccurredBefore1939.mk","qualified_name":"q59pcv3b.HypotheticalWorldExample.OccurredBefore1939.mk"},{"conclusion_prop":"q2pb5xrj","def_id":"sz70gmyd","display_kind":"field","kind":"theorem","local_name":"HypotheticalWorldExample.OccurredBefore1939.relation","qualified_name":"q59pcv3b.HypotheticalWorldExample.OccurredBefore1939.relation"}],"source_lines":{"end":23,"start":23},"theorem_statement":null},"referenced_by":[{"def_id":"fj5trm7d","display_kind":"definition","file_id":"q59pcv3b","kind":"definition","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.casesOn","qualified_name":"q59pcv3b.HypotheticalWorldExample.NazisWonWWIIWorld.casesOn"},{"def_id":"tz62ngwm","display_kind":"constructor","file_id":"q59pcv3b","kind":"constructor","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.mk","qualified_name":"q59pcv3b.HypotheticalWorldExample.NazisWonWWIIWorld.mk"},{"def_id":"yegk19pv","display_kind":"field","file_id":"q59pcv3b","kind":"theorem","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.pre1939","qualified_name":"q59pcv3b.HypotheticalWorldExample.NazisWonWWIIWorld.pre1939"}]}
