"stxpsv6g","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"m63bd0fm.NothingGreaterConceivable","subexpr_pos":"/0/1/1/1","text":"m63bd0fm.NothingGreaterConceivable","token_id":"m63bd0fm.ExistsInRealityBridge::empty/value::7","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"And","subexpr_pos":"/0/1/1","text":"m63bd0fm.GreaterIfInReality ∧ m63bd0fm.NothingGreaterConceivable","token_id":"m63bd0fm.ExistsInRealityBridge::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"And","subexpr_pos":"/0/1","text":"m63bd0fm.CanBeConceivedToExistInReality ∧ m63bd0fm.GreaterIfInReality ∧ m63bd0fm.NothingGreaterConceivable","token_id":"m63bd0fm.ExistsInRealityBridge::empty/value::3","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"And","subexpr_pos":"/0","text":"m63bd0fm.ExistsInTheUnderstanding ∧\n    m63bd0fm.CanBeConceivedToExistInReality ∧ m63bd0fm.GreaterIfInReality ∧ m63bd0fm.NothingGreaterConceivable","token_id":"m63bd0fm.ExistsInRealityBridge::empty/value::1","token_role":null}},{"node":"text","text":" →\n  "},{"child":{"node":"text","text":"m63bd0fm.ExistsInReality"},"node":"tag","tag":{"binder_role":"use_site","def_id":"mvbsw4ex","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"m63bd0fm.ExistsInReality","subexpr_pos":"/1","text":"m63bd0fm.ExistsInReality","token_id":"m63bd0fm.ExistsInRealityBridge::empty/value::8","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"m63bd0fm.ExistsInTheUnderstanding ∧\n    m63bd0fm.CanBeConceivedToExistInReality ∧ m63bd0fm.GreaterIfInReality ∧ m63bd0fm.NothingGreaterConceivable →\n  m63bd0fm.ExistsInReality","token_id":"m63bd0fm.ExistsInRealityBridge::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.gwcwyrvb\n\nopen gwcwyrvb\n\nnamespace m63bd0fm\n\n-- Anselm's ontological argument (Proslogion II), as reconstructed in\n-- https://plato.stanford.edu/entries/ontological-arguments/ (section 6)\n\ndef FoolUnderstandsTheWords : Prop :=\n  A (\"when the fool hears the words 'that than which no greater can be conceived' he understands those words\" : Prop)\ndef WhateverIsUnderstoodExistsInTheUnderstanding : Prop :=\n  A (\"whatever is understood exists in the understanding\" : Prop)\ndef ExistsInTheUnderstanding : Prop :=\n  A (\"that than which no greater can be conceived exists in the understanding\" : Prop)\ndef CanBeConceivedToExistInReality : Prop :=\n  A (\"if that than which no greater can be conceived exists in the understanding, it can be conceived to exist in reality\" : Prop)\ndef GreaterIfInReality : Prop :=\n  A (\"that than which no greater can be conceived is greater if it exists in reality than if it exists only in the understanding\" : Prop)\ndef NothingGreaterConceivable : Prop :=\n  A (\"it is impossible to conceive of something greater than that than which no greater can be conceived\" : Prop)\ndef ExistsInReality : Prop :=\n  A (\"that than which no greater can be conceived exists in reality\" : Prop)\ndef GodIsThatThanWhichNoGreaterCanBeConceived : Prop :=\n  A (\"God is that than which no greater can be conceived\" : Prop)\ndef GodExistsInReality : Prop :=\n  A (\"God exists in reality\" : Prop)\n\ndef ExistsInUnderstandingBridge : Prop :=\n  FoolUnderstandsTheWords ∧ WhateverIsUnderstoodExistsInTheUnderstanding →\n    ExistsInTheUnderstanding\n\ndef ExistsInRealityBridge : Prop :=\n  ExistsInTheUnderstanding ∧ CanBeConceivedToExistInReality ∧\n    GreaterIfInReality ∧ NothingGreaterConceivable →\n      ExistsInReality\n\ndef GodExistsBridge : Prop :=\n  GodIsThatThanWhichNoGreaterCanBeConceived ∧ ExistsInReality →\n    GodExistsInReality\n\ntheorem exists_in_the_understanding\n    (i : FoolUnderstandsTheWords)\n    (ii : WhateverIsUnderstoodExistsInTheUnderstanding)\n    (iii_bridge : ExistsInUnderstandingBridge)\n  : ExistsInTheUnderstanding :=\n  iii_bridge ⟨i, ii⟩\n\ntheorem exists_in_reality\n    (i : FoolUnderstandsTheWords)\n    (ii : WhateverIsUnderstoodExistsInTheUnderstanding)\n    (iii_bridge : ExistsInUnderstandingBridge)\n    (iv : CanBeConceivedToExistInReality)\n    (v : GreaterIfInReality)\n    (vi : NothingGreaterConceivable)\n    (vii_bridge : ExistsInRealityBridge)\n  : ExistsInReality :=\n  vii_bridge ⟨exists_in_the_understanding i ii iii_bridge, iv, v, vi⟩\n\n-- Anselm's identification: \"and this you are, O Lord our God\" (Proslogion II)\ntheorem god_exists_in_reality\n    (i : FoolUnderstandsTheWords)\n    (ii : WhateverIsUnderstoodExistsInTheUnderstanding)\n    (iii_bridge : ExistsInUnderstandingBridge)\n    (iv : CanBeConceivedToExistInReality)\n    (v : GreaterIfInReality)\n    (vi : NothingGreaterConceivable)\n    (vii_bridge : ExistsInRealityBridge)\n    (viii : GodIsThatThanWhichNoGreaterCanBeConceived)\n    (god_bridge : GodExistsBridge)\n  : GodExistsInReality :=\n  god_bridge ⟨viii, exists_in_reality i ii iii_bridge iv v vi vii_bridge⟩\n\nend m63bd0fm\n","members":[],"source_lines":{"end":37,"start":34},"theorem_statement":null},"referenced_by":[{"def_id":"sbw24gsz","display_kind":"theorem","file_id":"m63bd0fm","kind":"theorem","local_name":"exists_in_reality","qualified_name":"m63bd0fm.exists_in_reality"},{"def_id":"g1rn85et","display_kind":"theorem","file_id":"m63bd0fm","kind":"theorem","local_name":"god_exists_in_reality","qualified_name":"m63bd0fm.god_exists_in_reality"}]}
