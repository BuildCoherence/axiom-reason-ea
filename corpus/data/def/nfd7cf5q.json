r\n\nnamespace CommunicativeArithmeticGuard\n\ninductive Boundary\n  | internal\n  | persisted\n  | externalAction\n  | humanReview\n\ndef irreversible : Boundary → Prop\n  | .internal => False\n  | .persisted => True\n  | .externalAction => True\n  | .humanReview => True\n\ninductive Backend\n  | fp32\n  | exact\n\ndef selectedBackend : Boundary → Backend\n  | .internal => .fp32\n  | .persisted => .exact\n  | .externalAction => .exact\n  | .humanReview => .exact\n\ndef authorized (boundary : Boundary) (backend : Backend) : Prop :=\n  backend = selectedBackend boundary\n\ntheorem irreversible_boundary_requires_exact\n    (boundary : Boundary) (h : irreversible boundary) :\n    selectedBackend boundary = Backend.exact := by\n  cases boundary <;> simp [irreversible, selectedBackend] at h ⊢\n\ntheorem authorized_irreversible_output_is_exact\n    (boundary : Boundary) (backend : Backend)\n    (hIrreversible : irreversible boundary)\n    (hAuthorized : authorized boundary backend) :\n    backend = Backend.exact := by\n  rw [hAuthorized]\n  exact irreversible_boundary_requires_exact boundary hIrreversible\n\nend CommunicativeArithmeticGuard\n\nend j81b1gmr\n","members":[{"def_id":"hmv260g2","display_kind":"constructor","kind":"constructor","local_name":"CommunicativeArithmeticGuard.Boundary.internal","qualified_name":"j81b1gmr.CommunicativeArithmeticGuard.Boundary.internal"},{"def_id":"bm830cv9","display_kind":"constructor","kind":"constructor","local_name":"CommunicativeArithmeticGuard.Boundary.persisted","qualified_name":"j81b1gmr.CommunicativeArithmeticGuard.Boundary.persisted"},{"def_id":"tyg9nwbx","display_kind":"constructor","kind":"constructor","local_name":"CommunicativeArithmeticGuard.Boundary.externalAction","qualified_name":"j81b1gmr.CommunicativeArithmeticGuard.Boundary.externalAction"},{"def_id":"kw58wvnv","display_kind":"constructor","kind":"constructor","local_name":"CommunicativeArithmeticGuard.Boundary.humanReview","qualified_name":"j81b1gmr.Communicative