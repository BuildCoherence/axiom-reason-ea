ter-of Bob → FemalePerson Alice := by\n  intro h\n  have alice_is_daughter : Daughter.Is Alice := DaughterOf.inst0 h\n  exact dd ▸ alice_is_daughter\n\nend yvbc459t\n","members":[],"source_lines":{"end":28,"start":28},"theorem_statement":null},"referenced_by":[]}
