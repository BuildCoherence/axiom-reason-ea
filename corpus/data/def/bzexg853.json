":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"b","token_id":"c065ehm2.MoralComparisonIsCoherent::src::29","token_role":null},{"binder_role":null,"byte_end":3368,"byte_start":3365,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"→","token_id":"c065ehm2.MoralComparisonIsCoherent::src::30","token_role":null},{"binder_role":"use_site","byte_end":3370,"byte_start":3369,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"b","token_id":"c065ehm2.MoralComparisonIsCoherent::src::31","token_role":null},{"binder_role":"use_site","byte_end":3386,"byte_start":3371,"def_id":"m9wpn7f7","hover_kind":"term","inlined_type_summary":null,"kind":"notation","qualified_name":"c065ehm2.MoreMoralThan","text":"more-moral-than","token_id":"c065ehm2.MoralComparisonIsCoherent::src::32","token_role":null},{"binder_role":"use_site","byte_end":3388,"byte_start":3387,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"c","token_id":"c065ehm2.MoralComparisonIsCoherent::src::33","token_role":null},{"binder_role":null,"byte_end":3392,"byte_start":3389,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":"→","token_id":"c065ehm2.MoralComparisonIsCoherent::src::34","token_role":null},{"binder_role":"use_site","byte_end":3394,"byte_start":3393,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"a","token_id":"c065ehm2.MoralComparisonIsCoherent::src::35","token_role":null},{"binder_role":"use_site","byte_end":3410,"byte_start":3395,"def_id":"m9wpn7f7","hover_kind":"term","inlined_type_summary":null,"kind":"notation","qualified_name":"c065ehm2.MoreMoralThan","text":"more-moral-than","token_id":"c065ehm2.MoralComparisonIsCoherent::src::36","token_role":null},{"binder_role":"use_site","byte_end":3412,"byte_start":3411,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"c","token_id":"c065ehm2.MoralComparisonIsCoherent::src::37","token_role":null}],"type_tokens":{"author":null,"empty":{"child":{"node":"text","text":"Prop"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Prop","token_id":"c065ehm2.MoralComparisonIsCoherent::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.ta3nj1a4\nimport A.r59jf3ak\nimport A.nrhqjxz5\n\nopen nrhqjxz5\n\nopen t0d1zdc3\nopen ta3nj1a4\nopen r59jf3ak\n\nnamespace c065ehm2\n\nrigid universal MoralCharacter extends Quality := \"moral character\"\n\nrelation Immoral : Person := \"is immoral\"\nrelation HasMoralCharacter : Person → MoralCharacter := \"has moral character\"\nrelation MoreMoralThan : MoralCharacter → MoralCharacter := \"is more moral than\"\nrelation Rich : Person \"is rich\"\n\nscoped postfix:max \" is-immoral\" => Immoral\nscoped infix:50 \" has-moral-character \" => HasMoralCharacter\nscoped infix:50 \" more-moral-than \" => MoreMoralThan\nscoped postfix:max \" is-rich\" => Rich\n\ndef EveryRichPersonIsImmoral : Prop :=\n  ∀ p : Person, p is-rich → p is-immoral\n\ndef NotEveryRichPersonIsImmoral : Prop :=\n  ¬ EveryRichPersonIsImmoral\n\ndef SomeRichPersonIsNotImmoral : Prop :=\n  ∃ p : Person, p is-rich ∧ ¬ (p is-immoral)\n\ndef EveryRichPersonIsNotImmoral : Prop :=\n  ∀ p : Person, p is-rich → ¬ (p is-immoral)\n\ntheorem some_refutes_every\n    (h : SomeRichPersonIsNotImmoral)\n  : NotEveryRichPersonIsImmoral :=\n  fun every => h.elim fun p hp => hp.2 (every p hp.1)\n\ntheorem not_every_means_some\n    (h : NotEveryRichPersonIsImmoral) : SomeRichPersonIsNotImmoral :=\n  Classical.byContradiction fun no_counterexample =>\n    h fun p rich =>\n      Classical.byContradiction fun not_immoral =>\n        no_counterexample ⟨p, rich, not_immoral⟩\n\ndef DollyParton : Type := \"Dolly Parton\"\n\ndef DollyPartonIsRichAndNotImmoral : Prop :=\n  DollyParton is-rich ∧ ¬ (DollyParton is-immoral)\n\ntheorem dolly_parton_refutes\n    (h : DollyPartonIsRichAndNotImmoral)\n  : SomeRichPersonIsNotImmoral :=\n  ⟨⟨DollyParton, Rich.inst0 h.1⟩, h.1, h.2⟩\n\ndef JeffreyEpstein : Type := \"Jeffrey Epstein\"\n\ndef JeffreyEpsteinIsRichAndImmoral : Prop :=\n  JeffreyEpstein is-rich ∧ JeffreyEpstein is-immoral\n\ndef EveryPersonIsImmoral : Prop :=\n  ∀ p : Person, p is-immoral\n\ndef OnlyRichPeopleAreImmoral : Prop :=\n  ∀ p : Person, p is-immoral → p is-rich\n\ntheorem everyone_immoral_confirms_the_claim\n    (everyone : EveryPersonIsImmoral) : EveryRichPersonIsImmoral :=\n  fun p _ => everyone p\n\ntheorem everyone_immoral_rejects_only_rich\n    (everyone : EveryPersonIsImmoral)\n    (someone_not_rich : ∃ p : Person, ¬ (p is-rich)) :\n    ¬ OnlyRichPeopleAreImmoral :=\n  fun only_rich => someone_not_rich.elim fun p not_rich =>\n    not_rich (only_rich p (everyone p))\n\ntheorem disagreement_is_contradiction\n    (logic_is_actual : LogicIsActual)\n    (every : A EveryRichPersonIsImmoral)\n    (some_not : A SomeRichPersonIsNotImmoral) : False :=\n  logic_is_actual.consistency\n    (logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _ some_refutes_every)\n        some_not)\n      every)\n\nrelation SameCircumstancesExceptWealth : Person → Person :=\n  \"has the same morally relevant circumstances except wealth as\"\n\nscoped infix:50 \" same-circumstances-except-wealth \" => SameCircumstancesExceptWealth\nabbrev LessMoralThan (a b : Type) : Prop := MoreMoralThan b a\nscoped infix:50 \" less-moral-than \" => LessMoralThan\n\nstructure MoralComparisonIsCoherent : Prop where\n  more_moral_irreflexive : ∀ m : MoralCharacter, ¬ (m more-moral-than m)\n  more_moral_transitive :\n    ∀ a b c : MoralCharacter,\n      a more-moral-than b → b more-moral-than c → a more-moral-than c\n\ndef ImmoralBelowNonImmoral : Prop :=\n  ∀ (p q : Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\n\nstructure TwoPeopleDifferingInWealth where\n  p1 : Person\n  p2 : Person\n  p1Character : MoralCharacter\n  p2Character : MoralCharacter\n  p1_is_rich : p1 is-rich\n  p2_is_not : ¬ (p2 is-rich)\n  p1_has_character : p1 has-moral-character p1Character\n  p2_has_character : p2 has-moral-character p2Character\n  all_else_equal : p1 same-circumstances-except-wealth p2\n\ndef AllElseEqualTheRichPersonIsLessMoral : Prop :=\n  ∀ s : TwoPeopleDifferingInWealth, s.p1Character less-moral-than s.p2Character\n\ntheorem immoral_non_rich_twin_makes_rich_twin_immoral\n    (coherent : MoralComparisonIsCoherent)\n    (immoral_below : ImmoralBelowNonImmoral)\n    (rich_less_moral : AllElseEqualTheRichPersonIsLessMoral)\n    (s : TwoPeopleDifferingInWealth)\n    (immoral : s.p2 is-immoral) :\n    s.p1 is-immoral :=\n  Classical.byContradiction fun not_immoral =>\n    more_moral_asymmetric coherent s.p2Character s.p1Character\n      (rich_less_moral s)\n      (immoral_below s.p2 s.p1 s.p2Character s.p1Character\n        s.p2_has_character s.p1_has_character\n        immoral not_immoral)\n\nend c065ehm2\n","members":[{"def_id":"r6h9z4jb","display_kind":"constructor","kind":"constructor","local_name":"MoralComparisonIsCoherent.mk","qualified_name":"c065ehm2.MoralComparisonIsCoherent.mk"},{"conclusion_prop":"gxpa3mmw","def_id":"axbfpm7q","display_kind":"field","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_irreflexive","qualified_name":"c065ehm2.MoralComparisonIsCoherent.more_moral_irreflexive"},{"conclusion_prop":"xjc946v6","def_id":"t58g124s","display_kind":"field","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_transitive","qualified_name":"c065ehm2.MoralComparisonIsCoherent.more_moral_transitive"}],"source_lines":{"end":106,"start":102},"theorem_statement":null},"referenced_by":[{"def_id":"kb5gnpkb","display_kind":"theorem","file_id":"c065ehm2","kind":"theorem","local_name":"immoral_non_rich_twin_makes_rich_twin_immoral","qualified_name":"c065ehm2.immoral_non_rich_twin_makes_rich_twin_immoral"},{"def_id":"axbfpm7q","display_kind":"field","file_id":"c065ehm2","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_irreflexive","qualified_name":"c065ehm2.MoralComparisonIsCoherent.more_moral_irreflexive"},{"def_id":"t58g124s","display_kind":"field","file_id":"c065ehm2","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_transitive","qualified_name":"c065ehm2.MoralComparisonIsCoherent.more_moral_transitive"},{"def_id":"q34yr8td","display_kind":"theorem","file_id":"c065ehm2","kind":"theorem","local_name":"more_moral_asymmetric","qualified_name":"c065ehm2.more_moral_asymmetric"}]}
