hoice_is_greater_potential), (\"god_is_good\", god_is_good), (\"i_am_a_person\", i_am_a_person), (\"metabias_is_a_person\", metabias_is_a_person), (\"everyone_makes_mistakes\", everyone_makes_mistakes), (\"all_people_are_immoral\", all_people_are_immoral)]\n\naxiom user_axioms_auth : Axiom.AuthenticatedTerm (\"sam\", userAxiomsList, 1785015567)\n\ndef userAxioms : Axiom.UserAxioms \"sam\" 1785015567 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend jn8vb7yj\n","members":[],"source_lines":{"end":38,"start":37},"theorem_statement":null},"referenced_by":[{"def_id":"q2e71ntj","display_kind":"definition","file_id":"jn8vb7yj","kind":"definition","local_name":"userAxioms","qualified_name":"jn8vb7yj.userAxioms"},{"def_id":"fky9gr2c","display_kind":"axiom","file_id":"jn8vb7yj","kind":"axiom","local_name":"user_axioms_auth","qualified_name":"jn8vb7yj.user_axioms_auth"}]}
