,"hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"yez44xpf.SpeechAndLegitimacy.Organization.U","subexpr_pos":"/1/1/1/0/0/0/0/1","text":"yez44xpf.SpeechAndLegitimacy.Organization.U","token_id":"yez44xpf.SpeechAndLegitimacy.Organization.At.toParent::empty/value::7","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"yez44xpf.SpeechAndLegitimacy.GroupOfAgents.At x t","kind":"stdlib","qualified_name":"c424c6bg.UniversalAtUnder.parent","subexpr_pos":"/1/1/1","text":"c424c6bg.UniversalAtUnder.parent yez44xpf.SpeechAndLegitimacy.Organization.U","token_id":"yez44xpf.SpeechAndLegitimacy.Organization.At.toParent::empty/value::6","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"∀ (x t : Type) [yez44xpf.SpeechAndLegitimacy.Organization.At x t], yez44xpf.SpeechAndLegitimacy.GroupOfAgents.At x t","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun x t [yez44xpf.SpeechAndLegitimacy.Organization.At x t] =>\n  c424c6bg.UniversalAtUnder.parent yez44xpf.SpeechAndLegitimacy.Organization.U","token_id":"yez44xpf.SpeechAndLegitimacy.Organization.At.toParent::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.j12bzjgj\n\nopen t0d1zdc3\nopen gwcwyrvb\nopen j12bzjgj\nopen c424c6bg\n\nopen BFO\n\nnamespace yez44xpf\n\nnamespace SpeechAndLegitimacy\n\nrigid universal GroupOfAgents extends ObjectAggregate := \"group of agents\"\nrigid universal Organization extends GroupOfAgents := \"organization\"\nrigid universal Government extends Organization := \"government\"\nrigid universal FormOfSpeech extends GenericallyDependentContinuant := \"form of speech\"\n\nrelation Legitimate : Government := \"is legitimate\"\nrelation GovernedConsent : Government := \"the governed meaningfully consent to\"\nrelation CanSpeakOfConduct : Government := \"citizens can freely speak about the conduct of\"\nrelation Bans : Government → FormOfSpeech := \"bans\"\nrelation CanFreelyExpress : Government → FormOfSpeech := \"citizens can freely express\"\n\ndef ConsentRequiredForLegitimacy : Prop := ∀ g, Legitimate g → GovernedConsent g\ndef SpeechRequiredForConsent : Prop := ∀ g, GovernedConsent g → CanSpeakOfConduct g\ndef LegitimacyRequiresSpeech : Prop := ∀ g, Legitimate g → CanSpeakOfConduct g\n\ndef ScrutinizingBansRequiresAccess : Prop :=\n  ∀ g x, Bans g x → CanSpeakOfConduct g → CanFreelyExpress g x\ndef BanningPrecludesExpression : Prop :=\n  ∀ g x, Bans g x → ¬ CanFreelyExpress g x\ndef LegitimacyForbidsSpeechBans : Prop :=\n  ∀ g, Legitimate g → ∀ x, ¬ Bans g x\n\ntheorem legitimacy_requires_speech\n    (logic_is_actual : LogicIsActual)\n    (consent_req : A ConsentRequiredForLegitimacy)\n    (speech_req : A SpeechRequiredForConsent) :\n    A LegitimacyRequiresSpeech := by\n  have taut :\n      ConsentRequiredForLegitimacy → SpeechRequiredForConsent → LegitimacyRequiresSpeech := by\n    intro h1 h2 g hleg\n    exact h2 g (h1 g hleg)\n  have s1 := logic_is_actual.mp _ _ (logic_is_actual.actual_intro _ taut) consent_req\n  exact logic_is_actual.mp _ _ s1 speech_req\n\ntheorem legitimacy_forbids_speech_bans\n    (logic_is_actual : LogicIsActual)\n    (consent_req : A ConsentRequiredForLegitimacy)\n    (speech_req : A SpeechRequiredForConsent)\n    (scrutiny_req : A ScrutinizingBansRequiresAccess)\n    (ban_precludes : A BanningPrecludesExpression) :\n    A LegitimacyForbidsSpeechBans := by\n  have taut :\n      ConsentRequiredForLegitimacy → SpeechRequiredForConsent →\n        ScrutinizingBansRequiresAccess → BanningPrecludesExpression →\n          LegitimacyForbidsSpeechBans := by\n    intro h1 h2 h3 h4 g hleg x hban\n    exact h4 g x hban (h3 g x hban (h2 g (h1 g hleg)))\n  have s1 := logic_is_actual.mp _ _ (logic_is_actual.actual_intro _ taut) consent_req\n  have s2 := logic_is_actual.mp _ _ s1 speech_req\n  have s3 := logic_is_actual.mp _ _ s2 scrutiny_req\n  exact logic_is_actual.mp _ _ s3 ban_precludes\n\nend SpeechAndLegitimacy\n\nend yez44xpf\n","members":[],"source_lines":{"end":18,"start":18},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"hbx7rq4m","tokens":{"author":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"x "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"x ","token_id":"yez44xpf.SpeechAndLegitimacy.Organization.At.toParent::author/conclusion::1","token_role":null}},{"child":{"node":"text","text":"t"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"t","token_id":"yez44xpf.SpeechAndLegitimacy.Organization.At.toParent::author/conclusion::2","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/1/0","text":"Type","token_id":"yez44xpf.SpeechAndLegitimacy.Organization.At.toParent::author/conclusion::3","token_role":null}},{"node":"text","text":") ["},{"child":{"children":[{"node":"text","text":"At "},{"child":{"node":"text","text":"x"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/0/0/1","text":"x","token_id":"yez44xpf.SpeechAndLegitimacy.Organization.At.toParent::author/conclusion::5","token_role":null}},{"node":"text","text":" "},{"child":{"node":"text","text":"t"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","quali