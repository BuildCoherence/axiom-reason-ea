ined_type_summary":"Prop","kind":"type","qualified_name":"kqjyfmgp.MistreatingAnimalsCorruptsMoralCharacter","subexpr_pos":"/0/1","text":"kqjyfmgp.MistreatingAnimalsCorruptsMoralCharacter","token_id":"kqjyfmgp.NoMistreatBridge::empty/value::3","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"And","subexpr_pos":"/0","text":"kqjyfmgp.DutyToPerfectMoralCharacter ∧ kqjyfmgp.MistreatingAnimalsCorruptsMoralCharacter","token_id":"kqjyfmgp.NoMistreatBridge::empty/value::1","token_role":null}},{"node":"text","text":" →\n  "},{"child":{"node":"text","text":"kqjyfmgp.MustNotMistreatAnimals"},"node":"tag","tag":{"binder_role":"use_site","def_id":"phn4fntm","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"kqjyfmgp.MustNotMistreatAnimals","subexpr_pos":"/1","text":"kqjyfmgp.MustNotMistreatAnimals","token_id":"kqjyfmgp.NoMistreatBridge::empty/value::4","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"kqjyfmgp.DutyToPerfectMoralCharacter ∧ kqjyfmgp.MistreatingAnimalsCorruptsMoralCharacter →\n  kqjyfmgp.MustNotMistreatAnimals","token_id":"kqjyfmgp.NoMistreatBridge::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\n\nopen t0d1zdc3\nopen gwcwyrvb\n\nnamespace kqjyfmgp\n\n-- https://reddit.com/r/askphilosophy/comments/g2002v/\n\ndef DutyToPerfectMoralCharacter : Prop :=\n  \"we have a duty to perfect our moral character\"\ndef MistreatingAnimalsCorruptsMoralCharacter : Prop :=\n  \"when we mistreat animals, we corrupt our moral character\"\ndef CommercialExploitationIsMistreatment : Prop :=\n  \"exploiting animals for commercial gain is mistreating them\"\ndef EatingMeatCommerciallyExploitsAnimals : Prop :=\n  \"eating meat exploits animals for commercial gain\"\ndef MustNotMistreatAnimals : Prop :=\n  \"we mustn't mistreat animals\"\ndef MustNotEatMeat : Prop :=\n  \"we mustn't eat meat\"\n\ndef NoMistreatBridge : Prop :=\n  DutyToPerfectMoralCharacter ∧ MistreatingAnimalsCorruptsMoralCharacter →\n    MustNotMistreatAnimals\n\ndef NoEatMeatBridge : Prop :=\n  MustNotMistreatAnimals ∧ CommercialExploitationIsMistreatment ∧\n    EatingMeatCommerciallyExploitsAnimals →\n      MustNotEatMeat\n\ntheorem actual_and (h : LogicIsActual) {p q : Prop} (hp : A p) (hq : A q) :\n    A (p ∧ q) :=\n  h.mp _ _ (h.mp _ _ (h.actual_intro _ (@And.intro p q)) hp) hq\n\ntheorem no_mistreat\n    (logic_is_actual : LogicIsActual)\n    (duty_to_perfect : A DutyToPerfectMoralCharacter)\n    (mistreating_corrupts : A MistreatingAnimalsCorruptsMoralCharacter)\n    (no_mistreat_bridge : A NoMistreatBridge)\n  : A MustNotMistreatAnimals :=\n  logic_is_actual.mp _ _ no_mistreat_bridge\n    (actual_and logic_is_actual duty_to_perfect mistreating_corrupts)\n\ntheorem no_eat_meat\n    (logic_is_actual : LogicIsActual)\n    (duty_to_perfect : A DutyToPerfectMoralCharacter)\n    (mistreating_corrupts : A MistreatingAnimalsCorruptsMoralCharacter)\n    (no_mistreat_bridge : A NoMistreatBridge)\n    (exploitation_is_mistreatment : A CommercialExploitationIsMistreatment)\n    (eating_meat_exploits : A EatingMeatCommerciallyExploitsAnimals)\n    (no_eat_meat_bridge : A NoEatMeatBridge)\n  : A MustNotEatMeat :=\n  logic_is_actual.mp _ _ no_eat_meat_bridge\n    (actual_and logic_is_actual\n      (no_mistreat logic_is_actual duty_to_perfect mistreating_corrupts\n        no_mistreat_bridge)\n      (actual_and logic_is_actual exploitation_is_mistreatment\n        eating_meat_exploits))\n\nend kqjyfmgp\n","members":[],"source_lines":{"end":27,"start":25},"theorem_statement":null},"referenced_by":[{"def_id":"af4mw8tz","display_kind":"theorem","file_id":"kqjyfmgp","kind":"theorem","local_name":"no_eat_meat","qualified_name":"kqjyfmgp.no_eat_meat"},{"def_id":"n4bcmtjq","display_kind":"theorem","file_id":"kqjyfmgp","kind":"theorem","local_name":"no_mistreat","qualified_name":"kqjyfmgp.no_mistreat"}]}
