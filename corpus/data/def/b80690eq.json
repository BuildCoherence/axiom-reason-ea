nlined_type_summary":"Prop","kind":"stdlib","qualified_name":"And","subexpr_pos":"/1/1","text":"fs83ayjj.Person.Is arg0 ∧ fs83ayjj.MoralCharacter.Is arg1 ∧ Axiom.getSemantics \"has moral character\" arg0 arg1","token_id":"fs83ayjj.HasMoralCharacter::empty/value::3","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type → Type → Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun arg0 arg1 =>\n  fs83ayjj.Person.Is arg0 ∧ fs83ayjj.MoralCharacter.Is arg1 ∧ Axiom.getSemantics \"has moral character\" arg0 arg1","token_id":"fs83ayjj.HasMoralCharacter::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.ta3nj1a4\nimport A.r59jf3ak\n\nopen ta3nj1a4\nopen r59jf3ak\n\nnamespace fs83ayjj\n\n\nrigid universal Person extends Object := \"person\"\nrigid universal MoralCharacter extends Quality := \"moral character\"\n\nrelation Immoral : Person := \"is immoral\"\nrelation HasMoralCharacter : Person → MoralCharacter := \"has moral character\"\nrelation MoreMoralThan : MoralCharacter → MoralCharacter := \"is more moral than\"\n\nscoped postfix:max \" is-immoral\" => Immoral\nscoped infix:50 \" has-moral-character \" => HasMoralCharacter\nscoped infix:50 \" more-moral-than \" => MoreMoralThan\n\nabbrev LessMoralThan (a b : Type) : Prop := MoreMoralThan b a\n\nscoped infix:50 \" less-moral-than \" => LessMoralThan\n\nstructure MoralComparisonIsCoherent : Prop where\n  more_moral_irreflexive : ∀ m : MoralCharacter, ¬ (m more-moral-than m)\n  more_moral_transitive :\n    ∀ a b c : MoralCharacter,\n      a more-moral-than b → b more-moral-than c → a more-moral-than c\n\ndef ImmoralBelowNonImmoral : Prop :=\n  ∀ (p q : Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend fs83ayjj\n","members":[],"source_lines":{"end":15,"start":15},"theorem_statement":null},"referenced_by":[{"def_id":"cvr64nvv","display_kind":"definition","file_id":"fs83ayjj","kind":"definition","local_name":"ImmoralBelowNonImmoral","qualified_name":"fs83ayjj.ImmoralBelowNonImmoral"},{"def_id":"dw1mzmbk","display_kind":"field","file_id":"fs83ayjj","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.at_most_one","qualified_name":"fs83ayjj.PersonsHaveExactlyOneMoralCharacter.at_most_one"},{"def_id":"kkt9wbt0","display_kind":"definition","file_id":"fs83ayjj","kind":"definition","local_name":"PersonsHaveExactlyOneMoralCharacter.casesOn","qualified_name":"fs83ayjj.PersonsHaveExactlyOneMoralCharacter.casesOn"},{"def_id":"kef91g7a","display_kind":"field","file_id":"fs83ayjj","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.has_one","qualified_name":"fs83ayjj.PersonsHaveExactlyOneMoralCharacter.has_one"},{"def_id":"yv130tpw","display_kind":"constructor","file_id":"fs83ayjj","kind":"constructor","local_name":"PersonsHaveExactlyOneMoralCharacter.mk","qualified_name":"fs83ayjj.PersonsHaveExactlyOneMoralCharacter.mk"},{"def_id":"fssgyyce","display_kind":"definition","file_id":"mhhv9dpt","kind":"definition","local_name":"TwoPeopleDifferingInWealth.casesOn","qualified_name":"mhhv9dpt.TwoPeopleDifferingInWealth.casesOn"},{"def_id":"sbp94yew","display_kind":"constructor","file_id":"mhhv9dpt","kind":"constructor","local_name":"TwoPeopleDifferingInWealth.mk","qualified_name":"mhhv9dpt.TwoPeopl