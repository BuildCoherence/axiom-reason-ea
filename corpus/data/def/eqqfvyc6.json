omGain releasedBurden capabilityLoss := by\n  exact Nat.sub_pos_of_lt h\n\ndef headroom_theorem_boundaryPayload := \"These theorems establish only arithmetic consequences of a natural-number headroom model. They do not prove that a real system's capacities are commensurable, that burden is fully observed, or that effective reachable futures are determined by one scalar.\"\naxiom headroom_theorem_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", headroom_theorem_boundaryPayload, 1789059159)\ndef headroom_theorem_boundary : Axiom.Statement \"hitchhiker2thefuture\" headroom_theorem_boundaryPayload 1789059159 := ⟨headroom_theorem_boundary_auth⟩\n\nend hmhhcnw7\n","members":[],"source_lines":{"end":14,"start":12},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"eht5zxve","tokens":{"author":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"s"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"s","token_id":"hmhhcnw7.headroom_nonnegative::author/conclusion::1","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"HeadroomState"},"node":"tag","tag":{"binder_role":"use_site","def_id":"wxaejm1c","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"hmhhcnw7.HeadroomState","subexpr_pos":"/0","text":"HeadroomState","token_id":"hmhhcnw7.headroom_nonnegative::author/conclusion::2","token_role":null}},{"node":"text","text":"), "},{"child":{"children":[{"child":{"node":"text","text":"0"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Nat","kind":"stdlib","qualified_name":"OfNat.ofNat","subexpr_pos":"/1/0/1","text":"0","token_id":"hmhhcnw7.headroom_nonnegative::author/conclusion::4","token_role":"num_lit"}},{"node":"text","text":" ≤ "},{"child":{"children":[{"no