, bfo), (\"clearer_thought_improves_decision_making\", clearer_thought_improves_decision_making), (\"better_decision_making_enables_effective_choice\", better_decision_making_enables_effective_choice), (\"effective_choice_is_greater_potential\", effective_choice_is_greater_potential), (\"god_is_good\", god_is_good)]\n\naxiom user_axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1783135738)\n\ndef userAxioms : UserAxioms \"sam\" 1783135738 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend warhrjns\n","members":[],"source_lines":{"end":29,"start":29},"theorem_statement":null},"referenced_by":[{"def_id":"dmx4zfz0","display_kind":"definition","file_id":"warhrjns","kind":"definition","local_name":"userAxioms","qualified_name":"warhrjns.userAxioms"}]}
