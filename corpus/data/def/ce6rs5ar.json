oice_is_greater_potential\", effective_choice_is_greater_potential), (\"god_is_good\", god_is_good), (\"all_people_are_immoral\", all_people_are_immoral)]\n\naxiom user_axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1783355032)\n\ndef userAxioms : UserAxioms \"sam\" 1783355032 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend p93wrb98\n","members":[],"source_lines":{"end":26,"start":26},"theorem_statement":null},"referenced_by":[{"def_id":"zkgcej3q","display_kind":"definition","file_id":"p93wrb98","kind":"definition","local_name":"userAxiomsList","qualified_name":"p93wrb98.userAxiomsList"}]}
