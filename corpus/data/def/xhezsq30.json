 of the USA in 2026\"\n\nnamespace HypotheticalWorldExample\n\ndef NazisWon : Prop := \"Nazis won WWII\"\n\nrelation OccurredBefore1939 : Prop := \"occurred before 1939\"\n\ndef GermanOfficialLanguageUSA2026 : Prop :=\n  \"German is the official language of the USA in 2026\"\n\nstructure NazisWonWWIIWorld extends ModalWorld where\n  holds_eq : holds = (\"world where Nazis won WWII\" : Prop → Prop)\n  nazis_won : holds NazisWon\n  -- This world is a \"fork\" of the actual world.\n  -- This Prop asserts it's the exact same as the actual world up until 1939.\n  pre1939 : ∀ p, A p → A (OccurredBefore1939 p) → holds p\n\n-- The more formal version of the example claim.\ndef NazisWonUSASpeakGerman :=\n  ∀ w : NazisWonWWIIWorld, w.holds GermanOfficialLanguageUSA2026\n\nend HypotheticalWorldExample\n\n-- Optionally, one could assert that the semantic string is definitionally equal to the more formal version.\ndef NazisWonUSASpeakGermanDef : Prop :=\n  NazisWonUSASpeakGerman = HypotheticalWorldExample.NazisWonUSASpeakGerman\n\nend stx8bhgr\n","members":[{"def_id":"amde91a1","display_kind":"constructor","kind":"constructor","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.mk","qualified_name":"stx8bhgr.HypotheticalWorldExample.NazisWonWWIIWorld.mk"},{"def_id":"g3kf84wc","display_kind":"field","kind":"definition","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.toModalWorld","qualified_name":"stx8bhgr.HypotheticalWorldExample.NazisWonWWIIWorld.toModalWorld"},{"conclusion_prop":"eq1rt3qf","def_id":"gtf3m3bv","display_kind":"field","kind":"theorem","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.holds_eq","qualified_name":"stx8bhgr.HypotheticalWorldExample.NazisWonWWIIWorld.holds_eq"},{"conclusion_prop":"pexgj2r2","def_id":"h95xn324","display_kind":"field","kind":"theorem","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.nazis_won","qualified_name":"stx8bhgr.HypotheticalWorldExample.NazisWonWWIIWorld.nazis_won"},{"conclusion_prop":"a6e68df8","def