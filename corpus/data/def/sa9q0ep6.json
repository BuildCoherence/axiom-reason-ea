","inlined_type_summary":"Type → Prop","kind":"type","qualified_name":"mwh5b5da.RigidlyIsUnder","subexpr_pos":"/","text":"mwh5b5da.RigidlyIsUnder fs83ayjj.MoralCharacter.At ta3nj1a4.Quality.Is","token_id":"fs83ayjj.MoralCharacter.Is::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.ta3nj1a4\nimport A.r59jf3ak\n\nopen ta3nj1a4\nopen r59jf3ak\n\nnamespace fs83ayjj\n\n\nrigid universal Person extends Object := \"person\"\nrigid universal MoralCharacter extends Quality := \"moral character\"\n\nrelation Immoral : Person := \"is immoral\"\nrelation HasMoralCharacter : Person → MoralCharacter := \"has moral character\"\nrelation MoreMoralThan : MoralCharacter → MoralCharacter := \"is more moral than\"\n\nscoped postfix:max \" is-immoral\" => Immoral\nscoped infix:50 \" has-moral-character \" => HasMoralCharacter\nscoped infix:50 \" more-moral-than \" => MoreMoralThan\n\nabbrev LessMoralThan (a b : Type) : Prop := MoreMoralThan b a\n\nscoped infix:50 \" less-moral-than \" => LessMoralThan\n\nstructure MoralComparisonIsCoherent : Prop where\n  more_moral_irreflexive : ∀ m : MoralCharacter, ¬ (m more-moral-than m)\n  more_moral_transitive :\n    ∀ a b c : MoralCharacter,\n      a more-moral-than b → b more-moral-than c → a more-moral-than c\n\ndef ImmoralBelowNonImmoral : Prop :=\n  ∀ (p q : Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend fs83ayjj\n","members":[],"source_lines":{"end":12,"start":12},"theorem_statement":null},"referenced_by":[{"def_id":"b80690eq","display_kind":"definition","file_id":"fs83ayjj","kind":"definition","local_name":"HasMoralCharacter","qualified_name":"fs83ayjj.HasMoralCharacter"},{"def_id":"cvr64nvv","display_kind":"definition","file_id":"fs83ayjj","kind":"definition","local_name":"ImmoralBelowNonImmoral","qualified_name":"fs83ayjj.ImmoralBelowNonImmoral"},{"def_id":"j9n1k4am","display_kind":"definition","file_id":"fs83ayjj","kind":"definition","local_name":"MoralCharacter","qualified_name":"fs83ayjj.MoralCharacter"},{"def_id":"twf6r0hq","display_kind":"definition","file_id":"fs83ayjj","kind":"definition","local_name":"MoralComparisonIsCoherent.casesOn","qualified_name":"fs83ayjj.MoralComparisonIsCoherent.casesOn"},{"def_id":"zkkqvvcg","display_kind":"constructor","file_id":"fs83ayjj","kind":"constructor","local_name":"MoralComparisonIsCoherent.mk","qualified_name":"fs83ayjj.MoralComparisonIsCoherent.mk"},{"def_id":"bxwqkjj7","display_kind":"field","file_id":"fs83ayjj","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_irreflexive","qualified_name":"fs83ayjj.MoralComparisonIsCoherent.more_moral_irreflexive"},{"def_id":"g24vtrsn","display_kind":"field","file_id":"fs83ayjj","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_transitive","qualified_name":"fs83ayjj.MoralComparisonIsCoherent.more_moral_transitive"},{"def_id":"z70vtk98","display_kind":"theorem","file_id":"fs83ayjj","kind":"theorem","local_name":"more_moral_asymmetric","qualified_name":"fs83ayjj.more_moral_asymmetric"},{"def_id":"qzf5thb3","display_kind":"definition","file_id":"fs83ayjj","kind":"definition","local_name":"MoreMoralThan","qualified_name":"fs83ayjj.MoreMoralThan"},{"def_id":"dw1mzmbk","display_kind":"field","file_id":"fs83ayjj","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.at_most_one","qualified_name":"fs