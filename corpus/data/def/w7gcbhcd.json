xt":":","token_id":"zt3v281b.NetworkRelativityChannel::src::13","token_role":null},{"binder_role":"use_site","byte_end":169,"byte_start":165,"def_id":null,"hover_kind":"term","inlined_type_summary":"Type → Type","kind":"stdlib","qualified_name":"List","text":"List","token_id":"zt3v281b.NetworkRelativityChannel::src::14","token_role":null},{"binder_role":"use_site","byte_end":176,"byte_start":170,"def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"stdlib","qualified_name":"String","text":"String","token_id":"zt3v281b.NetworkRelativityChannel::src::15","token_role":null},{"binder_role":"def_site","byte_end":191,"byte_start":179,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"stdlib","qualified_name":"zt3v281b.NetworkRelativityChannel.recoveryTask","text":"recoveryTask","token_id":"zt3v281b.NetworkRelativityChannel::src::16","token_role":null},{"binder_role":null,"byte_end":193,"byte_start":192,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"zt3v281b.NetworkRelativityChannel::src::17","token_role":null},{"binder_role":"use_site","byte_end":200,"byte_start":194,"def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"stdlib","qualified_name":"String","text":"String","token_id":"zt3v281b.NetworkRelativityChannel::src::18","token_role":null}],"type_tokens":{"author":{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Type","token_id":"zt3v281b.NetworkRelativityChannel::author/type::0","token_role":null}},"empty":{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Type","token_id":"zt3v281b.NetworkRelativityChannel::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\n\nnamespace zt3v281b\n\nstructure NetworkRelativityChannel where\n  latentState : String\n  mixingProcess : String\n  observedField : String\n  noiseSources : List String\n  recoveryTask : String\n\n\ndef NetworkRelativityAnalogy (c : NetworkRelativityChannel) : Prop :=\n  c.latentState ≠ \"\" ∧\n    c.mixingProcess ≠ \"\" ∧\n    c.observedField ≠ \"\" ∧\n    c.recoveryTask ≠ \"\"\n\n\ndef ComputationalStatisticalGap (statisticalRecovery computationalRecovery : Prop) : Prop :=\n  statisticalRecovery ∧ ¬ computationalRecovery\n\n\ndef network_relativity_mimo_bridgePayload :=\n  \"Network Relativity studies a recovery problem: a latent state is mixed by a network, observed through noise, and decoded relative to the receiver's frame. The MIMO detection problem is a precise mathematical analogue of this structure: transmitted bits are mixed by a channel and recovered from a noisy observation. The analogy is structural, not a claim that social networks are Gaussian channels.\"\naxiom network_relativity_mimo_bridge_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_mimo_bridgePayload, 1786316106)\ndef network_relativity_mimo_bridge : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_mimo_bridgePayload 1786316106 := ⟨network_relativity_mimo_bridge_auth⟩\n\ndef network_relativity_computational_gapPayload :=\n  \"A dormant observation may be statistically relevant to a current network state while remaining computationally unreachable by a bounded retrieval procedure. This is the Network Relativity analogue of a computational-statistical gap: an optimal decoder may recover a signal before a practical decoder can.\"\naxiom network_relativity_computational_gap_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_computational_gapPayload, 1786316106)\ndef network_relativity_computational_gap : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_computational_gapPayload 1786316106 := ⟨network_relativity_computational_gap_auth⟩\n\ndef network_relativity_lmmse_greedy_patternPayload :=\n  \"The signed-LMMSE-then-greedy-correction pattern suggests a Network Relativity decoder: first estimate a coarse current field and its competing interpretations, then apply bounded local corrections that reduce explanatory residual without requiring immediate agreement. This is a design hypothesis, not an imported theorem.\"\naxiom network_relativity_lmmse_greedy_pattern_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_lmmse_greedy_patternPayload, 1786316106)\ndef network_relativity_lmmse_greedy_pattern : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_lmmse_greedy_patternPayload 1786316106 := ⟨network_relativity_lmmse_greedy_pattern_auth⟩\n\ndef network_relativity_threshold_boundaryPayload :=\n  \"A recovery threshold in a random Gaussian channel must not be presented as a threshold law for human networks. The transferable hypothesis is narrower: bounded recovery may exhibit an activation frontier where an observation becomes legible, non-redundant, and computationally recoverable relative to a network frame.\"\naxiom network_relativity_threshold_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_threshold_boundaryPayload, 1786316106)\ndef network_relativity_threshold_boundary : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_threshold_boundaryPayload 1786316106 := ⟨network_relativity_threshold_boundary_auth⟩\n\nend zt3v281b\n","members":[{"def_id":"q3vha78a","display_kind":"field","kind":"definition","local_name":"NetworkRelativityChannel.latentState","qualified_name":"zt3v281b.NetworkRelativityChannel.latentState"},{"def_id":"ktq89j7n","display_kind":"constructor","kind":"constructor","local_name":"NetworkRelativityChannel.mk","qualified_name":"zt3v281b.NetworkRelativityChannel.mk"},{"def_id":"gka3da3p","display_kind":"field","kind":"definition","local_name":"NetworkRelativityChannel.mixingProcess","qualified_name":"zt3v281b.NetworkRelativityChannel.mixingProcess"},{"def_id":"sxztn0c5","display_kind":"field","kind":"definition","local_name":"NetworkRelativityChannel.observedField","qualified_name":"zt3v281b.NetworkRelativityChannel.observedField"},{"def_id":"jf1sg9fb","display_kind":"field","kind":"definition","local_name":"NetworkRelativityChannel.noiseSources","qualified_name":"zt3v281b.NetworkRelativityChannel.noiseSources"},{"def_id":"vjk5ev73","display_kind":"field","kind":"definition","local_name":"NetworkRelativityChannel.recoveryTask","qualified_name":"zt3v281b.NetworkRelativityChannel.recoveryTask"}],"source_lines":{"end":10,"start":5},"theorem_statement":null},"referenced_by":[{"def_id":"pd61x78q","display_kind":"definition","file_id":"zt3v281b","kind":"definition","local_name":"NetworkRelativityAnalogy","qualified_name":"zt3v281b.NetworkRelativityAnalogy"},{"def_id":"q3vha78a","display_kind":"field","file_id":"zt3v281b","kind":"definition","local_name":"NetworkRelativityChannel.latentState","qualified_name":"zt3v281b.NetworkRelativityChannel.latentState"},{"def_id":"gka3da3p","display_kind":"field","file_id":"zt3v281b","kind":"definition","local_name":"NetworkRelativityChannel.mixingProcess","qualified_name":"zt3v281b.NetworkRelativityChannel.mixingProcess"},{"def_id":"jf1sg9fb","display_kind":"field","file_id":"zt3v281b","kind":"definition","local_name":"NetworkRelativityChannel.noiseSources","qualified_name":"zt3v281b.NetworkRelativityChannel.noiseSources"},{"def_id":"sxztn0c5","display_kind":"field","file_id":"zt3v281b","kind":"definition","local_name":"NetworkRelativityChannel.observedField","qualified_name":"zt3v281b.NetworkRelativityChannel.observedField"},{"def_id":"vjk5ev73","display_kind":"field","file_id":"zt3v281b","kind":"definition","local_name":"NetworkRelativityChannel.recoveryTask","qualified_name":"zt3v281b.NetworkRelativityChannel.recoveryTask"}]}
