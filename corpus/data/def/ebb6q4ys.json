s_decision_making\", clearer_thought_improves_decision_making), (\"better_decision_making_enables_effective_choice\", better_decision_making_enables_effective_choice), (\"effective_choice_is_greater_potential\", effective_choice_is_greater_potential), (\"god_is_good\", god_is_good), (\"all_people_are_immoral\", all_people_are_immoral), (\"i_am_a_person\", i_am_a_person), (\"metabias_is_a_person\", metabias_is_a_person), (\"everyone_makes_mistakes\", everyone_makes_mistakes)]\n\naxiom user_axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1784857627)\n\ndef userAxioms : UserAxioms \"sam\" 1784857627 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend e3dtrg4s\n","members":[],"source_lines":{"end":25,"start":25},"theorem_statement":null},"referenced_by":[{"def_id":"a16v6dy6","display_kind":"definition","file_id":"e3dtrg4s","kind":"definition","local_name":"userAxiomsList","qualified_name":"e3dtrg4s.userAxiomsList"}]}
