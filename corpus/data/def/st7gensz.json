MachineControlProtocol::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\n\nnamespace ex8s489c\n\nstructure MachineControlProtocol where\n  packetCount : Nat\n  heldOutPacketCount : Nat\n  repetitions : Nat\n  randomizedOrder : Bool\n  warmupPerformed : Bool\n  finalAnswerExtraction : Bool\n  structuredScoring : Bool\n  humanAbsorptionMeasured : Bool\n\n\ndef WellFormedMachineControlProtocol (p : MachineControlProtocol) : Prop :=\n  0 < p.packetCount ∧\n    0 < p.heldOutPacketCount ∧\n    0 < p.repetitions ∧\n    p.randomizedOrder = true ∧\n    p.warmupPerformed = true ∧\n    p.finalAnswerExtraction = true ∧\n    p.structuredScoring = true\n\n\ndef MachineOnlyControlEvidence (p : MachineControlProtocol) : Prop :=\n  p.humanAbsorptionMeasured = false\n\n\ndef MachineControlIsNotRecipientTransfer (p : MachineControlProtocol) : Prop :=\n  MachineOnlyControlEvidence p\n\n\ndef machine_control_protocol_boundaryPayload :=\n  \"A machine-only connected-compression control should use a frozen packet set, a held-out packet set, explicit warm-up handling, randomized condition order, repeated requests, final-answer extraction, and structured scoring. These controls reduce harness noise; they do not create human recipient absorption evidence.\"\naxiom machine_control_protocol_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", machine_control_protocol_boundaryPayload, 1786286178)\ndef machine_control_protocol_boundary : Axiom.Statement \"hitchhiker2thefuture\" machine_control_protocol_boundaryPayload 1786286178 := ⟨machine_control_protocol_boundary_auth⟩\n\ndef held_out_machine_suite_boundaryPayload :=\n  \"A held-out synthetic suite may test required distinctions, recipient fit, bounded next actions, uncertainty preservation, and unsupported overclaims with deterministic answer keys. Its result remains machine-proxy evidence and cannot establish successful transfer to a human recipient.\"\naxiom held_out_machine_suite_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", held_out_machine_suite_boundaryPayload, 1786286178)\ndef held_out_machine_suite_boundary : Axiom.Statement \"hitchhiker2thefuture\" held_out_machine_suite_boundaryPayload 1786286178 := ⟨held_out_machine_suite_boundary_auth⟩\n\ndef machine_control_failure_boundaryPayload :=\n  \"If model responses hit the generation ceiling, echo the prompt, fail final-answer extraction, or produce empty scored answers, the run is a harness diagnostic and not an observation of routing quality. A failed control run must remain visible and must not be replaced by plausible-looking aggregate scores.\"\naxiom machine_control_failure_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", machine_control_failure_boundaryPayload, 1786286178)\ndef machine_control_failure_boundary : Axiom.Statement \"hitchhiker2thefuture\" machine_control_failure_boundaryPayload 1786286178 := ⟨machine_control_failure_boundary_auth⟩\n\ndef structured_machine_score_boundaryPayload :=\n  \"A structured machine score can measure lexical or rubric-proxy properties of an extracted answer, including signal components, recipient-fit terms, bounded actions, uncertainty markers, and overclaim penalties. It is not comprehension, validated use, correction distance, or capability parity.\"\naxiom structured_machine_score_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", structured_machine_score_boundaryPayload, 1786286178)\ndef structured_machine_score_boundary : Axiom.Statement \"hitchhiker2thefuture\" structured_machine_score_boundaryPayload 1786286178 := ⟨structured_machine_score_boundary_auth⟩\n\nend ex8s489c\n","members":[{"def_id":"dq2nz67k","display_kind":"constructor","kind":"constructor","local_name":"MachineControlProtocol.mk","qualified_name":"ex8s489c.MachineControlProtocol.mk"},{"def_id":"gcfy9egk","display_kind":"field","kind":"definition","local_name":"MachineControlProtocol.packetCount","qualified_name":"ex8s489c.MachineControlProtocol.packetCount"},{"def_id":"k24ct71r","display_kind":"field","kind":"definition","local_name":"MachineControlProtocol.heldOutPacketCount","qualified_name":"ex8s489c.MachineControlProtocol.heldOutPacketCount"},{"def_id":"t6rd1543","display_kind":"field","kind":"definition","local_name":"MachineControlProtocol.repetitions","qualified_name":"ex8s489c.MachineControlProtocol.repetitions"},{"def_id":"ke48z37b","display_kind":"field","kind":"definition","local_name":"MachineControlProtocol.randomizedOrder","qualified_name":"ex8s489c.MachineControlProtocol.randomizedOrder"},{"def_id":"kx2fgemk","display_kind":"field","kind":"definition","local_name":"MachineControlProtocol.warmupPerformed","qualified_name":"ex8s489c.MachineControlProtocol.warmupPerformed"},{"def_id":"yxjse4fq","display_kind":"field","kind":"definition","local_name":"MachineControlProtocol.finalAnswerExtraction","qualified_name":"ex8s489c.MachineControlProtocol.finalAnswerExtraction"},{"def_id":"h8jm2b1h","display_kind":"field","kind":"definition","local_name":"MachineControlProtocol.structuredScoring","qualified_name":"ex8s489c.MachineControlProtocol.structuredScoring"},{"def_id":"rmhn4dhf","display_kind":"field","kind":"definition","local_name":"MachineControlProtocol.humanAbsorptionMeasured","qualified_name":"ex8s489c.MachineControlProtocol.humanAbsorptionMeasured"}],"source_lines":{"end":13,"start":5},"theorem_statement":null},"referenced_by":[{"def_id":"f2tc7qzb","display_kind":"definition","file_id":"ex8s489c","kind":"definition","local_name":"MachineControlIsNotRecipientTransfer","qualified_name":"ex8s489c.MachineControlIsNotRecipientTransfer"},{"def_id":"yxjse4fq","display_kind":"field","file_id":"ex8s489c","kind":"definition","local_name":"MachineControlProtocol.finalAnswerExtraction","qualified_name":"ex8s489c.MachineControlProtocol.finalAnswerExtraction"},{"def_id":"k24ct71r","display_kind":"field","file_id":"ex8s489c","kind":"definition","local_name":"MachineControlProtocol.heldOutPacketCount","qualified_name":"ex8s489c.MachineControlProtocol.heldOutPacketCount"},{"def_id":"rmhn4dhf","display_kind":"field","file_id":"ex8s489c","kind":"definition","local_name":"MachineControlProtocol.humanAbsorptionMeasured","qualified_name":"ex8s489c.MachineControlProtocol.humanAbsorptionMeasured"},{"def_id":"gcfy9egk","display_kind":"field","file_id":"ex8s489c","kind":"definition","local_name":"MachineControlProtocol.packetCount","qualified_name":"ex8s489c.MachineControlProtocol.packetCount"},{"def_id":"ke48z37b","display_kind":"field","file_id":"ex8s489c","kind":"definition","local_name":"MachineControlProtocol.randomizedOrder","qualified_name":"ex8s489c.MachineControlProtocol.randomizedOrder"},{"def_id":"t6rd1543","display_kind":"field","file_id":"ex8s489c","kind":"definition","local_name":"MachineControlProtocol.repetitions","qualified_name":"ex8s489c.MachineControlProtocol.repetitions"},{"def_id":"h8jm2b1h","display_kind":"field","file_id":"ex8s489c","kind":"definition","local_name":"MachineControlProtocol.structuredScoring","qualified_name":"ex8s489c.MachineControlProtocol.structuredScoring"},{"def_id":"kx2fgemk","display_kind":"field","file_id":"ex8s489c","kind":"definition","local_name":"MachineControlProtocol.warmupPerformed","qualified_name":"ex8s489c.MachineControlProtocol.warmupPerformed"},{"def_id":"y7bdp2x1","display_kind":"definition","file_id":"ex8s489c","kind":"definition","local_name":"MachineOnlyControlEvidence","qualified_name":"ex8s489c.MachineOnlyControlEvidence"},{"def_id":"w4vzkmjc","display_kind":"definition","file_id":"ex8s489c","kind":"definition","local_name":"WellFormedMachineControlProtocol","qualified_name":"ex8s489c.WellFormedMachineControlProtocol"}]}
