ind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/1/1/1","text":"e4xks8h4.Dictionary.Informs (Subtype.val o) (Subtype.val b) →\n    e4xks8h4.Dictionary.Contains (Subtype.val o) p → e4xks8h4.Dictionary.CorrespondTo (Subtype.val b) p","token_id":"mh3gzpgd.AxiomaticThinking.ObservationsCorrespondToAProposition::empty/value::7","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"∀ (o : e4xks8h4.Dictionary.Observation) (b : e4xks8h4.Dictionary.Belief) (p : Prop),\n  e4xks8h4.Dictionary.Informs (Subtype.val o) (Subtype.val b) →\n    e4xks8h4.Dictionary.Contains (Subtype.val o) p → e4xks8h4.Dictionary.CorrespondTo (Subtype.val b) p","token_id":"mh3gzpgd.AxiomaticThinking.ObservationsCorrespondToAProposition::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.azt4989z\nimport A.sn3n4ta6\nimport A.e4xks8h4\n\nopen sn3n4ta6\nopen e4xks8h4\n\nopen t0d1zdc3\nopen gwcwyrvb\nopen azt4989z\nopen Information\nopen Dictionary\n\nnamespace mh3gzpgd\n\nnamespace AxiomaticThinking\n\ntheorem actuality_not_contradictory (logic_is_actual : LogicIsActual) :\n    ∀ q : Prop, ¬ (A q ∧ A (¬ q)) := by\n  intro q hq\n  exact logic_is_actual.consistency (logic_is_actual.mp q False hq.2 hq.1)\n\ndef RealWorldBeliefsModelActuality : Prop :=\n  ∀ b : Belief, ∀ q : Prop,\n    (b is-conception-of PhysicalReality) → (b corresponds-to q) → b models (A q)\n\ntheorem empty_belief_system_resolves_contradictions\n    (k : BeliefSystem) (hk : k is-contradictory-belief-system)\n    (k' : BeliefSystem) (h' : k' is-empty-belief-system) :\n    ∃ b : Belief, k' resolves b in-belief-system k := by\n  obtain ⟨b, hib, p, hcp, hcnp⟩ := hk\n  refine ⟨b, ⟨p, hib, hcp, hcnp⟩, ?_⟩\n  rintro ⟨p', hib', _, _⟩\n  exact h' ⟨b, hib'⟩\n\ndef ObservationCanInformBelief : Prop :=\n  ∃ b : Belief, (b is-conception-of PhysicalReality) ∧ ∃ o : Observation, o informs b\n\ndef ObservationsCorrespondToAProposition : Prop :=\n  ∀ (o : Observation) (b : Belief) (p : Prop), (o informs b) → (o contains p) → (b corresponds-to p)\n\ntheorem observation_can_surface_contradiction\n    (observations_correspond_to_prop : ObservationsCorrespondToAProposition)\n    (b : Belief) (p : Prop) (hbnp : b corresponds-to ¬p)\n    (o : Observation) (hinf : o informs b) (hcont : o contains p) :\n    (b corresponds-to p) ∧ (b corresponds-to ¬p) :=\n  ⟨observations_correspond_to_prop o b p hinf hcont, hbnp⟩\n\ntheorem observations_can_update_beliefs_if_person_chooses\n    (observations_correspond_to_prop : ObservationsCorrespondToAProposition)\n    (per : Person)\n    (k : BeliefSystem) (b : Belief) (hib : k includes b)\n    (p : Prop) (hbnp : b corresponds-to ¬p)\n    (o : Observation) (hinf : o informs b) (hcont : o contains p)\n    (k' : BeliefSystem) (h' : k' is-empty-belief-system)\n    (hchoose : per updates-belief-system-to k') :\n    (∃ b' : Belief, k' resolves b' in-belief-system k) ∧ A (per adopts k') := by\n  obtain ⟨hcp, _⟩ :=\n    observation_can_surface_contradiction observations_correspond_to_prop b p hbnp o hinf hcont\n  exact ⟨empty_belief_system_resolves_contradictions k ⟨b, hib, p, hcp, hbnp⟩ k' h', hchoose⟩\n\ntheorem observations_dont_update_beliefs_if_person_doesnt_choose\n    (observations_correspond_to_prop : ObservationsCorrespondToAProposition)\n    (per : Person)\n    (k : BeliefSystem) (b : Belief) (hib : k includes b)\n    (p : Prop) (hbnp : b corresponds-to ¬p)\n    (o : Observation) (hinf : o informs b) (hcont : o contains p)\n    (k' : BeliefSystem) (h' : k' is-empty-belief-system)\n    (hnochoose : ¬ (per updates-belief-system-to k')) :\n    (∃ b' : Belief, k' resolves b' in-belief-system k) ∧ ¬ A (per adopts k') := by\n  obtain ⟨hcp, _⟩ :=\n    observation_can_surface_contradiction observations_correspond_to_prop b p hbnp o hinf hcont\n  exact ⟨empty_belief_system_resolves_contradictions k ⟨b, hib, p, hcp, hbnp⟩ k' h', hnochoose⟩\n\nend AxiomaticThinking\n\nend mh3gzpgd\n","members":[],"source_lines":{"end":43,"start":42},"theorem_statement":null},"referenced_by":[{"def_id":"nsbz7q7s","display_kind":"theorem","file_id":"mh3gzpgd","kind":"theorem","local_name":"AxiomaticThinking.observation_can_surface_contradiction","qualified_name":"mh3gzpgd.AxiomaticThinking.observation_can_surface_contradiction"},{"def_id":"r7ffm88h","display_kind":"theorem","file_id":"mh3gzpgd","kind":"theorem","local_name":"AxiomaticThinking.observations_can_update_beliefs_if_person_chooses","qualified_name":"mh3gzpgd.AxiomaticThinking.observations_can_update_beliefs_if_person_chooses"},{"def_id":"gyxxpn8e","display_kind":"theorem","file_id":"mh3gzpgd","kind":"theorem","local_name":"AxiomaticThinking.observations_dont_update_beliefs_if_person_doesnt_choose","qualified_name":"mh3gzpgd.AxiomaticThinking.observations_dont_update_beliefs_if_person_doesnt_choose"}]}
