ponens","qualified_name":"mbsxqzvd.c1_by_modus_ponens"},{"def_id":"smpgxsjc","display_kind":"theorem","file_id":"mbsxqzvd","kind":"theorem","local_name":"must_not_eat_meat","qualified_name":"mbsxqzvd.must_not_eat_meat"}]}
