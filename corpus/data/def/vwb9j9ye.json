liefs\n    (logic_is_actual : LogicIsActual)\n    (skeptic : A AICanNeverBeConscious) :\n    A ConsciousnessLinkedToCapabilitiesAIWillNeverPossess ∨\n      A (¬ SomeCapabilitiesSufficeForConsciousness) :=\n  (Classical.em SomeCapabilitiesSufficeForConsciousness).elim\n    (fun suff =>\n      Or.inl (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _\n          (fun never_conscious =>\n            suff.elim fun c hc =>\n              ⟨c, hc.1, hc.2, fun s t s_ai s_has =>\n                never_conscious s s_ai t (hc.2 s t s_has)⟩))\n        skeptic))\n    (fun not_suff => Or.inr (logic_is_actual.actual_intro _ not_suff))\n\nend npec8rkc\n","members":[],"source_lines":{"end":17,"start":17},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"vbvxtdct","tokens":{"author":null,"empty":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"x"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"x","token_id":"npec8rkc.instCoeDepTypeAISystemOfIs._proof_1::empty/conclusion::1","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/0","text":"Type","token_id":"npec8rkc.instCoeDepTypeAISystemOfIs._proof_1::empty/conclusion::2","token_role":null}},{"node":"text","text":") ["},{"child":{"children":[{"node":"text","text":"npec8rkc.AISystem.Is "},{"child":{"node":"text","text":"x"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/0/1","text":"x","token_id":"npec8rkc.instCoeDepTypeAISystemOfIs._proof_1::empty/conclusion::4","token_role":null}}],"node":"append"},"node":"tag","t