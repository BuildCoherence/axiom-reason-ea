 everyone_including h => everyone_including ⟨MetaBias, h⟩))\n      everyone_makes_mistakes)\n    i_am_a_person\n\nend pktczw9n\n","members":[],"source_lines":{"end":48,"start":38},"theorem_statement":{"conclusion":{"author_byte_range":{"end":1214,"start":1187},"name":null,"proposition_id":"xn61tbge","tokens":{"author":{"child":{"children":[{"node":"text","text":"A "},{"child":{"children":[{"child":{"node":"text","text":"MetaBias"},"node":"tag","tag":{"binder_role":"use_site","def_id":"zjkph4j1","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"pktczw9n.MetaBias","subexpr_pos":"/1/1","text":"MetaBias","token_id":"pktczw9n.metabias_makes_mistakes::author/conclusion::2","token_role":null}},{"node":"text","text":" makes-mistakes"}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"gpqt25wm","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"pktczw9n.MakesMistakes","subexpr_pos":"/1","text":"MetaBias makes-mistakes","token_id":"pktczw9n.metabias_makes_mistakes::author/conclusion::1","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/","text":"A MetaBias makes-mistakes","token_id":"pktczw9n.metabias_makes_mistakes::author/conclusion::0","token_role":null}},"empty":{"child":{"children":[{"node":"text","text":"Axiom.Actual "},{"child":{"children":[{"node":"text","text":"(pktczw9n.MakesMistakes "},{"child":{"node":"text","text":"pktczw9n.MetaBias"},"node":"tag","tag":{"binder_role":"use_site","def_id":"zjkph4j1","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"pktczw9n.MetaBias","subexpr_pos":"/1/1","text":"pktczw9n.MetaBias","token_id":"pktczw9n.metabias_makes_mistakes::empty/conclusion::2","token_role":null}},{"node":"text","text":")"}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","d