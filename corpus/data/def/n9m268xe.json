_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1/1/1","text":"q","token_id":"t0d1zdc3.LogicIsActual.mp::empty/conclusion::13","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/1/1/1/1","text":"Axiom.Actual q","token_id":"t0d1zdc3.LogicIsActual.mp::empty/conclusion::12","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/1/1/1","text":"Axiom.Actual p → Axiom.Actual q","token_id":"t0d1zdc3.LogicIsActual.mp::empty/conclusion::9","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/1/1","text":"Axiom.Actual (p → q) → Axiom.Actual p → Axiom.Actual q","token_id":"t0d1zdc3.LogicIsActual.mp::empty/conclusion::4","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"∀ (p q : Prop), Axiom.Actual (p → q) → Axiom.Actual p → Axiom.Actual q","token_id":"t0d1zdc3.LogicIsActual.mp::empty/conclusion::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom.Types.Actual\nopen Axiom\n\nnamespace t0d1zdc3\n\n-- Bridge axioms that enable logically reasoning about what's Actual.\n-- A bare (hp : p) means that p is logically true; that is, true\n-- in all logically possibile worlds. We therefore use Actual p to\n-- denote truths that are contigently true in the \"actual world\".\n-- Note: Rejecting these axioms does not imply that one rejects\n-- logic as a means to understand Actuality. By accepting these\n-- axioms, you accept Lean 4's logic. Users who would prefer, for\n-- example, a purely intuitionist logic would need to accept\n-- alternative bridge axioms and not accept these ones.\nstructure LogicIsActual : Prop where\n  -- That which is True logically is True Actually.\n  actual_intro : ∀ p : Prop, p → Actual p\n  -- Modus ponens at the actual world (the \"K\" axiom): if (p → q) is\n  -- Actual and p is Actual, then q is Actual. The Actual-wrapped\n  -- conditional is what makes this strong enough to chain multi-premise\n  -- inferences whose rules are themselves Actual claims.\n  mp : ∀ p q : Prop, Actual (p → q) → Actual p → Actual q\n  -- Nothing that is inconsistent is Actually true.\n  consistency : ¬ Actual False\n  -- That which is actually True is actually actually True\n  -- (and vise versa).\n  idempotency : ∀ p : Prop, Actual p = Actual (Actual p)\n\n\nend t0d1zdc3\n","members":[],"source_lines":{"end":22,"start":22},"theorem_statement":null},"referenced_by":[{"def_id":"aswbx991","display_kind":"theorem","file_id":"ap91fkg6","kind":"theorem","local_name":"AxiomaticThinking.actuality_not_contradictory","qualified_name":"ap91fkg6.AxiomaticThinking.actuality_not_contradictory"},{"def_id":"fbhg0ac0","display_kind":"theorem","file_id":"av93fgyq","kind":"theorem","local_name":"AxiomaticThinking.my_physical_space_not_contradictory","qualified_name":"av93fgyq.AxiomaticThinking.my_physical_space_not_contradictory"},{"def_id":"pzrnw9s4","display_kind":"theorem","file_id":"ay9krd84","kind":"theorem","local_name":"animal_ag_impermissible","qualified_name":"ay9krd84.animal_ag_impermissible"},{"def_id":"x6bm6cmk","display_kind":"theorem","file_id":"azt4989z","kind":"theorem","local_name":"actually_clearer_thought_means_greater_potential","qualified_name":"azt4989z.actually_clearer_thought_means_greater_potential"},{"def_id":"dzes31vy","display_kind":"theorem","file_id":"c065ehm2","kind":"theorem","local_name":"disagreement_is_contradiction","qualified_name":"c065ehm2.disagreement