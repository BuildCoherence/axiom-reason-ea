l}},{"node":"text","text":" + "},{"child":{"children":[{"node":"text","text":"sizeOf "},{"child":{"node":"text","text":"evidenceBoundary"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1/1/1/1/1/1","text":"evidenceBoundary","token_id":"v2pywa4r.HumanpowerInteractionEdge.mk.sizeOf_spec::empty/conclusion::32","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Nat","kind":"stdlib","qualified_name":"SizeOf.sizeOf","subexpr_pos":"/1/1/1/1/1/1/1","text":"sizeOf evidenceBoundary","token_id":"v2pywa4r.HumanpowerInteractionEdge.mk.sizeOf_spec::empty/conclusion::31","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Nat","kind":"stdlib","qualified_name":"HAdd.hAdd","subexpr_pos":"/1/1/1/1/1/1","text":"1 + sizeOf sourceKind + sizeOf targetKind + sizeOf interactionKind + sizeOf touchpoints + sizeOf evidenceBoundary","token_id":"v2pywa4r.HumanpowerInteractionEdge.mk.sizeOf_spec::empty/conclusion::17","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Eq","subexpr_pos":"/1/1/1/1/1","text":"sizeOf (v2pywa4r.HumanpowerInteractionEdge.mk sourceKind targetKind interactionKind touchpoints evidenceBoundary) =\n    1 + sizeOf sourceKind + sizeOf targetKind + sizeOf interactionKind + sizeOf touchpoints + sizeOf evidenceBoundary","token_id":"v2pywa4r.HumanpowerInteractionEdge.mk.sizeOf_spec::empty/conclusion::9","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"∀ (sourceKind targetKind interactionKind : String) (touchpoints : Nat) (evidenceBoundary : String),\n  sizeOf (v2pywa4r.HumanpowerInteractionEdge.mk sourceKind targetKind interactionKind touchpoints evidenceBoundary) =\n    1 + sizeOf sourceKind + sizeOf targetKind + sizeOf interactionKind + sizeOf touchpoints + sizeOf evidenceBoundary","token_id":"v2pywa4r.HumanpowerInteractionEdge.mk.sizeOf_spec::empty/conclusion::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\n\nnamespace v2pywa4r\n\nstructure HumanpowerInteractionEdge where\n  sourceKind : String\n  targetKind : String\n  interactionKind : String\n  touchpoints : Nat\n  evidenceBoundary : String\n\ndef HumanpowerInteractionGraph : List HumanpowerInteractionEdge := [\n  {\n    sourceKind := \"human\",\n    targetKind := \"local_ai\",\n    interactionKind := \"human_to_local_ai_message\",\n    touchpoints := 3217,\n    evidenceBoundary := \"48 CLI sessions in the 2026-07-24 through 2026-08-07 retrospective window\"\n  },\n  {\n    sourceKind := \"local_ai\",\n    targetKind := \"human\",\n    interactionKind := \"local_ai_to_human_message\",\n    touchpoints := 33220,\n    evidenceBoundary := \"assistant messages in the same CLI session window\"\n  },\n  {\n    sourceKind := \"local_ai\",\n    targetKind := \"local_ai\",\n    interactionKind := \"delegation_to_subagent\",\n    touchpoints := 118,\n    evidenceBoundary := \"118 delegate calls producing 108 subagent sessions; task quality and outcome are measured separately\"\n  },\n  {\n    sourceKind := \"human\",\n    targetKind := \"non_local_ai\",\n    interactionKind := \"Boardy_reply_or_coordination\",\n    touchpoints := 35,\n    evidenceBoundary := \"35 deduplicated Boardy replies involving Leo; captured 2026-07-31 through 2026-08-07\"\n  },\n  {\n    sourceKind := \"human\",\n    targetKind := \"human\",\n    interactionKind := \"archived_call\",\n    touchpoints := 17,\n    evidenceBoundary := \"17 unique calls by transcript content hash in the private archive\"\n  },\n  {\n    sourceKind := \"non_local_ai\",\n    targetKind := \"human\",\n    interactionKind := \"mediated_introduction_join\",\n    touchpoints := 3,\n    evidenceBoundary := \"3 high-confidence or explicit Boardy-to-call joins; 4 additional joins remain supporting evidence\"\n  }\n]\n\ndef humanpower_interaction_graph_boundaryPayload :=\n  \"This graph counts observed interaction edges, not equivalent units of work. A message, a delegation, a Boardy reply, a call, and an introduction join have different costs and meanings. The graph therefore preserves edge type, source, target, count, and evidence boundary instead of summing touchpoints into a humanpower score.\"\naxiom humanpower_interaction_graph_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", humanpower_interaction_graph_boundaryPayload, 1786133236)\ndef humanpower_interaction_graph_boundary : Axiom.Statement \"hitchhiker2thefuture\" humanpower_interaction_graph_boundaryPayload 1786133236 := ⟨humanpower_interaction_graph_boundary_auth⟩\n\ndef non_local_ai_touchpoint_observationPayload :=\n  \"The retrospective contains direct evidence that a human interacted with a non-local AI: Boardy replies and Boardy-mediated or Boardy-strategy calls are recorded separately from the local Hermes AI sessions. The current evidence shows search, triage, calendar compression, and introductions; it does not by itself show that every non-local AI touchpoint produced downstream advancement.\"\naxiom non_local_ai_touchpoint_observation_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", non_local_ai_touchpoint_observationPayload, 1786133236)\ndef non_local_ai_touchpoint_observation : Axiom.Statement \"hitchhiker2thefuture\" non_local_ai_touchpoint_observationPayload 1786133236 := ⟨non_local_ai_touchpoint_observation_auth⟩\n\ndef graph_to_humanpower_transitionPayload :=\n  \"An interaction edge becomes a humanpower contribution only when it is linked to a validated artifact, a distribution event, a downstream adoption or decision, or a reward event. The next graph revision should attach those transition receipts to edges without exposing private transcript content.\"\naxiom graph_to_humanpower_transition_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", graph_to_humanpower_transitionPayload, 1786133236)\ndef graph_to_humanpower_transition : Axiom.Statement \"hitchhiker2thefuture\" graph_to_humanpower_transitionPayload 1786133236 := ⟨graph_to_humanpower_transition_auth⟩\n\nend v2pywa4r\n","members":[],"source_lines":{"end":5,"start":5},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"hpqwybcj","tokens":{"author":null,"empty":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"sourceKind "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"sourceKind ","token_id":"v2pywa4r.HumanpowerInteractionEdge.mk.sizeOf_spec::empty/conclusion::1","token_role":null}},{"child":{"node":"text","text":"targetKind "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"targetKind ","token_id":"v2pywa4r.HumanpowerInteractionEdge.mk.sizeOf_spec::empty/conclusion::2","token_role":null}},{"child":{"node":"text","text":"interactionKind"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/0","text":"interactionKind","token_id":"v2pywa4r.HumanpowerInteractionEdge.mk.sizeOf_spec::empty/conclusion::3","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"String"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"String","subexpr_pos":"/1/1/0","text":"Strin