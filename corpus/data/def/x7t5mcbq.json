::empty/value::6","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Nat","kind":"stdlib","qualified_name":"hmhhcnw7.HeadroomState.commitmentBurden","subexpr_pos":"/1/1","text":"hmhhcnw7.HeadroomState.commitmentBurden s","token_id":"hmhhcnw7.headroom::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Nat","kind":"stdlib","qualified_name":"HSub.hSub","subexpr_pos":"/1","text":"hmhhcnw7.HeadroomState.grossCapacity s - hmhhcnw7.HeadroomState.commitmentBurden s","token_id":"hmhhcnw7.headroom::empty/value::2","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"hmhhcnw7.HeadroomState → Nat","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun s => hmhhcnw7.HeadroomState.grossCapacity s - hmhhcnw7.HeadroomState.commitmentBurden s","token_id":"hmhhcnw7.headroom::empty/value::0","token_role":null}}}},"file_content":"import Axiom\n\nnamespace hmhhcnw7\n\nstructure HeadroomState where\n  grossCapacity : Nat\n  commitmentBurden : Nat\n\n def headroom (s : HeadroomState) : Nat :=\n  s.grossCapacity - s.commitmentBurden\n\n theorem headroom_nonnegative (s : HeadroomState) :\n    0 ≤ headroom s := by\n  exact Nat.zero_le _\n\n theorem headroom_zero_of_burden_ge_capacity\n    (s : HeadroomState)\n    (h : s.grossCapacity ≤ s.commitmentBurden) :\n    headroom s = 0 := by\n  exact Nat.sub_eq_zero_of_le h\n\n theorem headroom_positive_iff_capacity_exceeds_burden\n    (s : HeadroomState) :\n    0 < headroom s ↔ s.commitmentBurden < s.grossCapacity := by\n  simpa [headroom] using Nat.sub_pos_iff_lt\n\n def retirementHeadroomGain (releasedBurden capabilityLoss : Nat) : Nat :=\n  releasedBurden - capabilityLoss\n\n theorem safe_retirement_gain_of_burden_release\n    (releasedBurden capabilityLoss : Nat)\n    (h : capabilityLoss < releasedBurden) :\n    0 < retirementHeadroomGain releasedBurden capabilityLoss := by\n  exact Nat.sub_pos_of_lt h\n\ndef headroom_theorem_boundaryPayload := \"These theorems establish only arithmetic consequences of a natural-number headroom model. They do not prove that a real system's capacities are commensurable, that burden is fully observed, or that effective reachable futures are determined by one scalar.\"\naxiom headroom_theorem_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", headroom_theorem_boundaryPayload, 1789059159)\ndef headroom_theorem_boundary : Axiom.Statement \"hitchhiker2thefuture\" headroom_theorem_boundaryPayload 1789059159 := ⟨headroom_theorem_boundary_auth⟩\n\nend hmhhcnw7\n","members":[],"source_lines":{"end":10,"start":9},"theorem_statement":null},"referenced_by":[{"def_id":"eqqfvyc6","display_kind":"theorem","file_id":"hmhhcnw7","kind":"theorem","local_name":"headroom_nonnegative","qualified_name":"hmhhcnw7.headroom_nonnegative"},{"def_id":"wne1qq8f","display_kind":"theorem","file_id":"hmhhcnw7","kind":"theorem","local_name":"headroom_positive_iff_capacity_exceeds_burden","qualified_name":"hmhhcnw7.headroom_positive_iff_capacity_exceeds_burden"},{"def_id":"sjad75ce","display_kind":"theorem","file_id":"hmhhcnw7","kind":"theorem","local_name":"headroom_zero_of_burden_ge_capacity","qualified_name":"hmhhcnw7.headroom_zero_of_burden_ge_capacity"}]}
