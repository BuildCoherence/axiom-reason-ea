r_role":"use_site","def_id":"m660f0wz","hover_kind":"term","inlined_type_summary":"Type → Type → Prop","kind":"type","qualified_name":"nrhqjxz5.Person.At","subexpr_pos":"/1","text":"nrhqjxz5.Person.At","token_id":"qg6hprvj.Parenting.YoungParent.At::empty/value::2","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"xjgakk9h","hover_kind":"term","inlined_type_summary":"Type → Type → Prop","kind":"type","qualified_name":"mwh5b5da.UniversalAtUnder","subexpr_pos":"/","text":"mwh5b5da.UniversalAtUnder qg6hprvj.Parenting.YoungParent.U nrhqjxz5.Person.At","token_id":"qg6hprvj.Parenting.YoungParent.At::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.a4hsz51v\nimport A.ta3nj1a4\nimport A.r59jf3ak\nimport A.nrhqjxz5\n\nopen nrhqjxz5\n\nnamespace qg6hprvj\n\nnamespace Parenting\n\nopen a4hsz51v\n\nopen ta3nj1a4\nopen r59jf3ak\n\nopen t0d1zdc3\n\nuniversal YoungParent extends Person := \"parent of a young child\"\n\nrelation ObligatedTo : Person \"is obligated to bring it about that\" Prop\nrelation CanBringAbout : Person \"is able to bring it about that\" Prop\nrelation HypervigilantAt : Person \"is in a state of hypervigilance at\" TemporalRegion\nrelation CalmAt : Person \"is in a state of physiological calm at\" TemporalRegion\n\nscoped notation:50 x:51 \" obligated-to \" q:51 => ObligatedTo x q\nscoped notation:50 x:51 \" can-bring-about \" q:51 => CanBringAbout x q\nscoped notation:50 x:51 \" hypervigilant-at \" t:51 => HypervigilantAt x t\nscoped notation:50 x:51 \" calm-at \" t:51 => CalmAt x t\n\ndef CalmHypervigilanceParentingStandard : Prop :=\n  ∀ p t, YoungParent.At p t → p obligated-to (p calm-at t ∧ p hypervigilant-at t)\n\ntheorem calm_hypervigilance_standard_refuted\n    (ought_implies_can : ∀ p q, p obligated-to q → p can-bring-about q)\n    (incompatible_psych_states : ∀ p t, ¬ (p can-bring-about (p calm-at t ∧ p hypervigilant-at t)))\n    (some_young_parent : ∃ p t, YoungParent.At p t)\n  : ¬ CalmHypervigilanceParentingStandard := by\n  intro std\n  obtain ⟨p, t, h⟩ := some_young_parent\n  exact incompatible_psych_states p t (ought_implies_can p _ (std p t h))\n\ntheorem calm_hypervigilance_standard_asserted_is_false\n    (logic_is_actual : LogicIsActual)\n    (ought_implies_can : ∀ p q, p obligated-to q → p can-bring-about q)\n    (incompatible_psych_states : A (∀ p t, ¬ (p can-bring-about (p calm-at t ∧ p hypervigilant-at t))))\n    (some_young_parent : A (∃ p t, YoungParent.At p t))\n    (parents_must_be_calm_and_hyperviligant : A CalmHypervigilanceParentingStandard)\n  : False :=\n  logic_is_actual.consistency\n    (logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.mp _ _\n          (logic_is_actual.actual_intro _\n            (fun incompat some_yp std =>\n              calm_hypervigilance_standard_refuted ought_implies_can incompat some_yp std))\n          incompatible_psych_states)\n        some_young_parent)\n      parents_must_be_calm_and_hyperviligant)\n\nend Parenting\n\nend qg6hprvj\n","members":[],"source_lines":{"end":21,"start":21},"theorem_statement":null},"referenced_by":[{"def_id":"e3ktvj1s","display_kind":"definition","file_id":"qg6hprvj","kind":"definition","local_name":"Parenting.CalmHypervigilanceParentingStandard","qualified_name":"qg6hprvj.Parenting.CalmHypervigilanceParentingStandard"},{"def_id":"b0zkppw9","display_kind":"theorem","file_id":"qg6hprvj","kind":"theorem","local_name":"Parenting.calm_hypervigilance_standard_asserted_is_false","qualified_name":"qg6hprvj.Parenting.calm_hypervigilance_standard_asserted_is_false"},{"def_id":"wesgjg8m","display_kind":"theorem","file_id":"qg6hprvj","kind":"theorem","local_name":"Parenting.calm_hypervigilance_standard_refuted","qualified_name":"qg6hprvj.Parenting.calm_hypervigilance_standard_refuted"},{"def_id":"y8wrytq0","display_kind":"definition","file_id":"qg6hprvj","kind":"definition","local_name":"Parenting.instCoeHeadYoungParentEver