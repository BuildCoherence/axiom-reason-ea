,"kind":"stdlib","qualified_name":"And","subexpr_pos":"/1/1","text":"azt4989z.Person.Is arg0 ∧ pv802k7b.MoralCharacter.Is arg1 ∧ Axiom.getSemantics \"has moral character\" arg0 arg1","token_id":"pv802k7b.HasMoralCharacter::empty/value::3","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type → Type → Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun arg0 arg1 =>\n  azt4989z.Person.Is arg0 ∧ pv802k7b.MoralCharacter.Is arg1 ∧ Axiom.getSemantics \"has moral character\" arg0 arg1","token_id":"pv802k7b.HasMoralCharacter::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.j12bzjgj\nimport A.azt4989z\n\nopen j12bzjgj\nopen azt4989z\nopen t0d1zdc3\nopen gwcwyrvb\nopen c424c6bg\n\nopen BFO\n\nnamespace pv802k7b\n\nrigid universal MoralCharacter extends Quality := \"moral character\"\n\nrelation Immoral : Person := \"is immoral\"\nrelation HasMoralCharacter : Person → MoralCharacter := \"has moral character\"\nrelation MoreMoralThan : MoralCharacter → MoralCharacter := \"is more moral than\"\n\npostfix:max \" is-immoral\" => Immoral\ninfix:50 \" has-moral-character \" => HasMoralCharacter\ninfix:50 \" more-moral-than \" => MoreMoralThan\n\nabbrev LessMoralThan (a b : Type) : Prop := MoreMoralThan b a\n\ninfix:50 \" less-moral-than \" => LessMoralThan\n\nstructure MoralComparisonIsCoherent : Prop where\n  more_moral_irreflexive : ∀ m : MoralCharacter, ¬ (m more-moral-than m)\n  more_moral_transitive :\n    ∀ a b c : MoralCharacter,\n      a more-moral-than b → b more-moral-than c → a more-moral-than c\n\ndef ImmoralBelowNonImmoral : Prop :=\n  ∀ (p q : Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend pv802k7b\n","members":[],"source_lines":{"end":18,"start":18},"theorem_statement":null},"referenced_by":[{"def_id":"hxvqzd7x","display_kind":"definition","file_id":"pv802k7b","kind":"definition","local_name":"ImmoralBelowNonImmoral","qualified_name":"pv802k7b.ImmoralBelowNonImmoral"},{"def_id":"dj9993n7","display_kind":"field","file_id":"pv802k7b","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.at_most_one","qualified_name":"pv802k7b.PersonsHaveExactlyOneMoralCharacter.at_most_one"},{"def_id":"y1x0146p","display_kind":"definition","file_id":"pv802k7b","kind":"definition","local_name":"PersonsHaveExactlyOneMoralCharacter.casesOn","qualified_name":"pv802k7b.PersonsHaveExactlyOneMoralCharacter.casesOn"},{"def_id":"j5xjc124","display_kind":"field","file_id":"pv802k7b","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.has_one","qualified_name":"pv802k7b.PersonsHaveExactlyOneMoralCharacter.has_one"},{"def_id":"y882ssz1","display_kind":"constructor","file_id":"pv802k7b","kind":"constructor","local_name":"PersonsHaveExactlyOneMoralCharacter.mk","qualified_name":"pv802k7b.PersonsHaveExactlyOneMoralCharacter.mk"},{"def_id":"n3t2dax4","display_kind":"definition","file_id":"zk1mxe7x","kind":"definition","local_name":"TwoPeopleDifferingInWealth.casesOn","qualified_name":"zk1mxe7x.TwoPeopleDifferingInWealth.casesOn"},{"def_id":"mgz66jbc","display_kind":"constructor","file_id":"zk1mxe7x","kind":"constructor","local_name":"TwoPeopleDifferingInWealth.mk","qualified_name":"zk1mxe7x.TwoPeopleDifferingInWealth.mk"},{"def_id":"dpfnj9jg","display