UnitsAreNotPortions)\n    (hotdogs_have_unit_fillings : A HotdogsHaveUnitFillings) :\n    A NoHotdogIsASandwich :=\n  logic_is_actual.mp _ _\n    (logic_is_actual.mp _ _\n      (logic_is_actual.actual_intro _\n        (fun unp hhuf hotdog hotdog_is h => by\n          obtain ⟨_bread, filling, _bread_of, filling_of, _bounds, portion⟩ := h\n          exact unp filling (hhuf hotdog filling hotdog_is filling_of) portion))\n      units_are_not_portions)\n    hotdogs_have_unit_fillings\n\nend Sandwich\n\nend v289fr59\n","members":[],"source_lines":{"end":18,"start":18},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"ca5y23zm","tokens":{"author":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"x "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"x ","token_id":"v289fr59.Sandwich.Hotdog.At.toParent::author/conclusion::1","token_role":null}},{"child":{"node":"text","text":"t"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"t","token_id":"v289fr59.Sandwich.Hotdog.At.toParent::author/conclusion::2","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/1/0","text":"Type","token_id":"v289fr59.Sandwich.Hotdog.At.toParent::author/conclusion::3","token_role":null}},{"node":"text","text":") ["},{"child":{"children":[{"node":"text","text":"At "},{"child":{"node":"text","text":"x"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/0/0/1","text":"x","tok