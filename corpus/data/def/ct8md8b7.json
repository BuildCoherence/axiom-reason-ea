d_type_summary":"azt4989z.Person.Is arg0 ∧ pv802k7b.MoralCharacter.Is arg1 ∧ Axiom.getSemantics \"has moral character\" arg0 arg1","kind":"stdlib","qualified_name":"And.intro","subexpr_pos":"/1/1/1/1/1","text":"And.intro inst0 (And.intro inst1 «relation»)","token_id":"pv802k7b.HasMoralCharacter.mk::empty/value::10","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"∀ {arg0 arg1 : Type} [inst0 : azt4989z.Person.Is arg0] [inst1 : pv802k7b.MoralCharacter.Is arg1],   Axiom.getSemantics \"has moral character\" arg0 arg1 →     azt4989z.Person.Is arg0 ∧ pv802k7b.MoralCharacter.Is arg1 ∧ Axiom.getSemantics \"has moral character\" arg0 arg1","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun {arg0 arg1} [inst0 : azt4989z.Person.Is arg0] [inst1 : pv802k7b.MoralCharacter.Is arg1] «relation» =>\n  And.intro inst0 (And.intro inst1 «relation»)","token_id":"pv802k7b.HasMoralCharacter.mk::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.j12bzjgj\nimport A.azt4989z\n\nopen j12bzjgj\nopen azt4989z\nopen t0d1zdc3\nopen gwcwyrvb\nopen c424c6bg\n\nopen BFO\n\nnamespace pv802k7b\n\nrigid universal MoralCharacter extends Quality := \"moral character\"\n\nrelation Immoral : Person := \"is immoral\"\nrelation HasMoralCharacter : Person → MoralCharacter := \"has moral character\"\nrelation MoreMoralThan : MoralCharacter → MoralCharacter := \"is more moral than\"\n\npostfix:max \" is-immoral\" => Immoral\ninfix:50 \" has-moral-character \" => HasMoralCharacter\ninfix:50 \" more-moral-than \" => MoreMoralThan\n\nabbrev LessMoralThan (a b : Type) : Prop := MoreMoralThan b a\n\ninfix:50 \" less-moral-than \" => LessMoralThan\n\nstructure MoralComparisonIsCoherent : Prop where\n  more_moral_irreflexive : ∀ m : MoralCharacter, ¬ (m more-moral-than m)\n  more_moral_transitive :\n    ∀ a b c : MoralCharacter,\n      a more-moral-than b → b more-moral-than c → a more-moral-than c\n\ndef ImmoralBelowNonImmoral : Prop :=\n  ∀ (p q : Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend pv802k7b\n","members":[],"source_lines":{"end":18,"start":18},"theorem_statement":null},"referenced_by":[]}
