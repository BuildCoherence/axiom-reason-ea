alCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend fs83ayjj\n","members":[],"source_lines":{"end":12,"start":12},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"y9jcpp72","tokens":{"author":null,"empty":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"v"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"v","token_id":"fs83ayjj.instCoeMoralCharacterQuality._proof_1::empty/conclusion::1","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"fs83ayjj.MoralCharacter"},"node":"tag","tag":{"binder_role":"use_site","def_id":"j9n1k4am","hover_kind":"term","inlined_type_summary":"Type 1","kind":"type","qualified_name":"fs83ayjj.MoralCharacter","subexpr_pos":"/0","text":"fs83ayjj.MoralCharacter","token_id":"fs83ayjj.instCoeMoralCharacterQuality._proof_1::empty/conclusion::2","token_role":null}},{"node":"text","text":"), "},{"child":{"children":[{"node":"text","text":"ta3nj1a4.Quality.Is "},{"child":{"children":[{"node":"text","text":"(Subtype.val "},{"child":{"node":"text","text":"v"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1","text":"v","token_id":"fs83ayjj.instCoeMoralCharacterQuality._proof_1::empty/conclusion::5","token_role":null}},{"node":"text","text":")"}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"stdlib","qualified_name":"Subt