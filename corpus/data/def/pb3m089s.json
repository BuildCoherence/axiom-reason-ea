orld.\n  -- This Prop asserts it's the exact same as the actual world up until 1939.\n  pre1939 : ∀ p, A p → A (OccurredBefore1939 p) → holds p\n\n-- The more formal version of the example claim.\ndef NazisWonUSASpeakGerman :=\n  ∀ w : NazisWonWWIIWorld, w.holds GermanOfficialLanguageUSA2026\n\nend HypotheticalWorldExample\n\n-- Optionally, one could assert that the semantic string is definitionally equal to the more formal version.\ndef NazisWonUSASpeakGermanDef : Prop :=\n  NazisWonUSASpeakGerman = HypotheticalWorldExample.NazisWonUSASpeakGerman\n\nend z4wk4zb7\n","members":[],"source_lines":{"end":23,"start":23},"theorem_statement":null},"referenced_by":[{"def_id":"bbz6r749","display_kind":"definition","file_id":"z4wk4zb7","kind":"definition","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.casesOn","qualified_name":"z4wk4zb7.HypotheticalWorldExample.NazisWonWWIIWorld.casesOn"},{"def_id":"jx7ngykc","display_kind":"constructor","file_id":"z4wk4zb7","kind":"constructor","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.mk","qualified_name":"z4wk4zb7.HypotheticalWorldExample.NazisWonWWIIWorld.mk"},{"def_id":"nwhvxf10","display_kind":"field","file_id":"z4wk4zb7","kind":"theorem","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.nazis_won","qualified_name":"z4wk4zb7.HypotheticalWorldExample.NazisWonWWIIWorld.nazis_won"}]}
