,"token_role":null},{"binder_role":"use_site","byte_end":2997,"byte_start":2986,"def_id":"a1vs7q8z","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"etsbfws7.Example.AdultMurder","text":"AdultMurder","token_id":"etsbfws7.Example.TwoConcreteMurderCases::src::60","token_role":null}],"type_tokens":{"author":null,"empty":{"child":{"node":"text","text":"Prop"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Prop","token_id":"etsbfws7.Example.TwoConcreteMurderCases::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\nimport A.t5q65xq2\nimport A.b90eedwx\nimport A.z69f3rb3\nimport A.hz46pbq2\n\nopen t5q65xq2\nopen b90eedwx\nopen z69f3rb3\nopen hz46pbq2\nopen va6mxd60\n\nopen BFO\n\nnamespace etsbfws7\n\nrigid universal Murder extends Process := \"murder\"\nrigid universal PunishmentSpec extends GenericallyDependentContinuant := \"punishment specification\"\n\nrelation MurderInvolves : Murder \"involves the victim\" Person \"and murderer\" Person\nrelation DeservesPunishmentFor : Person \"derserves\" PunishmentSpec \"for\" Process\nrelation IsGreaterPunishmentThan : PunishmentSpec \"is greater than\" PunishmentSpec\nrelation MurderCircumstancesRelevantToTheDeservedPunishmentOtherThanVictimAge : Murder := \"circumstances relevant to the deserved punishment other than the victim's age\"\n\nstructure MurderCase where\n  murder : Murder\n  murderer : Person\n  victim : Person\n  punishment : PunishmentSpec\n  murders_involvement : MurderInvolves murder victim murderer\n  deserved_punishment : DeservesPunishmentFor murderer punishment murder\n\ndef VictimIsChild (mc : MurderCase) :=\n  ∃ t, Child.At mc.victim t ∧ ProcessOccupiesTemporalRegion mc.murder t\n  \ndef SameNonVictimAgeCircumstances (mc1 mc2 : MurderCase) :=\n  (MurderCircumstancesRelevantToTheDeservedPunishmentOtherThanVictimAge mc1.murder) ↔ (MurderCircumstancesRelevantToTheDeservedPunishmentOtherThanVictimAge mc2.murder)\n\ndef ChildMurderDeservesGreaterPunishmentThanNonChildMurder : Prop :=\n  ∀ mc1 mc2 : MurderCase, SameNonVictimAgeCircumstances mc1 mc2 →\n    VictimIsChild mc1 → ¬ VictimIsChild mc2 →\n      IsGreaterPunishmentThan mc1.punishment mc2.punishment\n\nnamespace Example\n\ndef Murderer : Type := \"The Marjory Stoneman Douglas High School shooter\"\ndef ChildVictim : Type := \"Alyssa Alhadeff\"\ndef ChildMurder : Type := \"the murder of Alyssa Alhadeff\"\ndef ChildCasePunishmentSpec : Type :=\n  \"the punishment specification deserved for the murder of Alyssa Alhadeff\"\n\ndef AdultVictim : Type := \"Chris Hixon\"\ndef AdultMurder : Type := \"the murder of Chris Hixon\"\ndef AdultCasePunishmentSpec : Type :=\n  \"the punishment specification deserved for the murder of Chris Hixon\"\n\nstructure TwoConcreteMurderCases : Prop where\n  child_case_involvement : \n    MurderInvolves ChildMurder ChildVictim Murderer\n  child_case_deserved_punishment :\n    DeservesPunishmentFor Murderer ChildCasePunishmentSpec ChildMurder\n  child_case_victim_is_child :\n    ∃ t, Child.At ChildVictim t ∧ ProcessOccupiesTemporalRegion ChildMurder t\n  non_child_case_involvement :\n    MurderInvolves AdultMurder AdultVictim Murderer\n  non_child_case_deserved_punishment :\n    DeservesPunishmentFor Murderer AdultCasePunishmentSpec AdultMurder\n  non_child_case_victim_is_not_child :\n    ¬ ∃ t, Child.At AdultVictim t ∧ ProcessOccupiesTemporalRegion AdultMurder t\n  same_non_victim_age_circumstances :\n    MurderCircumstancesRelevantToTheDeservedPunishmentOtherThanVictimAge ChildMurder ↔\n      MurderCircumstancesRelevantToTheDeservedPunishmentOtherThanVictimAge AdultMurder\n\ntheorem child_case_deserves_greater_punishment\n    (logic_is_actual : LogicIsActual)\n    (principle : A ChildMurderDeservesGreaterPunishmentThanNonChildMurder)\n    (cases : A TwoConcreteMurderCases) :\n    A (IsGreaterPunishmentThan\n      ChildCasePunishmentSpec\n      AdultCasePunishmentSpec) := by\n  exact\n    logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _\n          (fun principle cases => by\n            letI : Murder.Is ChildMurder := cases.child_case_involvement.inst0\n            letI : Person.Is ChildVictim := cases.child_case_involvement.inst1\n            letI : Person.Is Murderer := cases.child_case_involvement.inst2\n            letI : PunishmentSpec.Is ChildCasePunishmentSpec :=\n              cases.child_case_deserved_punishment.inst1\n            letI : Murder.Is AdultMurder := cases.non_child_case_involvement.inst0\n            letI : Person.Is AdultVictim := cases.non_child_case_involvement.inst1\n            letI : PunishmentSpec.Is AdultCasePunishmentSpec :=\n              cases.non_child_case_deserved_punishment.inst1\n            let childCase : MurderCase :=\n              { murder := ChildMurder\n                murderer := Murderer\n                victim := ChildVictim\n                punishment := ChildCasePunishmentSpec\n                murders_involvement := cases.child_case_involvement\n                deserved_punishment := cases.child_case_deserved_punishment }\n            let nonChildCase : MurderCase :=\n              { murder := AdultMurder\n                murderer := Murderer\n                victim := AdultVictim\n                punishment := AdultCasePunishmentSpec\n                murders_involvement := cases.non_child_case_involvement\n                deserved_punishment := cases.non_child_case_deserved_punishment }\n            have sameCircumstances : SameNonVictimAgeCircumstances childCase nonChildCase := by\n              simpa [SameNonVictimAgeCircumstances, childCase, nonChildCase]\n                using cases.same_non_victim_age_circumstances\n            have childVictimIsChild : VictimIsChild childCase := by\n              simpa [VictimIsChild, childCase] using cases.child_case_victim_is_child\n            have nonChildVictimIsNotChild : ¬ VictimIsChild nonChildCase := by\n              simpa [VictimIsChild, nonChildCase]\n                using cases.non_child_case_victim_is_not_child\n            exact principle childCase nonChildCase\n              sameCircumstances\n              childVictimIsChild\n              nonChildVictimIsNotChild))\n        principle)\n      cases\n\nend Example\n\n\nend etsbfws7\n","members":[{"conclusion_prop":"vtte6xps","def_id":"ga4t6xzn","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_involvement","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.child_case_involvement"},{"def_id":"j3p6f33r","display_kind":"constructor","kind":"constructor","local_name":"Example.TwoConcreteMurderCases.mk","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.mk"},{"conclusion_prop":"qkyav66c","def_id":"pjv68b2x","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_deserved_punishment","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.child_case_deserved_punishment"},{"conclusion_prop":"fer5y5wv","def_id":"zmsfj4h5","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_victim_is_child","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.child_case_victim_is_child"},{"conclusion_prop":"pre20r9k","def_id":"g7jm8h8f","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_involvement","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.non_child_case_involvement"},{"conclusion_prop":"gbe142bf","def_id":"vvmvdknz","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_deserved_punishment","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.non_child_case_deserved_punishment"},{"conclusion_prop":"x14bhg12","def_id":"afjg9qse","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_victim_is_not_child","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.non_child_case_victim_is_not_child"},{"conclusion_prop":"r1xgexsh","def_id":"yf98zkka","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.same_non_victim_age_circumstances","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.same_non_victim_age_circumstances"}],"source_lines":{"end":72,"start":57},"theorem_statement":null},"referenced_by":[{"def_id":"q1j7g4fb","display_kind":"theorem","file_id":"etsbfws7","kind":"theorem","local_name":"Example.child_case_deserves_greater_punishment","qualified_name":"etsbfws7.Example.child_case_deserves_greater_punishment"},{"def_id":"pjv68b2x","display_kind":"field","file_id":"etsbfws7","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_deserved_punishment","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.child_case_deserved_punishment"},{"def_id":"ga4t6xzn","display_kind":"field","file_id":"etsbfws7","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_involvement","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.child_case_involvement"},{"def_id":"zmsfj4h5","display_kind":"field","file_id":"etsbfws7","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_victim_is_child","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.child_case_victim_is_child"},{"def_id":"vvmvdknz","display_kind":"field","file_id":"etsbfws7","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_deserved_punishment","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.non_child_case_deserved_punishment"},{"def_id":"g7jm8h8f","display_kind":"field","file_id":"etsbfws7","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_involvement","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.non_child_case_involvement"},{"def_id":"afjg9qse","display_kind":"field","file_id":"etsbfws7","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_victim_is_not_child","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.non_child_case_victim_is_not_child"},{"def_id":"yf98zkka","display_kind":"field","file_id":"etsbfws7","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.same_non_victim_age_circumstances","qualified_name":"etsbfws7.Example.TwoConcreteMurderCases.same_non_victim_age_circumstances"}]}
