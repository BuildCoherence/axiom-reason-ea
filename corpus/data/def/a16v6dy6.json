, (\"all_people_are_immoral\", all_people_are_immoral), (\"i_am_a_person\", i_am_a_person), (\"metabias_is_a_person\", metabias_is_a_person), (\"everyone_makes_mistakes\", everyone_makes_mistakes)]\n\naxiom user_axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1784857627)\n\ndef userAxioms : UserAxioms \"sam\" 1784857627 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend e3dtrg4s\n","members":[],"source_lines":{"end":35,"start":34},"theorem_statement":null},"referenced_by":[{"def_id":"ygby95wb","display_kind":"definition","file_id":"e3dtrg4s","kind":"definition","local_name":"userAxioms","qualified_name":"e3dtrg4s.userAxioms"},{"def_id":"wqsa0gay","display_kind":"axiom","file_id":"e3dtrg4s","kind":"axiom","local_name":"user_axioms_auth","qualified_name":"e3dtrg4s.user_axioms_auth"}]}
