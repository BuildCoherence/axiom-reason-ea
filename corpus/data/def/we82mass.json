ummary":"Type → Prop","kind":"type","qualified_name":"mwh5b5da.RigidlyIsUnder","subexpr_pos":"/","text":"mwh5b5da.RigidlyIsUnder zvf2jw0p.CoffeeChain.At ta3nj1a4.ObjectAggregate.Is","token_id":"zvf2jw0p.CoffeeChain.Is::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.ta3nj1a4\nimport A.r59jf3ak\n\nopen scoped r59jf3ak\nopen ta3nj1a4\n\nnamespace zvf2jw0p\n\nrigid universal Person extends Object := \"person\"\nrigid universal CoffeeChain extends ObjectAggregate := \"coffee chain\"\nrigid universal BigCoffeeChain extends CoffeeChain := \"big coffee chain\"\n\nrelation Loves : Person → CoffeeChain := \"loves\"\nrelation BuysFrom : Person → CoffeeChain := \"buys from\"\n\nscoped infix:50 \" loves \" => Loves\nscoped infix:50 \" buys-from \" => BuysFrom\nscoped notation:50 entity:51 \" is-a-big-coffee-chain\" => BigCoffeeChain.Is entity\n\nsyntax:50 term:51 \" never-buys-from \" term:51 : term\nscoped macro_rules\n  | `($person:term never-buys-from $kind:term) =>\n      `(∀ chain : $kind, ¬ ($person buys-from chain))\n\ndef Sam : Type := \"@sam\"\ndef Starbucks : Type := \"Starbucks\"\n\ntheorem starbucks_enthymeme_is_contradictory\n    (p1 : Sam loves Starbucks)\n    (p2 : Sam never-buys-from BigCoffeeChain)\n    (p3 : Starbucks is-a-big-coffee-chain)\n    (p4 : ∀ person coffeeChain,\n      person loves coffeeChain → person buys-from coffeeChain) :\n    False := by\n  let sam : Person := ⟨Sam, p1.inst0⟩\n  let starbucks : CoffeeChain := ⟨Starbucks, p1.inst1⟩\n  let bigStarbucks : BigCoffeeChain := ⟨Starbucks, p3⟩\n  exact p2 bigStarbucks (p4 sam starbucks p1)\n\nend zvf2jw0p\n","members":[],"source_lines":{"end":11,"start":11},"theorem_statement":null},"referenced_by":[{"def_id":"hys0m6hp","display_kind":"definition","file_id":"zvf2jw0p","kind":"definition","local_name":"BigCoffeeChain.Is","qualified_name":"zvf2jw0p.BigCoffeeChain.Is"},{"def_id":"v252sgh6","display_kind":"definition","file_id":"zvf2jw0p","kind":"definition","local_name":"BuysFrom","qualified_name":"zvf2jw0p.BuysFrom"},{"def_id":"ge765v7t","display_kind":"definition","file_id":"zvf2jw0p","kind":"definition","local_name":"CoffeeChain","qualified_name":"zvf2jw0p.CoffeeChain"},{"def_id":"bt7rpadd","display_kind":"definition","file_id":"zvf2jw0p","kind":"definition","local_name":"Loves","qualified_name":"zvf2jw0p.Loves"},{"def_id":"zz9pzdfb","display_kind":"theorem","file_id":"zvf2jw0p","kind":"theorem","local_name":"starbucks_enthymeme_is_contradictory","qualified_name":"zvf2jw0p.starbucks_enthymeme_is_contradictory"}]}
