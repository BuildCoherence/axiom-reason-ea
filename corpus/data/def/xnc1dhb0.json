y":null,"kind":"identifier","qualified_name":null,"text":"m","token_id":"pv802k7b.PersonsHaveExactlyOneMoralCharacter::src::43","token_role":null},{"binder_role":"use_site","byte_end":1419,"byte_start":1418,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"notation","qualified_name":"Eq","text":"=","token_id":"pv802k7b.PersonsHaveExactlyOneMoralCharacter::src::44","token_role":null},{"binder_role":"use_site","byte_end":1422,"byte_start":1420,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"m'","token_id":"pv802k7b.PersonsHaveExactlyOneMoralCharacter::src::45","token_role":null}],"type_tokens":{"author":null,"empty":{"child":{"node":"text","text":"Prop"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Prop","token_id":"pv802k7b.PersonsHaveExactlyOneMoralCharacter::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\nimport A.j12bzjgj\nimport A.azt4989z\n\nopen j12bzjgj\nopen azt4989z\nopen t0d1zdc3\nopen gwcwyrvb\nopen c424c6bg\n\nopen BFO\n\nnamespace pv802k7b\n\nrigid universal MoralCharacter extends Quality := \"moral character\"\n\nrelation Immoral : Person := \"is immoral\"\nrelation HasMoralCharacter : Person → MoralCharacter := \"has moral character\"\nrelation MoreMoralThan : MoralCharacter → MoralCharacter := \"is more moral than\"\n\npostfix:max \" is-immoral\" => Immoral\ninfix:50 \" has-moral-character \" => HasMoralCharacter\ninfix:50 \" more-moral-than \" => MoreMoralThan\n\nabbrev LessMoralThan (a b : Type) : Prop := MoreMoralThan b a\n\ninfix:50 \" less-moral-than \" => LessMoralThan\n\nstructure MoralComparisonIsCoherent : Prop where\n  more_moral_irreflexive : ∀ m : MoralCharacter, ¬ (m more-moral-than m)\n  more_moral_transitive :\n    ∀ a b c : MoralCharacter,\n      a more-moral-than b → b more-moral-than c → a more-moral-than c\n\ndef ImmoralBelowNonImmoral : Prop :=\n  ∀ (p q : Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend pv802k7b\n","members":[{"conclusion_prop":"fxh1ep29","def_id":"j5xjc124","display_kind":"field","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.has_one","qualified_name":"pv802k7b.PersonsHaveExactlyOneMoralCharacter.has_one"},{"def_id":"y882ssz1","display_kind":"constructor","kind":"constructor","local_name":"PersonsHaveExactlyOneMoralCharacter.mk","qualified_name":"pv802k7b.PersonsHaveExactlyOneMoralCharacter.mk"},{"conclusion_prop":"s2w7h4ew","def_id":"dj9993n7","display_kind":"field","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.at_most_one","qualified_name":"pv802k7b.PersonsHaveExactlyOneMoralCharacter.at_most_one"}],"source_lines":{"end":47,"start":43},"theorem_statement":null},"referenced_by":[{"def_id":"dj9993n7","display_kind":"field","file_id":"pv802k7b","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.at_most_one","qualified_name":"pv802k7b.PersonsHaveExactlyOneMoralCharacter.at_most_one"},{"def_id":"j5xjc124","display_kind":"field","file_id":"pv802k7b","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.has_one","qualified_name":"pv802k7b.PersonsHaveExactlyOneMoralCharacter.has_one"}]}
