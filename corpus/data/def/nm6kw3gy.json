,"kind":"identifier","qualified_name":null,"text":"p2Character","token_id":"mhhv9dpt.TwoPeopleDifferingInWealth::src::35","token_role":null},{"binder_role":"def_site","byte_end":3135,"byte_start":3121,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"stdlib","proposition_id":"nnxpmjcs","qualified_name":"mhhv9dpt.TwoPeopleDifferingInWealth.all_else_equal","text":"all_else_equal","token_id":"mhhv9dpt.TwoPeopleDifferingInWealth::src::36","token_role":null},{"binder_role":null,"byte_end":3137,"byte_start":3136,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"mhhv9dpt.TwoPeopleDifferingInWealth::src::37","token_role":null},{"binder_role":"use_site","byte_end":3140,"byte_start":3138,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"p1","token_id":"mhhv9dpt.TwoPeopleDifferingInWealth::src::38","token_role":null},{"binder_role":"use_site","byte_end":3173,"byte_start":3141,"def_id":"deg4s2w6","hover_kind":"term","inlined_type_summary":null,"kind":"notation","qualified_name":"mhhv9dpt.SameCircumstancesExceptWealth","text":"same-circumstances-except-wealth","token_id":"mhhv9dpt.TwoPeopleDifferingInWealth::src::39","token_role":null},{"binder_role":"use_site","byte_end":3176,"byte_start":3174,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"text":"p2","token_id":"mhhv9dpt.TwoPeopleDifferingInWealth::src::40","token_role":null}],"type_tokens":{"author":{"child":{"node":"text","text":"Type 1"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 2","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Type 1","token_id":"mhhv9dpt.TwoPeopleDifferingInWealth::author/type::0","token_role":null}},"empty":{"child":{"node":"text","text":"Type 1"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 2","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Type 1","token_id":"mhhv9dpt.TwoPeopleDifferingInWealth::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.ta3nj1a4\nimport A.r59jf3ak\nimport A.fs83ayjj\n\nopen ta3nj1a4\nopen r59jf3ak\nopen fs83ayjj\n\nopen t0d1zdc3\n\nnamespace mhhv9dpt\n\nrelation Rich : Person \"is rich\"\n\nrelation TallestPerson : \"the tallest person is\" Person\n\nrelation Poor : Person \"is poor\"\n\nrelation AgeInYears : Person \"is\" Nat \"years old at\" TemporalInstant\n\nscoped postfix:max \" is-rich\" => Rich\n\nvariable {P Q : Person → Prop}\n\ntheorem weakening : (∀ x, Q x) → (∀ x, P x → Q x) := by\n  intro h x\n  exact fun px => h x\n\ndef EveryRichPersonIsImmoral : Prop :=\n  ∀ p : Person, p is-rich → p is-immoral\n\ndef NotEveryRichPersonIsImmoral : Prop :=\n  ¬ EveryRichPersonIsImmoral\n\ndef SomeRichPersonIsNotImmoral : Prop :=\n  ∃ p : Person, p is-rich ∧ ¬ (p is-immoral)\n\ndef DollyParton : Type := \"Dolly Parton\"\n\ndef DollyPartonIsRichAndNotImmoral : Prop :=\n  DollyParton is-rich ∧ ¬ (DollyParton is-immoral)\n\ndef JeffreyEpstein : Type := \"Jeffrey Epstein\"\n\ndef JeffreyEpsteinIsRichAndImmoral : Prop :=\n  JeffreyEpstein is-rich ∧ JeffreyEpstein is-immoral\n\ndef EveryPersonIsImmoral : Prop :=\n  ∀ p : Person, p is-immoral\n\ndef OnlyRichPeopleAreImmoral : Prop :=\n  ∀ p : Person, p is-immoral → p is-rich\n\ntheorem named_counterexample_refutes\n    (h : DollyPartonIsRichAndNotImmoral)\n  : SomeRichPersonIsNotImmoral :=\n  ⟨⟨DollyParton, Rich.inst0 h.1⟩, h.1, h.2⟩\n\ntheorem some_refutes_every\n    (h : SomeRichPersonIsNotImmoral)\n  : NotEveryRichPersonIsImmoral :=\n  fun every => h.elim fun p hp => hp.2 (every p hp.1)\n\ntheorem not_every_means_some\n    (h : NotEveryRichPersonIsImmoral) : SomeRichPersonIsNotImmoral :=\n  Classical.byContradiction fun no_counterexample =>\n    h fun p rich =>\n      Classical.byContradiction fun not_immoral =>\n        no_counterexample ⟨p, rich, not_immoral⟩\n\ntheorem everyone_immoral_confirms_the_claim\n    (everyone : EveryPersonIsImmoral) : EveryRichPersonIsImmoral :=\n  fun p _ => everyone p\n\ntheorem everyone_immoral_rejects_only_rich\n    (everyone : EveryPersonIsImmoral)\n    (someone_not_rich : ∃ p : Person, ¬ (p is-rich)) :\n    ¬ OnlyRichPeopleAreImmoral :=\n  fun only_rich => someone_not_rich.elim fun p not_rich =>\n    not_rich (only_rich p (everyone p))\n\ntheorem disagreement_is_contradiction\n    (logic_is_actual : LogicIsActual)\n    (every : A EveryRichPersonIsImmoral)\n    (some_not : A SomeRichPersonIsNotImmoral) : False :=\n  logic_is_actual.consistency\n    (logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _ some_refutes_every)\n        some_not)\n      every)\n\nrelation SameCircumstancesExceptWealth : Person → Person :=\n  \"has the same morally relevant circumstances except wealth as\"\n\nscoped infix:50 \" same-circumstances-except-wealth \" => SameCircumstancesExceptWealth\n\nstructure TwoPeopleDifferingInWealth where\n  p1 : Person\n  p2 : Person\n  p1Character : MoralCharacter\n  p2Character : MoralCharacter\n  p1_is_rich : p1 is-rich\n  p2_is_not : ¬ (p2 is-rich)\n  p1_has_character : p1 has-moral-character p1Character\n  p2_has_character : p2 has-moral-character p2Character\n  all_else_equal : p1 same-circumstances-except-wealth p2\n\ndef AllElseEqualTheRichPersonIsLessMoral : Prop :=\n  ∀ s : TwoPeopleDifferingInWealth, s.p1Character less-moral-than s.p2Character\n\ntheorem immoral_non_rich_twin_makes_rich_twin_immoral\n    (coherent : MoralComparisonIsCoherent)\n    (immoral_below : ImmoralBelowNonImmoral)\n    (rich_less_moral : AllElseEqualTheRichPersonIsLessMoral)\n    (s : TwoPeopleDifferingInWealth)\n    (immoral : s.p2 is-immoral) :\n    s.p1 is-immoral :=\n  Classical.byContradiction fun not_immoral =>\n    more_moral_asymmetric coherent s.p2Character s.p1Character\n      (rich_less_moral s)\n      (immoral_below s.p2 s.p1 s.p2Character s.p1Character\n        s.p2_has_character s.p1_has_character\n        immoral not_immoral)\n\nend mhhv9dpt\n","members":[{"def_id":"sbp94yew","display_kind":"constructor","kind":"constructor","local_name":"TwoPeopleDifferingInWealth.mk","qualified_name":"mhhv9dpt.TwoPeopleDifferingInWealth.mk"},{"def_id":"s0p0nbv5","display_kind":"field","kind":"definition","local_name":"TwoPeopleDifferingInWealth.p1","qualified_name":"mhhv9dpt.TwoPeopleDifferingInWealth.p1"},{"def_id":"c7fszsnz","display_kind":"field","kind":"definition","local_name":"TwoPeopleDifferingInWealth.p2","qualified_name":"mhhv9dpt.TwoPeopleDifferingInWealth.p2"},{"def_id":"jrx6yf2r","display_kind":"field","kind":"definition","local_name":"TwoPeopleDifferingInWealth.p1Character","qualified_name":"mhhv9dpt.TwoPeopleDifferingInWealth.p1Character"},{"def_id":"m1ywsnqq","display_kind":"field","kind":"definition","local_name":"TwoPeopleDifferingInWealth.p2Character","qualified_name":"mhhv9dpt.TwoPeopleDifferingInWealth.p2Character"},{"conclusion_prop":"exjrwt7e","def_id":"khpr66c7","display_kind":"field","kind":"theorem","local_name":"TwoPeopleDifferingInWealth.p1_is_rich","qualified_name":"mhhv9dpt.TwoPeopleDifferingInWealth.p1_is_rich"},{"conclusion_prop":"npvhk23n","def_id":"pqqntjxc","display_kind":"field","kind":"theorem","local_name":"TwoPeopleDifferingInWealth.p2_is_not","qualified_name":"mhhv9dpt.TwoPeopleDifferingInWealth.p2_is_not"},{"conclusion_prop":"mv986tzw","def_id":"msm65ey1","display_kind":"field","kind":"theorem","local_name":"TwoPeopleDifferingInWealth.p1_has_character","qualified_name":"mhhv9dpt.TwoPeopleDifferingInWealth.p1_has_character"},{"conclusion_prop":"x790ykkn","def_id":"zz6p6m8j","display_kind":"field","kind":"theorem","local_name":"TwoPeopleDifferingInWealth.p2_has_character","qualified_name":"mhhv9dpt.TwoPeopleDifferingInWealth.p2_has_character"},{"conclusion_prop":"nnxpmjcs"