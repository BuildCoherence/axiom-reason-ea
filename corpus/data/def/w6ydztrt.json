ildren":[{"child":{"node":"text","text":"mbsxqzvd.P3"},"node":"tag","tag":{"binder_role":"use_site","def_id":"n3r2zh7t","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"mbsxqzvd.P3","subexpr_pos":"/0/1/0/1","text":"mbsxqzvd.P3","token_id":"mbsxqzvd.no_eat_meat::empty/value::4","token_role":null}},{"node":"text","text":" ∧ "},{"child":{"node":"text","text":"mbsxqzvd.P4"},"node":"tag","tag":{"binder_role":"use_site","def_id":"kdx515nb","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"mbsxqzvd.P4","subexpr_pos":"/0/1/1","text":"mbsxqzvd.P4","token_id":"mbsxqzvd.no_eat_meat::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"And","subexpr_pos":"/0/1","text":"mbsxqzvd.P3 ∧ mbsxqzvd.P4","token_id":"mbsxqzvd.no_eat_meat::empty/value::3","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"And","subexpr_pos":"/0","text":"mbsxqzvd.C1 ∧ mbsxqzvd.P3 ∧ mbsxqzvd.P4","token_id":"mbsxqzvd.no_eat_meat::empty/value::1","token_role":null}},{"node":"text","text":" → "},{"child":{"node":"text","text":"mbsxqzvd.C2"},"node":"tag","tag":{"binder_role":"use_site","def_id":"qrmvqfj7","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"mbsxqzvd.C2","subexpr_pos":"/1","text":"mbsxqzvd.C2","token_id":"mbsxqzvd.no_eat_meat::empty/value::6","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"mbsxqzvd.C1 ∧ mbsxqzvd.P3 ∧ mbsxqzvd.P4 → mbsxqzvd.C2","token_id":"mbsxqzvd.no_eat_meat::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.gwcwyrvb\n\nopen gwcwyrvb\n\nnamespace mbsxqzvd\n\n-- https://reddit.com/r/askphilosophy/comments/g2002v/\n\ndef P1 := A (\"we have a duty to perfect our moral character\" : Prop)\ndef P2 := A (\"when we mistreat animals, we corrupt our moral character\" : Prop)\ndef P3 := A (\"exploiting animals for commercial gain is mistreating them\" : Prop)\ndef P4 := A (\"eating meat exploits animals for commercial gain\" : Prop)\ndef C1 := A (\"we mustn't mistreat animals\" : Prop)\ndef C2 := A (\"we mustn't eat meat\" : Prop)\n\ndef no_mistreat : Prop := P1 ∧ P2 → C1\n\ndef no_eat_meat : Prop := C1 ∧ P3 ∧ P4 → C2\n\ntheorem c1_by_modus_ponens\n    (p1 : P1) (p2 : P2) (no_mistreat_bridge : no_mistreat)\n  : C1 :=\n  no_mistreat_bridge ⟨p1, p2⟩\n\ntheorem must_not_eat_meat\n    (p1 : P1) (p2 : P2) (no_mistreat_bridge : no_mistreat)\n    (p3 : P3) (p4 : P4) (no_eat_meat_bridge : no_eat_meat)\n  : C2 :=\n  no_eat_meat_bridge ⟨c1_by_modus_ponens p1 p2 no_mistreat_bridge, p3, p4⟩\n\nend mbsxqzvd\n","members":[],"source_lines":{"end":19,"start":19},"theorem_statement":null},"referenced_by":[{"def_id":"smpgxsjc","display_kind":"theorem","file_id":"mbsxqzvd","kind":"theorem","local_name":"must_not_eat_meat","qualified_name":"mbsxqzvd.must_not_eat_meat"}]}
