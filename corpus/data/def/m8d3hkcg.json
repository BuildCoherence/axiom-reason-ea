ves_decision_making\", clearer_thought_improves_decision_making), (\"better_decision_making_enables_effective_choice\", better_decision_making_enables_effective_choice), (\"effective_choice_is_greater_potential\", effective_choice_is_greater_potential), (\"god_is_good\", god_is_good), (\"all_people_are_immoral\", all_people_are_immoral), (\"i_am_a_person\", i_am_a_person), (\"metabias_is_a_person\", metabias_is_a_person), (\"everyone_makes_mistakes\", everyone_makes_mistakes)]\n\naxiom user_axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1784339390)\n\ndef userAxioms : UserAxioms \"sam\" 1784339390 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend wwqc19pp\n","members":[],"source_lines":{"end":25,"start":25},"theorem_statement":null},"referenced_by":[{"def_id":"pdn2rhk2","display_kind":"definition","file_id":"d26agzaz","kind":"definition","local_name":"effective_choice_is_greater_potential","qualified_name":"d26agzaz.effective_choice_is_greater_potential"},{"def_id":"z7e07q2q","display_kind":"definition","file_id":"h3cfdqwq","kind":"definition","local_name":"effective_choice_is_greater_potential","qualified_name":"h3cfdqwq.effective_choice_is_greater_potential"},{"def_id":"nee7te3g","display_kind":"definition","file_id":"h8b5ehpf","kind":"definition","local_name":"effective_choice_is_greater_potential","qualified_name":"h8b5ehpf.effective_choice_is_greater_potential"},{"def_id":"a0x8st1e","display_kind":"definition","file_id":"s593tfe3","kind":"definition","local_name":"effective_choice_is_greater_potential","qualified_name":"s593tfe3.effective_choice_is_greater_potential"},{"def_id":"r7r4p74b","display_kind":"definition","file_id":"t9e0stky","kind":"definition","local_name":"effective_choice_is_greater_potential","qualified_name":"t9e0stky.effective_choice_is_greater_potential"},{"def_id":"wagbn04r","display_kind":"definition","file_id":"td0atmnm","kind":"definition","local_name":"effective_choice_is_greater_potential","qualified_name":"td0atmnm.effective_c