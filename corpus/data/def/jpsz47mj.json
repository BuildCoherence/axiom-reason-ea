1/1/1/1/1/1","text":"(And.left hp)","token_id":"mhhv9dpt.some_refutes_every::empty/value::13","token_role":null}},{"node":"text","text":")"}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1/1/1/1","text":"(every p (And.left hp))","token_id":"mhhv9dpt.some_refutes_every::empty/value::10","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"False","kind":"stdlib","qualified_name":"And.right","subexpr_pos":"/1/1/1/1/1","text":"And.right hp (every p (And.left hp))","token_id":"mhhv9dpt.some_refutes_every::empty/value::8","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"∀ (p : fs83ayjj.Person), (Subtype.val p) is-rich ∧ ¬(Subtype.val p) is-immoral → False","kind":"op","qualified_name":null,"subexpr_pos":"/1/1/1","text":"fun p hp => And.right hp (every p (And.left hp))","token_id":"mhhv9dpt.some_refutes_every::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"False","kind":"stdlib","qualified_name":"Exists.elim","subexpr_pos":"/1/1","text":"Exists.elim h fun p hp => And.right hp (every p (And.left hp))","token_id":"mhhv9dpt.some_refutes_every::empty/value::3","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"mhhv9dpt.SomeRichPersonIsNotImmoral → mhhv9dpt.EveryRichPersonIsImmoral → False","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun h every => Exists.elim h fun p hp => And.right hp (every p (And.left hp))","token_id":"mhhv9dpt.some_refutes_every::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.ta3nj1a4\nimport A.r59jf3ak\nimport A.fs83ayjj\n\nopen ta3nj1a4\nopen r59jf3ak\nopen fs83ayjj\n\nopen t0d1zdc3\n\nnamespace mhhv9dpt\n\nrelation Rich : Person \"is rich\"\n\nrelation TallestPerson : \"the tallest person is\" Person\n\nrelation Poor : Person \"is poor\"\n\nrelation AgeInYears : Person \"is\" Nat \"years old at\" TemporalInstant\n\nscoped postfix:max \" is-rich\" => Rich\n\nvariable {P Q : Person → Prop}\n\ntheorem weakening : (∀ x, Q x) → (∀ x, P x → Q x) := by\n  intro h x\n  exact fun px => h x\n\ndef EveryRichPersonIsImmoral : Prop :=\n  ∀ p : Person, p is-rich → p is-immoral\n\ndef NotEveryRichPersonIsImmoral : Prop :=\n  ¬ EveryRichPersonIsImmoral\n\ndef SomeRichPersonIsNotImmoral : Prop :=\n  ∃ p : Person, p is-rich ∧ ¬ (p is-immoral)\n\ndef DollyParton : Type := \"Dolly Parton\"\n\ndef DollyPartonIsRichAndNotImmoral : Prop :=\n  DollyParton is-rich ∧ ¬ (DollyParton is-immoral)\n\ndef JeffreyEpstein : Type := \"Jeffrey Epstein\"\n\ndef JeffreyEpsteinIsRichAndImmoral : Prop :=\n  JeffreyEpstein is-rich ∧ JeffreyEpstein is-immoral\n\ndef EveryPersonIsImmoral : Prop :=\n  ∀ p : Person, p is-immoral\n\ndef OnlyRichPeopleAreImmoral : Prop :=\n  ∀ p : Person, p is-immoral → p is-rich\n\ntheorem named_counterexample_refutes\n    (h : DollyPartonIsRichAndNotImmoral)\n  : SomeRichPersonIsNotImmoral :=\n  ⟨⟨DollyParton, Rich.inst0 h.1⟩, h.1, h.2⟩\n\ntheorem some_refutes_every\n    (h : SomeRichPersonIsNotImmoral)\n  : NotEveryRichPersonIsImmoral :=\n  fun every => h.elim fun p hp => hp.2 (every p hp.1)\n\ntheorem not_every_means_some\n    (h : NotEveryRichPersonIsImmoral) : SomeRichPersonIsNotImmoral :=\n  Classical.byContradiction fun no_counterexample =>\n    h fun p rich =>\n      Classical.byContradiction fun not_immoral =>\n        no_counterexample ⟨p, rich, not_immoral⟩\n\ntheorem everyone_immoral_confirms_the_claim\n    (everyone : EveryPersonIsImmoral) : EveryRichPersonIsImmoral :=\n  fun p _ => everyone p\n\ntheorem everyone_immoral_rejects_only_rich\n    (everyone : EveryPersonIsImmoral)\n    (someone_not_rich : ∃ p : Person, ¬ (p is-rich)) :\n    ¬ OnlyRichPeopleAreImmoral :=\n  fun only_rich => someone_not_rich.elim fun p not_rich =>\n    not_rich (only_rich p (everyone p))\n\ntheorem disagreement_is_contradiction\n    (logic_is_actual : LogicIsActual)\n    (every : A EveryRichPersonIsImmoral)\n    (some_not : A SomeRichPersonIsNotImmoral) : False :=\n  logic_is_actual.consistency\n    (logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _ some_refutes_every)\n        some_not)\n      every)\n\nrelation SameCircumstancesExceptWealth : Person → Person :=\n  \"has the same morally relevant circumstances except wealth as\"\n\nscoped infix:50 \" same-circumstances-except-wealth \" => SameCircumstancesExceptWealth\n\nstructure TwoPeopleDifferingInWealth where\n  p1 : Person\n  p2 : Person\n  p1Character : MoralCharacter\n  p2Character : MoralCharacter\n  p1_is_rich : p1 is-rich\n  p2_is_not : ¬ (p2 is-rich)\n  p1_has_character : p1 has-moral-character p1Character\n  p2_has_character : p2 has-moral-character p2Character\n  all_else_equal : p1 same-circumstances-except-wealth p2\n\ndef AllElseEqualTheRichPersonIsLessMoral : Prop :=\n  ∀ s : TwoPeopleDifferingInWealth, s.p1Character less-moral-than s.p2Character\n\ntheorem immoral_non_rich_twin_makes_rich_twin_immoral\n    (coherent : MoralComparisonIsCoherent)\n    (immoral_below : ImmoralBelowNonImmoral)\n    (rich_less_moral : AllElseEqualTheRichPersonIsLessMoral)\n    (s : TwoPeopleDifferingInWealth)\n    (immoral : s.p2 is-immoral) :\n    s.p1 is-immoral :=\n  Classical.byContradiction fun not_immoral =>\n    more_moral_asymmetric coherent s.p2Character s.p1Character\n      (rich_less_moral s)\n      (immoral_below s.p2 s.p1 s.p2Character s.p1Character\n        s.p2_has_character s.p1_has_character\n        immoral not_immoral)\n\nend mhhv9dpt\n","members":[],"source_lines":{"end":65,"start":62},"theorem_statement":{"conclusion":{"author_byte_range":{"end":1502,"start":1475},"name":null,"proposition_id":"t2xtdh9k","tokens":{"author":{"child":{"node":"text","text":"NotEveryRichPersonIsImmoral"},"node":"tag","tag":{"binder_role":"use_site","def_id":"r4pmxskt","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"mhhv9dpt.NotEveryRichPersonIsImmoral","subexpr_pos":"/","text":"NotEveryRichPersonIsImmoral","token_id":"mhhv9dpt.some_refutes_every::author/conclusion::0","token_role":null}},"empty":{"child":{"node":"text","text":"mhhv9dpt.NotEveryRichPersonIsImmoral"},"node":"tag","tag":{"binder_role":"use_site","def_id":"r4pmxskt","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"mhhv9dpt.NotEveryRichPersonIsImmoral","subexpr_pos":"/","text":"mhhv9dpt.NotEveryRichPersonIsImmoral","token_id":"mhhv9dpt.some_refutes_every::empty/conclusion::0","token_role":null}}}},"premises":[{"author_byte_range":{"end":1469,"start":1443},"name":"h","proposition_id":"y35whf42","tokens":{"author":{"child":{"node":"text","text":"SomeRichPersonIsNotImmoral"},"node":"tag","tag":{"binder_role":"use_site","def_id":"k0ags2v1","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"mhhv9dpt.SomeRichPersonIsNotImmoral","subexpr_pos":"/","text":"SomeRichPersonIsNotImmoral","token_id":"mhhv9dpt.some_refutes_every::author/premise::0","token_role":null}},"empty":{"child":{"node":"text","text":"mhhv9dpt.SomeRichPersonIsNotImmoral"},"node":"tag","tag":{"binder_role":"use_site","def_id":"k0ags2v1","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"mhhv9dpt.SomeRichPersonIsNotImmoral","subexpr_pos":"/","text":"mhhv9dpt.SomeRichPersonIsNotImmoral","token_id":"mhhv9dpt.some_refutes_every::empty/premise::0","token_role":null}}}}]}},"referenced_by":[{"def_id":"ctvbtad9","display_kind":"theorem","file_id":"mhhv9dpt","kind":"theorem","local_name":"disagreement_is_contradiction","qualified_name":