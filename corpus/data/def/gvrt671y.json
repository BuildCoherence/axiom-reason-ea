ry":null,"kind":"identifier","qualified_name":null,"text":"c","token_id":"pv802k7b.MoralComparisonIsCoherent::src::37","token_role":null}],"type_tokens":{"author":null,"empty":{"child":{"node":"text","text":"Prop"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Prop","token_id":"pv802k7b.MoralComparisonIsCoherent::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\nimport A.j12bzjgj\nimport A.azt4989z\n\nopen j12bzjgj\nopen azt4989z\nopen t0d1zdc3\nopen gwcwyrvb\nopen c424c6bg\n\nopen BFO\n\nnamespace pv802k7b\n\nrigid universal MoralCharacter extends Quality := \"moral character\"\n\nrelation Immoral : Person := \"is immoral\"\nrelation HasMoralCharacter : Person → MoralCharacter := \"has moral character\"\nrelation MoreMoralThan : MoralCharacter → MoralCharacter := \"is more moral than\"\n\npostfix:max \" is-immoral\" => Immoral\ninfix:50 \" has-moral-character \" => HasMoralCharacter\ninfix:50 \" more-moral-than \" => MoreMoralThan\n\nabbrev LessMoralThan (a b : Type) : Prop := MoreMoralThan b a\n\ninfix:50 \" less-moral-than \" => LessMoralThan\n\nstructure MoralComparisonIsCoherent : Prop where\n  more_moral_irreflexive : ∀ m : MoralCharacter, ¬ (m more-moral-than m)\n  more_moral_transitive :\n    ∀ a b c : MoralCharacter,\n      a more-moral-than b → b more-moral-than c → a more-moral-than c\n\ndef ImmoralBelowNonImmoral : Prop :=\n  ∀ (p q : Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend pv802k7b\n","members":[{"def_id":"e24fnxr1","display_kind":"constructor","kind":"constructor","local_name":"MoralComparisonIsCoherent.mk","qualified_name":"pv802k7b.MoralComparisonIsCoherent.mk"},{"conclusion_prop":"bwsmsfrh","def_id":"ajsxyb3f","display_kind":"field","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_irreflexive","qualified_name":"pv802k7b.MoralComparisonIsCoherent.more_moral_irreflexive"},{"conclusion_prop":"aj7928sf","def_id":"s5d6mykv","display_kind":"field","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_transitive","qualified_name":"pv802k7b.MoralComparisonIsCoherent.more_moral_transitive"}],"source_lines":{"end":33,"start":29},"theorem_statement":null},"referenced_by":[{"def_id":"ajsxyb3f","display_kind":"field","file_id":"pv802k7b","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_irreflexive","qualified_name":"pv802k7b.MoralComparisonIsCoherent.more_moral_irreflexive"},{"def_id":"s5d6mykv","display_kind":"field","file_id":"pv802k7b","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_transitive","qualified_name":"pv802k7b.MoralComparisonIsCoherent.more_moral_transitive"},{"def_id":"nwgnd5kf","display_kind":"theorem","file_id":"pv802k7b","kind":"theorem","local_name":"more_moral_asymmetric","qualified_name":"pv802k7b.more_moral_asymmetric"},{"def_id":"dq2vr0pn","display_kind":"theorem","file_id":"zk1mxe7x","kind":"theorem","local_name":"immoral_non_rich_twin_makes_rich_twin_immoral","qualified_name":"zk1mxe7x.immoral_non_rich_twin_makes_rich_twin_immoral"}]}
