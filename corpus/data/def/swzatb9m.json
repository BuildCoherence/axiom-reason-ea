r_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"op","qualified_name":null,"subexpr_pos":"/1/1/1","text":"Prop","token_id":"mwh5b5da.UniversalAt::empty/type::4","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Type → Type → Type → Prop","token_id":"mwh5b5da.UniversalAt::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import A.vpg72gwr\n\nopen vpg72gwr.BFO\n\nnamespace mwh5b5da\n\n/-- `x` is an instance of universal `u` at time `t`. -/\nclass UniversalAt (u x t : Type) : Prop where\n  mem : InstanceOf x u t\n\n/-- Instance of `u` at `t`, and of its parent (via `parentAt`) at `t`. -/\nclass UniversalAtUnder (u : Type) (parentAt : Type → Type → Prop) (x t : Type) : Prop where\n  mem : InstanceOf x u t\n  parent : parentAt x t\n\n/-- `x` is rigidly an instance of the universal with At-predicate `atPred`. -/\nclass RigidlyIs (atPred : Type → Type → Prop) (x : Type) : Prop where\n  mem : ∀ t : Type, InstanceOf t TemporalRegion t → ExistsAt x t → atPred x t\n\n/-- Rigid membership, plus rigid membership in the parent (via `parentIs`). -/\nclass RigidlyIsUnder (atPred : Type → Type → Prop) (parentIs : Type → Prop) (x : Type) : Prop where\n  mem : ∀ t : Type, InstanceOf t TemporalRegion t → ExistsAt x t → atPred x t\n  parent : parentIs x\n\nend mwh5b5da\n","members":[{"conclusion_prop":"bgy5gezy","def_id":"s8y47ym5","display_kind":"field","kind":"theorem","local_name":"UniversalAt.mem","qualified_name":"mwh5b5da.UniversalAt.mem"},{"def_id":"et4f5c67","display_kind":"constructor","kind":"constructor","local_name":"UniversalAt.mk","qualified_name":"mwh5b5da.UniversalAt.mk"}],"source_lines":{"end":9,"start":7},"theorem_statement":null},"referenced_by":[{"def_id":"ytk7qwcz","display_kind":"definition","file_id":"d4qbfhxh","kind":"definition","local_name":