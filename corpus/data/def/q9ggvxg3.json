64c.CapabilityRoute → Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun r =>\n  e50am64c.CapabilityRoute.interfaceCompatible r = true ∧\n    e50am64c.CapabilityRoute.sufficientContext r = true ∧\n      e50am64c.CapabilityRoute.provenancePresent r = true ∧ e50am64c.CapabilityRoute.localValidationPassed r = true","token_id":"e50am64c.CapabilityRouteIsPortable::empty/value::0","token_role":null}}}},"file_content":"import Axiom\n\nnamespace e50am64c\n\nstructure CapabilityRoute where\n  sourceNodeId : Nat\n  recipientNodeId : Nat\n  capabilityId : Nat\n  recipientInterfaceId : Nat\n  contextUnits : Nat\n  interfaceCompatible : Bool\n  sufficientContext : Bool\n  provenancePresent : Bool\n  localValidationPassed : Bool\n  recipientCorrectionWork : Nat\n  validatedUses : Nat\n  validatedReuseCount : Nat\n\n\ndef WellFormedCapabilityRoute (r : CapabilityRoute) : Prop :=\n  0 < r.sourceNodeId ∧\n    0 < r.recipientNodeId ∧\n    0 < r.capabilityId ∧\n    0 < r.recipientInterfaceId ∧\n    0 < r.contextUnits ∧\n    r.sourceNodeId ≠ r.recipientNodeId ∧\n    r.validatedUses ≤ r.contextUnits ∧\n    r.validatedReuseCount ≤ r.validatedUses\n\n\ndef CapabilityRouteIsPortable (r : CapabilityRoute) : Prop :=\n  r.interfaceCompatible = true ∧\n    r.sufficientContext = true ∧\n    r.provenancePresent = true ∧\n    r.localValidationPassed = true\n\n\ndef CapabilityRouteProducesValidatedUse (r : CapabilityRoute) : Prop :=\n  CapabilityRouteIsPortable r ∧\n    r.validatedUses > 0\n\n\ndef CapabilityRouteHasBoundedCorrection (r : CapabilityRoute) : Prop :=\n  r.recipientCorrectionWork ≤ r.contextUnits\n\n\ndef capability_route_interface_boundaryPayload :=\n  \"A capability route is portable only when the receiving node exposes a compatible recipient interface, receives sufficient context, receives provenance, and passes local validation. These are recorded conditions, not assumptions inferred from an interface identifier. A route is not universal access, equal competence, or proof that the receiving node internalized the capability.\"\naxiom capability_route_interface_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", capability_route_interface_boundaryPayload, 1786286160)\ndef capability_route_interface_boundary : Axiom.Statement \"hitchhiker2thefuture\" capability_route_interface_boundaryPayload 1786286160 := ⟨capability_route_interface_boundary_auth⟩\n\ndef capability_route_validated_use_boundaryPayload :=\n  \"A routed capability counts as validated use only when the receiving node produces an observable useful result after local validation. Transfer, delivery, or message receipt alone does not count as validated use.\"\naxiom capability_route_validated_use_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", capability_route_validated_use_boundaryPayload, 1786286160)\ndef capability_route_validated_use_boundary : Axiom.Statement \"hitchhiker2thefuture\" capability_route_validated_use_boundaryPayload 1786286160 := ⟨capability_route_validated_use_boundary_auth⟩\n\ndef capability_route_correction_boundaryPayload :=\n  \"Recipient correction work is a separate observable from transfer and validation. A route with a delivered signal but unmeasured correction work cannot establish lower cost, parity, or reliable reuse.\"\naxiom capability_route_correction_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", capability_route_correction_boundaryPayload, 1786286160)\ndef capability_route_correction_boundary : Axiom.Statement \"hitchhiker2thefuture\" capability_route_correction_boundaryPayload 1786286160 := ⟨capability_route_correction_boundary_auth⟩\n\ndef capability_route_reuse_boundaryPayload :=\n  \"A capability route becomes reusable evidence only when the same route or capability is used again under a recorded compatible interface and passes local validation again. A single successful transfer is not reuse reliability.\"\naxiom capability_route_reuse_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", capability_route_reuse_boundaryPayload, 1786286160)\ndef capability_route_reuse_boundary : Axiom.Statement \"hitchhiker2thefuture\" capability_route_reuse_boundaryPayload 1786286160 := ⟨capability_route_reuse_boundary_auth⟩\n\nend e50am64c\n","members":[],"source_lines":{"end":35,"start":31},"theorem_statement":null},"referenced_by":[{"def_id":"z5ymvc9q","display_kind":"definition","file_id":"e50am64c","kind":"definition","local_name":"CapabilityRouteProducesValidatedUse","qualified_name":"e50am64c.CapabilityRouteProducesValidatedUse"}]}
