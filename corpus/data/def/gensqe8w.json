_exact boundary hIrreversible\n\nend CommunicativeArithmeticGuard\n\nend j81b1gmr\n","members":[],"source_lines":{"end":21,"start":21},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"zw0epa4c","tokens":{"author":null,"empty":{"child":{"children":[{"child":{"children":[{"node":"text","text":"sizeOf "},{"child":{"node":"text","text":"j81b1gmr.CommunicativeArithmeticGuard.Backend.exact"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"j81b1gmr.CommunicativeArithmeticGuard.Backend","kind":"identifier","qualified_name":"j81b1gmr.CommunicativeArithmeticGuard.Backend.exact","subexpr_pos":"/0/1/1","text":"j81b1gmr.CommunicativeArithmeticGuard.Backend.exact","token_id":"j81b1gmr.CommunicativeArithmeticGuard.Backend.exact.sizeOf_spec::empty/conclusion::2","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Nat","kind":"identifier","qualified_name":"SizeOf.sizeOf","subexpr_pos":"/0/1","text":"sizeOf j81b1gmr.CommunicativeArithmeticGuard.Backend.exact","token_id":"j81b1gmr.CommunicativeArithmeticGuard.Backend.exact.sizeOf_spec::empty/conclusion::1","token_role":null}},{"node":"text","text":" = "},{"child":{"node":"text","text":"1"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Nat","kind":"identifier","qualified_name":"OfNat.ofNat","subexpr_pos":"/1","text":"1","token_id":"j81b1gmr.CommunicativeArithmeticGuard.Backend.exact.sizeOf_spec::empty/conclusion::3","token_role":"num_lit"}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"Eq","subexpr_pos":"/","text":"sizeOf j81b1gmr.CommunicativeArithmeticGuard.Backend.exact = 1","token_id":"j81b1gmr.CommunicativeArithmeticGuard.Backend.exact.sizeOf_spec::empty/conclusion::0","token_role":