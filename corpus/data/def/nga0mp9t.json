o _\n        (fun everyone_including h => everyone_including ⟨MetaBias, h⟩))\n      everyone_makes_mistakes)\n    i_am_a_person\n\nend kzc1ea04\n","members":[],"source_lines":{"end":50,"start":40},"theorem_statement":{"conclusion":{"author_byte_range":{"end":1229,"start":1202},"name":null,"proposition_id":"xn61tbge","tokens":{"author":{"child":{"children":[{"node":"text","text":"A "},{"child":{"children":[{"child":{"node":"text","text":"MetaBias"},"node":"tag","tag":{"binder_role":"use_site","def_id":"f6s1zv8h","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"kzc1ea04.MetaBias","subexpr_pos":"/1/1","text":"MetaBias","token_id":"kzc1ea04.metabias_makes_mistakes::author/conclusion::2","token_role":null}},{"node":"text","text":" makes-mistakes"}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"z28arf9j","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"kzc1ea04.MakesMistakes","subexpr_pos":"/1","text":"MetaBias makes-mistakes","token_id":"kzc1ea04.metabias_makes_mistakes::author/conclusion::1","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/","text":"A MetaBias makes-mistakes","token_id":"kzc1ea04.metabias_makes_mistakes::author/conclusion::0","token_role":null}},"empty":{"child":{"children":[{"node":"text","text":"Axiom.Actual "},{"child":{"children":[{"node":"text","text":"(kzc1ea04.MakesMistakes "},{"child":{"node":"text","text":"kzc1ea04.MetaBias"},"node":"tag","tag":{"binder_role":"use_site","def_id":"f6s1zv8h","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"kzc1ea04.MetaBias","subexpr_pos":"/1/1","text":"kzc1ea04.MetaBias","token_id":"kzc1ea04.metabias_makes_mistakes::empty/conclusion::2","token_role":null}},{"node":"text","text":")"}],"node":"append"},"node":"tag","tag":{"binder_ro