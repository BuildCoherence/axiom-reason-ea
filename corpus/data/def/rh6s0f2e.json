axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1784339390)\n\ndef userAxioms : UserAxioms \"sam\" 1784339390 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend wwqc19pp\n","members":[],"source_lines":{"end":28,"start":28},"theorem_statement":null},"referenced_by":[{"def_id":"pw4s49kx","display_kind":"definition","file_id":"d26agzaz","kind":"definition","local_name":"i_am_a_person","qualified_name":"d26agzaz.i_am_a_person"},{"def_id":"npd11958","display_kind":"definition","file_id":"h3cfdqwq","kind":"definition","local_name":"i_am_a_person","qualified_name":"h3cfdqwq.i_am_a_person"},{"def_id":"x02dfrkc","display_kind":"definition","file_id":"h8b5ehpf","kind":"definition","local_name":"i_am_a_person","qualified_name":"h8b5ehpf.i_am_a_person"},{"def_id":"f2wb1tsg","display_kind":"definition","file_id":"s593tfe3","kind":"definition","local_name":"i_am_a_person","qualified_name":"s593tfe3.i_am_a_person"},{"def_id":"tgk2jcfa","display_kind":"definition","file_id":"t9e0stky","kind":"definition","local_name":"i_am_a_person","qualified_name":"t9e0stky.i_am_a_person"},{"def_id":"gmgg3nc4","display_kind":"definition","file_id":"td0atmnm","kind":"definition","local_name":"i_am_a_person","qualified_name":"td0atmnm.i_am_a_person"},{"def_id":"xz8aes3w","display_kind":"definition","file_id":"wwqc19pp","kind":"definition","local_name":"userAxiomsList","qualified_name":"wwqc19pp.userAxiomsList"}]}
