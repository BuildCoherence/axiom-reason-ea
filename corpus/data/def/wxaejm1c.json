ed_name":"hmhhcnw7.HeadroomState.commitmentBurden","text":"commitmentBurden","token_id":"hmhhcnw7.HeadroomState::src::6","token_role":null},{"binder_role":null,"byte_end":106,"byte_start":105,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"hmhhcnw7.HeadroomState::src::7","token_role":null},{"binder_role":"use_site","byte_end":110,"byte_start":107,"def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"stdlib","qualified_name":"Nat","text":"Nat","token_id":"hmhhcnw7.HeadroomState::src::8","token_role":null}],"type_tokens":{"author":{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Type","token_id":"hmhhcnw7.HeadroomState::author/type::0","token_role":null}},"empty":{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Type","token_id":"hmhhcnw7.HeadroomState::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\n\nnamespace hmhhcnw7\n\nstructure HeadroomState where\n  grossCapacity : Nat\n  commitmentBurden : Nat\n\n def headroom (s : HeadroomState) : Nat :=\n  s.grossCapacity - s.commitmentBurden\n\n theorem headroom_nonnegative (s : HeadroomState) :\n    0 ≤ headroom s := by\n  exact Nat.zero_le _\n\n theorem headroom_zero_of_burden_ge_capacity\n    (s : HeadroomState)\n    (h : s.grossCapacity ≤ s.commitmentBurden) :\n    headroom s = 0 := by\n  exact Nat.sub_eq_zero_of_le h\n\n theorem headroom_positive_iff_capacity_exceeds_burden\n    (s : HeadroomState) :\n    0 < headroom s ↔ s.commitmentBurden < s.grossCapacity := by\n  simpa [headroom] using Nat.sub_pos_iff_lt\n\n def retirementHeadroomGain (releasedBurden capabilityLoss : Nat) : Nat :=\n  releasedBurden - capabilityLoss\n\n theorem safe_retirement_gain_of_burden_release\n    (releasedBurden capabilityLoss : Nat)\n    (h : capabilityLoss < releasedBurden) :\n    0 < retirementHeadroomGain releasedBurden capabilityLoss := by\n  exact Nat.sub_pos_of_lt h\n\ndef headroom_theorem_boundaryPayload := \"These theorems establish only arithmetic consequences of a natural-number headroom model. They do not prove that a real system's capacities are commensurable, that burden is fully observed, or that effective reachable futures are determined by one scalar.\"\naxiom headroom_theorem_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", headroom_theorem_boundaryPayload, 1789059159)\ndef headroom_theorem_boundary : Axiom.Statement \"hitchhiker2thefuture\" headroom_theorem_boundaryPayload 1789059159 := ⟨headroom_theorem_boundary_auth⟩\n\nend hmhhcnw7\n","members":[{"def_id":"q7g2edcq","display_kind":"field","kind":"definition","local_name":"HeadroomState.grossCapacity","qualified_name":"hmhhcnw7.HeadroomState.grossCapacity"},{"def_id":"kczf6ntf","display_kind":"constructor","kind":"constructor","local_name":"HeadroomState.mk","qualified_name":"hmhhcnw7.HeadroomState.mk"},{"def_id":"rd8qnwn3","display_kind":"field","kind":"definition","local_name":"HeadroomState.commitmentBurden","qualified_name":"hmhhcnw7.HeadroomState.commitmentBurden"}],"source_lines":{"end":7,"start":5},"theorem_statement":null},"referenced_by":[{"def_id":"x7t5mcbq","display_kind":"definition","file_id":"hmhhcnw7","kind":"definition","local_name":"headroom","qualified_name":"hmhhcnw7.headroom"},{"def_id":"eqqfvyc6","display_kind":"theorem","file_id":"hmhhcnw7","kind":"theorem","local_name":"headroom_nonnegative","qualified_name":"hmhhcnw7.headroom_nonnegative"},{"def_id":"wne1qq8f","display_kind":"theorem","file_id":"hmhhcnw7","kind":"theorem","local_name":"headroom_positive_iff_capacity_exceeds_burden","qualified_name":"hmhhcnw7.headroom_positive_iff_capacity_exceeds_burde