ed]\n  exact irreversible_boundary_requires_exact boundary hIrreversible\n\nend CommunicativeArithmeticGuard\n\nend j81b1gmr\n","members":[],"source_lines":{"end":27,"start":23},"theorem_statement":null},"referenced_by":[{"def_id":"wkm5p9es","display_kind":"definition","file_id":"j81b1gmr","kind":"definition","local_name":"CommunicativeArithmeticGuard.authorized","qualified_name":"j81b1gmr.CommunicativeArithmeticGuard.authorized"},{"def_id":"zpyqe3ep","display_kind":"theorem","file_id":"j81b1gmr","kind":"theorem","local_name":"CommunicativeArithmeticGuard.authorized_irreversible_output_is_exact","qualified_name":"j81b1gmr.CommunicativeArithmeticGuard.authorized_irreversible_output_is_exact"},{"def_id":"qk0nyrry","display_kind":"theorem","file_id":"j81b1gmr","kind":"theorem","local_name":"CommunicativeArithmeticGuard.irreversible_boundary_requires_exact","qualified_name":"j81b1gmr.CommunicativeArithmeticGuard.irreversible_boundary_requires_exact"}]}
