akes)]\n\naxiom user_axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1784857627)\n\ndef userAxioms : UserAxioms \"sam\" 1784857627 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend e3dtrg4s\n","members":[],"source_lines":{"end":30,"start":30},"theorem_statement":null},"referenced_by":[{"def_id":"a16v6dy6","display_kind":"definition","file_id":"e3dtrg4s","kind":"definition","local_name":"userAxiomsList","qualified_name":"e3dtrg4s.userAxiomsList"}]}
