d_name":null,"subexpr_pos":"/1/1/1/1/1/0/1","text":"e","token_id":"zv7tr57y.mammals_can_experience::empty/value::10","token_role":null}},{"node":"text","text":" "},{"child":{"node":"text","text":"is_mammal"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1/1/1/1","text":"is_mammal","token_id":"zv7tr57y.mammals_can_experience::empty/value::11","token_role":null}},{"node":"text","text":")"}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1/1/1","text":"(h₂ e is_mammal)","token_id":"zv7tr57y.mammals_can_experience::empty/value::8","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1/1","text":"h₁ e (h₂ e is_mammal)","token_id":"zv7tr57y.mammals_can_experience::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"zv7tr57y.CNSCanExperience → zv7tr57y.MammalsHaveCNS → ∀ (e : Type), zv7tr57y.Mammal.Is e → zv7tr57y.CanExperience e","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun h₁ h₂ e is_mammal => h₁ e (h₂ e is_mammal)","token_id":"zv7tr57y.mammals_can_experience::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t5q65xq2\nimport A.b90eedwx\nimport A.hz46pbq2\n\nopen t5q65xq2\nopen b90eedwx\nopen hz46pbq2\nopen va6mxd60\n\nnamespace zv7tr57y\n\nuniverse u\n\nopen BFO\n\nrelation Permissible : Prop := \"permissible\"\ndef Unnecessary : Sort u → Prop := \"unnecessary\"\nrelation Produces : Prop → Type := \"produces\"\n\nrelation CausesHarm : Prop := \"causes harm\"\nrelation CanExperience : Type := \"can experience\"\nrelation HasCNS : Type := \"has CNS\"\nrigid universal Mammal extends Object := \"mammal\"\nrelation CausesEnslavementOf : Prop → Type := \"causes enslavement of\"\n\ndef EnslavementHarms := ∀ p : Prop, ∀ e : Type,\n  CanExperience e → CausesEnslavementOf p e → CausesHarm p\n\ndef UnnecessaryHarmImpermissible := ∀ p : Prop,\n  CausesHarm p → Unnecessary p → ¬ Permissible p\n\ndef UnnecessaryProduction := ∀ p : Prop, (∀ product : Type,\n  Produces p product → Unnecessary product) → Unnecessary p\n\ndef AnimalAg21Cent : Prop := \"doing animal agriculture in the 21st century\"\n\ndef UnnecessaryAg := A (∀ product : Type,\n  (Produces AnimalAg21Cent product → Unnecessary product))\n\ndef AgEnslavesMammals := A (∃ e : Type, Mammal.Is e ∧ CausesEnslavementOf AnimalAg21Cent e)\n\ndef CNSCanExperience := ∀ e : Type, HasCNS e → CanExperience e\n\ndef MammalsHaveCNS := ∀ e : Type, Mammal.Is e → HasCNS e\n\ndef MammalsCanExperience := ∀ e : Type, Mammal.Is e → CanExperience e\n\ntheorem mammals_can_experience\n    (h₁ : CNSCanExperience) (h₂ : MammalsHaveCNS)\n  : MammalsCanExperience := by\n intro e\n intro is_mammal\n exact h₁ e (h₂ e is_mammal)\n\ntheorem animal_ag_impermissible\n    (logic_is_actual : LogicIsActual) (ag_unness : UnnecessaryAg) (ag_enslaves : AgEnslavesMammals)\n    (cns_can_ex : CNSCanExperience) (mammal_cns : MammalsHaveCNS)\n    (unness_harm_imperm : UnnecessaryHarmImpermissible) (unness_prod : UnnecessaryProduction)\n    (slavery_harms : EnslavementHarms)\n  : ¬ A (Permissible AnimalAg21Cent) := by\n  have mammal_ex := mammals_can_experience cns_can_ex mammal_cns\n  -- Harm: ag enslaves a mammal, mammals can experience, and enslaving an\n  -- experiencer harms. Lift that whole inference and fire it at the actual\n  -- enslavement fact (the witness stays inside the box — no Barcan needed).\n  have harm_rule :\n      (∃ e : Type, Mammal.Is e ∧ CausesEnslavementOf AnimalAg21Cent e) → CausesHarm AnimalAg21Cent :=\n    fun ⟨e, hmam, hens⟩ => slavery_harms AnimalAg21Cent e (mammal_ex e hmam) hens\n  have ag_harms : A (CausesHarm AnimalAg21Cent) :=\n    logic_is_actual.mp _ _ (logic_is_actual.actual_intro _ harm_rule) ag_enslaves\n  -- Unnecessary: everything ag produces is unnecessary, so ag is unnecessary.\n  have ag_unnecessary : A (Unnecessary AnimalAg21Cent) :=\n    logic_is_actual.mp _ _\n      (logic_is_actual.actual_intro _ (unness_prod AnimalAg21Cent)) ag_unness\n  -- Unnecessary harm is impermissible.\n  have ag_not_perm : A (¬ Permissible AnimalAg21Cent) :=\n    logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _ (unness_harm_imperm AnimalAg21Cent)) ag_harms)\n      ag_unnecessary\n  -- Were it actually permissible, that would make False actual — impossible.\n  intro ag_perm\n  exact logic_is_actual.consistency (logic_is_actual.mp _ _ ag_not_perm ag_perm)\n\nend zv7tr57y\n","members":[],"source_lines":{"end":54,"start":49},"theorem_statement":{"conclusion":{"author_byte_range":{"end":1509,"start":1489},"name":null,"proposition_id":"tqfzkmyc","tokens":{"author":{"child":{"node":"text","text":"MammalsCanExperience"},"node":"tag","tag":{"binder_role":"use_site","def_id":"necf4k72","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"zv7tr57y.MammalsCanExperience","subexpr_pos":"/","text":"MammalsCanExperience","token_id":"zv7tr57y.mammals_can_experience::author/conclusion::0","token_role":null}},"empty":{"child":{"node":"text","text":"zv7tr57y.MammalsCanExperience"},"node":"tag","tag":{"binder_role":"use_site","def_id":"necf4k72","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"zv7tr57y.MammalsCanExperience","subexpr_pos":"/","text":"zv7tr57y.MammalsCanExperience","token_id":"zv7tr57y.mammals_can_experience::empty/conclusion::0","token_role":null}}}},"premises":[{"author_byte_range":{"end":1459,"start":1443},"name":"h₁","proposition_id":"j24j3p8t","tokens":{"author":{"child":{"node":"text","text":"CNSCanExperience"},"node":"tag","tag":{"binder_role":"use_site","def_id":"k9167mn2","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"zv7tr57y.CNSCanExperience","subexpr_pos":"/","text":"CNSCanExperience","token_id":"zv7tr57y.mammals_can_experience::author/premise::0","token_role":null}},"empty":{"child":{"node":"text","text":"zv7tr57y.CNSCanExperience"},"node":"tag","tag":{"binder_role":"use_site","def_id":"k9167mn2","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"zv7tr57y.CNSCanExperience","subexpr_pos":"/","text":"zv7tr57y.CNSCanExperience","token_id":"zv7tr57y.mammals_can_experience::empty/premise::0","token_role":null}}}},{"author_byte_range":{"end":1483,"start":1469},"name":"h₂","proposition_id":"bw6dyesm","tokens":{"author":{"child":{"node":"text","text":"MammalsHaveCNS"},"node":"tag","tag":{"binder_role":"use_site","def_id":"vkb3n7aq","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"zv7tr57y.MammalsHaveCNS","subexpr_pos":"/","text":"MammalsHaveCNS","token_id":"zv7tr57y.mammals_can_experience::author/premise::0","token_role":null}},"empty":{"child":{"node":"text","text":"zv7tr57y.MammalsHaveCNS"},"node":"tag","tag":{"binder_role":"use_site","def_id":"vkb3n7aq","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"zv7tr57y.MammalsHaveCNS","subexpr_pos":"/","text":"zv7tr57y.MammalsHaveCNS","token_id":"zv7tr57y.mammals_can_experience::empty/premise::0","token_role":null}}}}]}},"referenced_by":[{"def_id":"nqday08y","display_kind":"theorem","file_id":"zv7tr57y","kind":"theorem","local_name":"animal_ag_impermissible","qualified_name":"zv7tr57y.animal_ag_impermissible"}]}
