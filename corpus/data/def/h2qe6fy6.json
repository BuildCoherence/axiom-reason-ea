ind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/1/1/1","text":"mbdw2246.Dictionary.Informs (Subtype.val o) (Subtype.val b) →\n    mbdw2246.Dictionary.Contains (Subtype.val o) p → mbdw2246.Dictionary.CorrespondTo (Subtype.val b) p","token_id":"ap91fkg6.AxiomaticThinking.ObservationsCorrespondToAProposition::empty/value::7","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"∀ (o : mbdw2246.Dictionary.Observation) (b : mbdw2246.Dictionary.Belief) (p : Prop),\n  mbdw2246.Dictionary.Informs (Subtype.val o) (Subtype.val b) →\n    mbdw2246.Dictionary.Contains (Subtype.val o) p → mbdw2246.Dictionary.CorrespondTo (Subtype.val b) p","token_id":"ap91fkg6.AxiomaticThinking.ObservationsCorrespondToAProposition::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.snz0bnpj\nimport A.azw0332y\nimport A.mbdw2246\n\nopen snz0bnpj\nopen azw0332y\nopen mbdw2246\n\nopen t0d1zdc3\nopen gwcwyrvb\nopen ActualLogic\nopen Information\nopen Dictionary\n\nnamespace ap91fkg6\n\nnamespace AxiomaticThinking\n\ntheorem actuality_not_contradictory (logic_is_actual : LogicIsActual) :\n    ∀ q : Prop, ¬ (A q ∧ A (¬ q)) := by\n  intro q hq\n  exact logic_is_actual.consistency (logic_is_actual.mp q False hq.2 hq.1)\n\ndef RealWorldBeliefsModelActuality : Prop :=\n  ∀ b : Belief, ∀ q : Prop,\n    (b is-conception-of PhysicalReality) → (b corresponds-to q) → b models (A q)\n\ntheorem empty_belief_system_resolves_contradictions\n    (k : BeliefSystem) (hk : k is-contradictory-belief-system)\n    (k' : BeliefSystem) (h' : k' is-empty-belief-system) :\n    ∃ b : Belief, k' resolves b in-belief-system k := by\n  obtain ⟨b, hib, p, hcp, hcnp⟩ := hk\n  refine ⟨b, ⟨p, hib, hcp, hcnp⟩, ?_⟩\n  rintro ⟨p', hib', _, _⟩\n  exact h' ⟨b, hib'⟩\n\ndef ObservationCanInformBelief : Prop :=\n  ∃ b : Belief, (b is-conception-of PhysicalReality) ∧ ∃ o : Observation, o informs b\n\ndef ObservationsCorrespondToAProposition : Prop :=\n  ∀ (o : Observation) (b : Belief) (p : Prop), (o informs b) → (o contains p) → (b corresponds-to p)\n\ntheorem observation_can_surface_contradiction\n    (observations_correspond_to_prop : ObservationsCorrespondToAProposition)\n    (b : Belief) (p : Prop) (hbnp : b corresponds-to ¬p)\n    (o : Observation) (hinf : o informs b) (hcont : o contains p) :\n    (b corresponds-to p) ∧ (b corresponds-to ¬p) :=\n  ⟨observations_correspond_to_prop o b p hinf hcont, hbnp⟩\n\ntheorem observation_resolves_contradiction_in_empty_system\n    (k k' : BeliefSystem) (b : Belief) (p : Prop) (o : Observation)\n    (observations_correspond_to_prop : ObservationsCorrespondToAProposition)\n    (hib : k includes b) (hbnp : b corresponds-to ¬p)\n    (hinf : o informs b) (hcont : o contains p)\n    (hempty : k' is-empty-belief-system) :\n    ∃ b' : Belief, k' resolves b' in-belief-system k := by\n  obtain ⟨hcp, _⟩ :=\n    observation_can_surface_contradiction observations_correspond_to_prop b p hbnp o hinf hcont\n  exact empty_belief_system_resolves_contradictions k ⟨b, hib, p, hcp, hbnp⟩ k' hempty\n\ntheorem observations_can_update_beliefs_if_person_chooses\n    (logic_is_actual : LogicIsActual)\n    (observations_correspond_to_prop : A ObservationsCorrespondToAProposition)\n    (per : Person)\n    (k : BeliefSystem) (b : Belief) (hib : A (k includes b))\n    (p : Prop) (hbnp : A (b corresponds-to ¬p))\n    (o : Observation) (hinf : A (o informs b)) (hcont : A (o contains p))\n    (k' : BeliefSystem) (hempty : A (k' is-empty-belief-system))\n    (hchoose : per updates-belief-system-to k') :\n    A ((∃ b' : Belief, k' resolves b' in-belief-system k) ∧ per adopts k') :=\n  let hresolve : A (∃ b' : Belief, k' resolves b' in-belief-system k) :=\n    lift_actual logic_is_actual (observation_resolves_contradiction_in_empty_system k k' b p o)\n      observations_correspond_to_prop hib hbnp hinf hcont hempty\n  actual_and logic_is_actual hresolve hchoose\n\ntheorem observations_dont_update_beliefs_if_person_doesnt_choose\n    (logic_is_actual : LogicIsActual)\n    (observations_correspond_to_prop : A ObservationsCorrespondToAProposition)\n    (per : Person)\n    (k : BeliefSystem) (b : Belief) (hib : A (k includes b))\n    (p : Prop) (hbnp : A (b corresponds-to ¬p))\n    (o : Observation) (hinf : A (o informs b)) (hcont : A (o contains p))\n    (k' : BeliefSystem) (hempty : A (k' is-empty-belief-system))\n    (hnochoose : ¬ (per updates-belief-system-to k')) :\n    A (∃ b' : Belief, k' resolves b' in-belief-system k) ∧ ¬ A (per adopts k') :=\n  ⟨lift_actual logic_is_actual (observation_resolves_contradiction_in_empty_system k k' b p o)\n      observations_correspond_to_prop hib hbnp hinf hcont hempty,\n    hnochoose⟩\n\nend AxiomaticThinking\n\nend ap91fkg6\n","members":[],"source_lines":{"end":44,"start":43},"theorem_statement":null},"referenced_by":[{"def_id":"smn7gsek","display_kind":"theorem","file_id":"ap91fkg6","kind":"theorem","local_name":"AxiomaticThinking.observation_can_surface_contradiction","qualified_name":"ap91fkg6.AxiomaticThinking.observation_can_surface_contradiction"},{"def_id":"g3vnaxaw","display_kind":"theorem","file_id":"ap91fkg6","kind":"theorem","local_name":"AxiomaticThinking.observation_resolves_contradiction_in_empty_system","qualified_name":"ap91fkg6.AxiomaticThinking.observation_resolves_contradiction_in_empty_system"},{"def_id":"kjc75qws","display_kind":"theorem","file_id":"ap91fkg6","kind":"theorem","local_name":"AxiomaticThinking.observations_can_update_beliefs_if_person_chooses","qualified_name":"ap91fkg6.AxiomaticThinking.observations_can_update_beliefs_if_person_chooses"},{"def_id":"r4ym77p8","display_kind":"theorem","file_id":"ap91fkg6","kind":"theorem","local_name":"AxiomaticThinking.observations_dont_update_beliefs_if_person_doesnt_choose","qualified_name":"ap91fkg6.AxiomaticThinking.observations_dont_update_beliefs_if_person_doesnt_choose"}]}
