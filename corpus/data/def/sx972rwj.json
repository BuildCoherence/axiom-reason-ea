cks : BigCoffeeChain := ⟨Starbucks, p3⟩\n  exact p2 bigStarbucks (p4 sam starbucks p1)\n\nend zvf2jw0p\n","members":[],"source_lines":{"end":26,"start":26},"theorem_statement":null},"referenced_by":[{"def_id":"zz9pzdfb","display_kind":"theorem","file_id":"zvf2jw0p","kind":"theorem","local_name":"starbucks_enthymeme_is_contradictory","qualified_name":"zvf2jw0p.starbucks_enthymeme_is_contradictory"}]}
