 Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend pv802k7b\n","members":[],"source_lines":{"end":15,"start":15},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"qvgv7x59","tokens":{"author":null,"empty":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"x"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"x","token_id":"pv802k7b.instCoeDepTypeMoralCharacterOfIs._proof_1::empty/conclusion::1","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/0","text":"Type","token_id":"pv802k7b.instCoeDepTypeMoralCharacterOfIs._proof_1::empty/conclusion::2","token_role":null}},{"node":"text","text":") ["},{"child":{"children":[{"node":"text","text":"pv802k7b.MoralCharacter.Is "},{"child":{"node":"text","text":"x"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/0/1","text":"x","token_id":"pv802k7b.instCoeDepTypeMoralCharacterOfIs