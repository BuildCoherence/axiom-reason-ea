s","subexpr_pos":"/1","text":"j12bzjgj.BFO.GenericallyDependentContinuant.Is","token_id":"xmafsdvf.Information.Conception.Is::empty/value::2","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"zjr13wr4","hover_kind":"term","inlined_type_summary":"Type → Prop","kind":"type","qualified_name":"c424c6bg.RigidlyIsUnder","subexpr_pos":"/","text":"c424c6bg.RigidlyIsUnder xmafsdvf.Information.Conception.At j12bzjgj.BFO.GenericallyDependentContinuant.Is","token_id":"xmafsdvf.Information.Conception.Is::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.j12bzjgj\nimport A.vpg72gwr\n\nopen t0d1zdc3\nopen gwcwyrvb\nopen j12bzjgj\nopen c424c6bg\nopen BFO\nopen vpg72gwr.BFO (Entity)\n\nnamespace xmafsdvf\n\nnamespace Information\n\nrigid universal Observer extends Object := \"observer\"\nrigid universal Conception extends GenericallyDependentContinuant := \"conception\"\nrigid universal Tool extends GenericallyDependentContinuant := \"tool\"\n\nrigid universal Information extends GenericallyDependentContinuant := \"information\"\n\nrelation ConstituentOf : Type → Type := \"is a constituent of\"\n\ndef IsACombinationOf (whole : Type) (partIs : Type → Prop) : Prop :=\n  ∃ p : Type, partIs p ∧ ConstituentOf p whole\n\nabbrev Conceptions : Type → Prop := Conception.Is\nabbrev InformationBits : Type → Prop := Information.Is\n\nrelation Observes : Observer → Type := \"observes\"\nrelation Conceptualizes : Observer → Type → Conception := \"conceptualizes into\"\nrelation HasFunction : Tool → Function := \"has function\"\n\ninfixl:50 \" observes \" => Observes\ninfixl:50 \" is-a-combination-of \" => IsACombinationOf\ninfixl:50 \" has-function \" => HasFunction\n\ndef ConceptionsOriginateFromObservations : Prop :=\n  A (∀ o : Observer, ∀ x : Type, ∀ c : Conception,\n    Entity x →\n    o observes x →\n    Conceptualizes o x c →\n    c is-a-combination-of InformationBits)\n\ndef ResultsInAProcess (x : Type) : Prop :=\n  ∃ f : Function, x has-function f ∧ ∃ p : Process, HasRealization f p\n\ndef ToolHasGeneralProperties (x : Type) : Prop :=\n  Tool.Is x ∧ x is-a-combination-of Conceptions ∧ ResultsInAProcess x\n\ndef DidNotExistBefore (x : Type) : Prop :=\n  ∃ t : Time, ExistsAt x t ∧ ∃ t₀ : Time, Precedes t₀ t ∧ ¬ ExistsAt x t₀\n\ndef Invention (x : Type) : Prop :=\n  ToolHasGeneralProperties x ∧ DidNotExistBefore x\n\nend Information\n\nend xmafsdvf\n","members":[],"source_lines":{"end":19,"start":19},"theorem_statement":null},"referenced_by":[{"def_id":"tr09s54h","display_kind":"definition","file_id":"av93fgyq","kind":"definition","local_name":"AxiomaticThinking.Belief.Is","qualified_name":"av93fgyq.AxiomaticThinking.Belief.Is"},{"def_id":"dcpqt6bt","display_kind":"definition","file_id":"xmafsdvf","kind":"definition","local_name":"Information.Conception","qualified_name":"xmafsdvf.Information.Conception"},{"def_id":"z70qa23z","display_kind":"definition","file_id":"xmafsdvf","kind":"definition","local_name":"Information.Conceptions","qualified_name":"xmafsdvf.Information.Conceptions"},{"def_id":"dgz1qf37","display_kind":"definition","file_id":"xmafsdvf","kind":"definition","local_name":"Information.ConceptionsOriginateFromObservations","qualified_name":"xmafsdvf.Information.ConceptionsOriginateFromObservations"},{"def_id":"czqz8ady","display_kind":"definition","file_id":"xmafsdvf","kind":"definition","local_name":"Information.Conceptualizes","qualified_name":"xmafsdvf.Information.Conceptualizes"},{"def_id":"jz1nqqdx","display_kind":"definition","file_id":"z85jhy92","kind":"definition","local_name":"AxiomaticThinking.Belief.Is","qualified_name":"z85jhy92.AxiomaticThinking.Belief.Is"}]}
