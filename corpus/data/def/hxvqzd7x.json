e_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/1/1/1/1/1","text":"pv802k7b.HasMoralCharacter (Subtype.val q) (Subtype.val mq) →\n      pv802k7b.Immoral (Subtype.val p) →\n        ¬pv802k7b.Immoral (Subtype.val q) → pv802k7b.MoreMoralThan (Subtype.val mq) (Subtype.val mp)","token_id":"pv802k7b.ImmoralBelowNonImmoral::empty/value::13","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/1/1/1/1","text":"pv802k7b.HasMoralCharacter (Subtype.val p) (Subtype.val mp) →\n    pv802k7b.HasMoralCharacter (Subtype.val q) (Subtype.val mq) →\n      pv802k7b.Immoral (Subtype.val p) →\n        ¬pv802k7b.Immoral (Subtype.val q) → pv802k7b.MoreMoralThan (Subtype.val mq) (Subtype.val mp)","token_id":"pv802k7b.ImmoralBelowNonImmoral::empty/value::7","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"∀ (p q : azt4989z.Person) (mp mq : pv802k7b.MoralCharacter),\n  pv802k7b.HasMoralCharacter (Subtype.val p) (Subtype.val mp) →\n    pv802k7b.HasMoralCharacter (Subtype.val q) (Subtype.val mq) →\n      pv802k7b.Immoral (Subtype.val p) →\n        ¬pv802k7b.Immoral (Subtype.val q) → pv802k7b.MoreMoralThan (Subtype.val mq) (Subtype.val mp)","token_id":"pv802k7b.ImmoralBelowNonImmoral::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.j12bzjgj\nimport A.azt4989z\n\nopen j12bzjgj\nopen azt4989z\nopen t0d1zdc3\nopen gwcwyrvb\nopen c424c6bg\n\nopen BFO\n\nnamespace pv802k7b\n\nrigid universal MoralCharacter extends Quality := \"moral character\"\n\nrelation Immoral : Person := \"is immoral\"\nrelation HasMoralCharacter : Person → MoralCharacter := \"has moral character\"\nrelation MoreMoralThan : MoralCharacter → MoralCharacter := \"is more moral than\"\n\npostfix:max \" is-immoral\" => Immoral\ninfix:50 \" has-moral-character \" => HasMoralCharacter\ninfix:50 \" more-moral-than \" => MoreMoralThan\n\nabbrev LessMoralThan (a b : Type) : Prop := MoreMoralThan b a\n\ninfix:50 \" less-moral-than \" => LessMoralThan\n\nstructure MoralComparisonIsCoherent : Prop where\n  more_moral_irreflexive : ∀ m : MoralCharacter, ¬ (m more-moral-than m)\n  more_moral_transitive :\n    ∀ a b c : MoralCharacter,\n      a more-moral-than b → b more-moral-than c → a more-moral-than c\n\ndef ImmoralBelowNonImmoral : Prop :=\n  ∀ (p q : Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend pv802k7b\n","members":[],"source_lines":{"end":41,"start":35},"theorem_statement":null},"referenced_by":[{"def_id":"dq2vr0pn","display_kind":"theorem","file_id":"zk1mxe7x","kind":"theorem","local_name":"immoral_non_rich_twin_makes_rich_twin_immoral","qualified_name":"zk1mxe7x.immoral_non_rich_twin_makes_rich_twin_immoral"}]}
