aracter\"\ndef MistreatingAnimalsCorruptsMoralCharacter : Prop :=\n  \"when we mistreat animals, we corrupt our moral character\"\ndef CommercialExploitationIsMistreatment : Prop :=\n  \"exploiting animals for commercial gain is mistreating them\"\ndef EatingMeatCommerciallyExploitsAnimals : Prop :=\n  \"eating meat exploits animals for commercial gain\"\ndef MustNotMistreatAnimals : Prop :=\n  \"we mustn't mistreat animals\"\ndef MustNotEatMeat : Prop :=\n  \"we mustn't eat meat\"\n\ndef NoMistreatBridge : Prop :=\n  DutyToPerfectMoralCharacter ∧ MistreatingAnimalsCorruptsMoralCharacter →\n    MustNotMistreatAnimals\n\ndef NoEatMeatBridge : Prop :=\n  MustNotMistreatAnimals ∧ CommercialExploitationIsMistreatment ∧\n    EatingMeatCommerciallyExploitsAnimals →\n      MustNotEatMeat\n\ntheorem actual_and (h : LogicIsActual) {p q : Prop} (hp : A p) (hq : A q) :\n    A (p ∧ q) :=\n  h.mp _ _ (h.mp _ _ (h.actual_intro _ (@And.intro p q)) hp) hq\n\ntheorem no_mistreat\n    (logic_is_actual : LogicIsActual)\n    (duty_to_perfect : A DutyToPerfectMoralCharacter)\n    (mistreating_corrupts : A MistreatingAnimalsCorruptsMoralCharacter)\n    (no_mistreat_bridge : A NoMistreatBridge)\n  : A MustNotMistreatAnimals :=\n  logic_is_actual.mp _ _ no_mistreat_bridge\n    (actual_and logic_is_actual duty_to_perfect mistreating_corrupts)\n\ntheorem no_eat_meat\n    (logic_is_actual : LogicIsActual)\n    (duty_to_perfect : A DutyToPerfectMoralCharacter)\n    (mistreating_corrupts : A MistreatingAnimalsCorruptsMoralCharacter)\n    (no_mistreat_bridge : A NoMistreatBridge)\n    (exploitation_is_mistreatment : A CommercialExploitationIsMistreatment)\n    (eating_meat_exploits : A EatingMeatCommerciallyExploitsAnimals)\n    (no_eat_meat_bridge : A NoEatMeatBridge)\n  : A MustNotEatMeat :=\n  logic_is_actual.mp _ _ no_eat_meat_bridge\n    (actual_and logic_is_actual\n      (no_mistreat logic_is_actual duty_to_perfect mistreating_corrupts\n        no_mistreat_bridge)\n      (actual_and logic_is_actual exploitation_is_mistreatment\n        eating_meat_exploits))\n\nend kqjyfmgp\n","members":[],"source_lines":{"end":36,"start":34},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"m58fkv6m","tokens":{"author":{"child":{"children":[{"node":"text","text":"∀ {"},{"child":{"node":"text","text":"p "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"p ","token_id":"kqjyfmgp.actual_and::author/conclusion::1","token_role":null}},{"child":{"node":"text","text":"q"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"q","token_id":"kqjyfmgp.actual_and::author/conclusion::2","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"Prop"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"op","qualified_name":null,"subexpr_pos":"/1/0","text":"Prop","token_id":"kqjyfmgp.actual_and::author/conclusion::3","token_role":null}},{"node":"text","text":"}, "},{"child":{"children":[{"child":{"children":[{"node":"text","text":"A "},{"child":{"node":"text","text":"p"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/0/1","text":"p","token_id":"kqjyfmgp.actual_and::author/conclusion::6","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/1/1/0","text":"A p","token_id":"kqjyfmgp.actual_and::author/conclusion::5","token_role":null}},{"node":"text","text":" → "},{"child":{"children":[{"child":{"children":[{"node":"text","text":"A "},{"chi