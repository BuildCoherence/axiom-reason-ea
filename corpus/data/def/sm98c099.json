yone_makes_mistakes : A EveryoneMakesMistakes) :\n    A (MetaBias makes-mistakes) :=\n  logic_is_actual.mp _ _\n    (logic_is_actual.mp _ _\n      (logic_is_actual.actual_intro _\n        (fun everyone_including h => everyone_including ⟨MetaBias, h⟩))\n      everyone_makes_mistakes)\n    i_am_a_person\n\nend jhcbdvn1\n","members":[],"source_lines":{"end":16,"start":16},"theorem_statement":null},"referenced_by":[{"def_id":"yxk4yea1","display_kind":"definition","file_id":"jhcbdvn1","kind":"definition","local_name":"ILackKnowledgeAndUnderstanding","qualified_name":"jhcbdvn1.ILackKnowledgeAndUnderstanding"},{"def_id":"kz3w1p1r","display_kind":"definition","file_id":"jhcbdvn1","kind":"definition","local_name":"IShouldWorkTowardCorrectingMyMistakes","qualified_name":"jhcbdvn1.IShouldWorkTowardCorrectingMyMistakes"},{"def_id":"eyv71emn","display_kind":"theorem","file_id":"jhcbdvn1","kind":"theorem","local_name":"metabias_makes_mistakes","qualified_name":"jhcbdvn1.metabias_makes_mistakes"},{"def_id":"x9sye156","display_kind":"definition","file_id":"wwqc19pp","kind":"definition","local_name":"metabias_is_a_person","qualified_name":"wwqc19pp.metabias_is_a_person"}]}
