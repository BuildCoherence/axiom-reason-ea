e":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Nat","kind":"stdlib","qualified_name":"HAdd.hAdd","subexpr_pos":"/1/1/1/1/1/1/0/1","text":"1 + sizeOf latentState + sizeOf mixingProcess + sizeOf observedField + sizeOf noiseSources","token_id":"zt3v281b.NetworkRelativityChannel.mk.sizeOf_spec::empty/conclusion::19","token_role":null}},{"node":"text","text":" + "},{"child":{"children":[{"node":"text","text":"sizeOf "},{"child":{"node":"text","text":"recoveryTask"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1/1/1/1/1/1","text":"recoveryTask","token_id":"zt3v281b.NetworkRelativityChannel.mk.sizeOf_spec::empty/conclusion::33","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Nat","kind":"stdlib","qualified_name":"SizeOf.sizeOf","subexpr_pos":"/1/1/1/1/1/1/1","text":"sizeOf recoveryTask","token_id":"zt3v281b.NetworkRelativityChannel.mk.sizeOf_spec::empty/conclusion::32","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Nat","kind":"stdlib","qualified_name":"HAdd.hAdd","subexpr_pos":"/1/1/1/1/1/1","text":"1 + sizeOf latentState + sizeOf mixingProcess + sizeOf observedField + sizeOf noiseSources + sizeOf recoveryTask","token_id":"zt3v281b.NetworkRelativityChannel.mk.sizeOf_spec::empty/conclusion::18","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Eq","subexpr_pos":"/1/1/1/1/1","text":"sizeOf (zt3v281b.NetworkRelativityChannel.mk latentState mixingProcess observedField noiseSources recoveryTask) =\n    1 + sizeOf latentState + sizeOf mixingProcess + sizeOf observedField + sizeOf noiseSources + sizeOf recoveryTask","token_id":"zt3v281b.NetworkRelativityChannel.mk.sizeOf_spec::empty/conclusion::10","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"∀ (latentState mixingProcess observedField : String) (noiseSources : List String) (recoveryTask : String),\n  sizeOf (zt3v281b.NetworkRelativityChannel.mk latentState mixingProcess observedField noiseSources recoveryTask) =\n    1 + sizeOf latentState + sizeOf mixingProcess + sizeOf observedField + sizeOf noiseSources + sizeOf recoveryTask","token_id":"zt3v281b.NetworkRelativityChannel.mk.sizeOf_spec::empty/conclusion::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\n\nnamespace zt3v281b\n\nstructure NetworkRelativityChannel where\n  latentState : String\n  mixingProcess : String\n  observedField : String\n  noiseSources : List String\n  recoveryTask : String\n\n\ndef NetworkRelativityAnalogy (c : NetworkRelativityChannel) : Prop :=\n  c.latentState ≠ \"\" ∧\n    c.mixingProcess ≠ \"\" ∧\n    c.observedField ≠ \"\" ∧\n    c.recoveryTask ≠ \"\"\n\n\ndef ComputationalStatisticalGap (statisticalRecovery computationalRecovery : Prop) : Prop :=\n  statisticalRecovery ∧ ¬ computationalRecovery\n\n\ndef network_relativity_mimo_bridgePayload :=\n  \"Network Relativity studies a recovery problem: a latent state is mixed by a network, observed through noise, and decoded relative to the receiver's frame. The MIMO detection problem is a precise mathematical analogue of this structure: transmitted bits are mixed by a channel and recovered from a noisy observation. The analogy is structural, not a claim that social networks are Gaussian channels.\"\naxiom network_relativity_mimo_bridge_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_mimo_bridgePayload, 1786316106)\ndef network_relativity_mimo_bridge : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_mimo_bridgePayload 1786316106 := ⟨network_relativity_mimo_bridge_auth⟩\n\ndef network_relativity_computational_gapPayload :=\n  \"A dormant observation may be statistically relevant to a current network state while remaining computationally unreachable by a bounded retrieval procedure. This is the Network Relativity analogue of a computational-statistical gap: an optimal decoder may recover a signal before a practical decoder can.\"\naxiom network_relativity_computational_gap_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_computational_gapPayload, 1786316106)\ndef network_relativity_computational_gap : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_computational_gapPayload 1786316106 := ⟨network_relativity_computational_gap_auth⟩\n\ndef network_relativity_lmmse_greedy_patternPayload :=\n  \"The signed-LMMSE-then-greedy-correction pattern suggests a Network Relativity decoder: first estimate a coarse current field and its competing interpretations, then apply bounded local corrections that reduce explanatory residual without requiring immediate agreement. This is a design hypothesis, not an imported theorem.\"\naxiom network_relativity_lmmse_greedy_pattern_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_lmmse_greedy_patternPayload, 1786316106)\ndef network_relativity_lmmse_greedy_pattern : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_lmmse_greedy_patternPayload 1786316106 := ⟨network_relativity_lmmse_greedy_pattern_auth⟩\n\ndef network_relativity_threshold_boundaryPayload :=\n  \"A recovery threshold in a random Gaussian channel must not be presented as a threshold law for human networks. The transferable hypothesis is narrower: bounded recovery may exhibit an activation frontier where an observation becomes legible, non-redundant, and computationally recoverable relative to a network frame.\"\naxiom network_relativity_threshold_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_threshold_boundaryPayload, 1786316106)\ndef network_relativity_threshold_boundary : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_threshold_boundaryPayload 1786316106 := ⟨network_relativity_threshold_boundary_auth⟩\n\nend zt3v281b\n","members":[],"source_lines":{"end":5,"start":5},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"qc72rfnm","tokens":{"author":null,"empty":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"latentState "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"latentState ","token_id":"zt3v281b.NetworkRelativityChannel.mk.sizeOf_spec::empty/conclusion::1","token_role":null}},{"child":{"node":"text","text":"mixingProcess "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"mixingProcess ","token_id":"zt3v281b.NetworkRelativityChannel.mk.sizeOf_spec::empty/conclusion::2","token_role":null}},{"child":{"node":"text","text":"observedField"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/0","text":"observedField","token_id":"zt3v281b.NetworkRelativityChannel.mk.sizeOf_spec::empty/conclusion::3","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"String"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"String","subexpr_pos":"/1/1/0","text":"String","token_id":"zt3v281b.NetworkRelativityChannel.mk.sizeOf_spec::empty/conclusion::4","token_role":null}},{"node":"text","text":") ("},{"child":{"node":"text","text":"noiseSources"},"node":"ta