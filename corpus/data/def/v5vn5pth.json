eleasedBurden capabilityLoss : Nat)\n    (h : capabilityLoss < releasedBurden) :\n    0 < retirementHeadroomGain releasedBurden capabilityLoss := by\n  exact Nat.sub_pos_of_lt h\n\ndef headroom_theorem_boundaryPayload := \"These theorems establish only arithmetic consequences of a natural-number headroom model. They do not prove that a real system's capacities are commensurable, that burden is fully observed, or that effective reachable futures are determined by one scalar.\"\naxiom headroom_theorem_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", headroom_theorem_boundaryPayload, 1789059159)\ndef headroom_theorem_boundary : Axiom.Statement \"hitchhiker2thefuture\" headroom_theorem_boundaryPayload 1789059159 := ⟨headroom_theorem_boundary_auth⟩\n\nend hmhhcnw7\n","members":[],"source_lines":{"end":5,"start":5},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"av9qftnb","tokens":{"author":null,"empty":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"grossCapacity "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"grossCapacity ","token_id":"hmhhcnw7.HeadroomState.mk.injEq::empty/conclusion::1","token_role":null}},{"child":{"node":"text","text":"commitmentBurden "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"commitmentBurden ","token_id":"hmhhcnw7.HeadroomState.mk.injEq::empty/conclusion::2","token_role":null}},{"child":{"node":"text","text":"grossCapacity_1 "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/0","text":"grossCapacity_1 ","token_id":"hmhhcnw7.HeadroomState.mk.injEq::empty/conclusion::3","token_ro