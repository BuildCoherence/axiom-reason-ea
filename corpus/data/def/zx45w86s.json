ib","qualified_name":"Axiom.Actual","subexpr_pos":"/1/0/1","text":"Axiom.Actual p","token_id":"t0d1zdc3.LogicIsActual.idempotency::empty/conclusion::4","token_role":null}},{"node":"text","text":" = "},{"child":{"children":[{"node":"text","text":"Axiom.Actual "},{"child":{"children":[{"node":"text","text":"(Axiom.Actual "},{"child":{"node":"text","text":"p"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1/1","text":"p","token_id":"t0d1zdc3.LogicIsActual.idempotency::empty/conclusion::8","token_role":null}},{"node":"text","text":")"}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/1/1/1","text":"(Axiom.Actual p)","token_id":"t0d1zdc3.LogicIsActual.idempotency::empty/conclusion::7","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.Actual","subexpr_pos":"/1/1","text":"Axiom.Actual (Axiom.Actual p)","token_id":"t0d1zdc3.LogicIsActual.idempotency::empty/conclusion::6","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Eq","subexpr_pos":"/1","text":"Axiom.Actual p = Axiom.Actual (Axiom.Actual p)","token_id":"t0d1zdc3.LogicIsActual.idempotency::empty/conclusion::3","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"∀ (p : Prop), Axiom.Actual p = Axiom.Actual (Axiom.Actual p)","token_id":"t0d1zdc3.LogicIsActual.idempotency::empty/conclusion::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom.Types.Actual\nopen Axiom\n\nnamespace t0d1zdc3\n\n-- Bridge axioms that enable logically reasoning about what's Actual.\n-- A bare (hp : p) means that p is logically true; that is, true\n-- in all logically possibile worlds. We therefore use Actual p to\n-- denote truths that are contigently true in the \"actual world\".\n-- Note: Rejecting these axioms does not imply that one rejects\n-- logic as a means to understand Actuality. By accepting these\n-- axioms, you accept Lean 4's logic. Users who would prefer, for\n-- example, a purely intuitionist logic would need to accept\n-- alternative bridge axioms and not accept these ones.\nstructure LogicIsActual : Prop where\n  -- That which is True logically is True Actually.\n  actual_intro : ∀ p : Prop, p → Actual p\n  -- Modus ponens at the actual world (the \"K\" axiom): if (p → q) is\n  -- Actual and p is Actual, then q is Actual. The Actual-wrapped\n  -- conditional is what makes this strong enough to chain multi-premise\n  -- inferences whose rules are themselves Actual claims.\n  mp : ∀ p q : Prop, Actual (p → q) → Actual p → Actual q\n  -- Nothing that is inconsistent is Actually true.\n  consistency : ¬ Actual False\n  -- That which is actually True is actually actually True\n  -- (and vise versa).\n  idempotency : ∀ p : Prop, Actual p = Actual (Actual p)\n\n\nend t0d1zdc3\n","members":[],"source_lines":{"end":27,"start":27},"theorem_statement":null},"referenced_by":[]}
