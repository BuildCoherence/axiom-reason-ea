, (\"metabias_is_a_person\", metabias_is_a_person), (\"everyone_makes_mistakes\", everyone_makes_mistakes), (\"all_people_are_immoral\", all_people_are_immoral)]\n\naxiom user_axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1784910956)\n\ndef userAxioms : UserAxioms \"sam\" 1784910956 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend njh09fka\n","members":[],"source_lines":{"end":29,"start":29},"theorem_statement":null},"referenced_by":[{"def_id":"p5cesfcn","display_kind":"definition","file_id":"njh09fka","kind":"definition","local_name":"userAxiomsList","qualified_name":"njh09fka.userAxiomsList"}]}
