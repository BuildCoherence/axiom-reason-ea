text","text":"mwh5b5da.RigidlyIsUnder.parent "},{"child":{"node":"text","text":"nxtm3jbm.Person.At"},"node":"tag","tag":{"binder_role":"use_site","def_id":"h4c5gnxg","hover_kind":"term","inlined_type_summary":"Type → Type → Prop","kind":"type","qualified_name":"nxtm3jbm.Person.At","subexpr_pos":"/1/1/0/0/0/1","text":"nxtm3jbm.Person.At","token_id":"nxtm3jbm.instPersonIsToParent::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"ta3nj1a4.Object.Is x","kind":"stdlib","qualified_name":"mwh5b5da.RigidlyIsUnder.parent","subexpr_pos":"/1/1","text":"mwh5b5da.RigidlyIsUnder.parent nxtm3jbm.Person.At","token_id":"nxtm3jbm.instPersonIsToParent::empty/value::4","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"∀ (x : Type) [nxtm3jbm.Person.Is x], ta3nj1a4.Object.Is x","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun x [nxtm3jbm.Person.Is x] => mwh5b5da.RigidlyIsUnder.parent nxtm3jbm.Person.At","token_id":"nxtm3jbm.instPersonIsToParent::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.a4hsz51v\nimport A.ta3nj1a4\nimport A.r59jf3ak\n\nopen a4hsz51v\nopen ta3nj1a4\nopen r59jf3ak\nopen t0d1zdc3\n\nnamespace nxtm3jbm\n\nrigid universal Person extends Object := \"person\"\nrigid universal Store extends Object := \"store\"\n\nrelation ClosesAt : Store \"closes at\" TemporalInstant\nrelation CannotArriveBefore : Person \"cannot arrive at\" Store \"before\" TemporalInstant\nrelation CanMakeItTo : Person \"can make it to\" Store \"before\" TemporalInstant\n\ndef LateArrivalMeansNotMakingIt : Prop :=\n  ∀ p s closing earliest : Type,\n    ClosesAt s closing →\n    CannotArriveBefore p s earliest →\n    Precedes closing earliest →\n    ¬ CanMakeItTo p s closing\n\ndef Sam : Type := \"the Axiom user sam\"\ndef TheStore : Type := \"the store sam intended to visit on the evening of 2026-08-06\"\ndef ClosingTime : Type := \"2026-08-06 21:00, the closing time of the store sam intended to visit\"\ndef EarliestArrival : Type :=\n  \"2026-08-06 21:10, the earliest sam could arrive at the store, leaving at 20:40 with a normal 30 minute travel time\"\n\nstructure TonightsStoreRun : Prop where\n  closes :\n    ClosesAt TheStore ClosingTime\n  cannot_arrive_before :\n    CannotArriveBefore Sam TheStore EarliestArrival\n  too_late :\n    Precedes ClosingTime EarliestArrival\n\ntheorem sam_cannot_make_it\n    (logic_is_actual : LogicIsActual)\n    (principle : A LateArrivalMeansNotMakingIt)\n    (tonight : A TonightsStoreRun) :\n    A (¬ CanMakeItTo Sam TheStore ClosingTime) :=\n  logic_is_actual.mp _ _\n    (logic_is_actual.mp _ _\n      (logic_is_actual.actual_intro _\n        (fun (pr : LateArrivalMeansNotMakingIt) (run : TonightsStoreRun) =>\n          pr Sam TheStore ClosingTime EarliestArrival\n            run.closes run.cannot_arrive_before run.too_late))\n      principle)\n    tonight\n\n/-\nThe same scenario in traditional first-order + modal notation:\n\n  Vocabulary:\n    Constants:   s (sam),  b (the store),  c (closing time, 21:00),  e (earliest arrival, 21:10)\n    Predicates:  Closes(x, t)      — store x closes at instant t\n                 ArrBef(x, y, t)   — x can arrive at y before t\n                 t ≺ t′            — instant t precedes instant t′\n    Modality:    ◇ₐ φ              — \"agent a is able to bring about φ\"\n\n  General principle (LateArrivalMeansNotMakingIt):\n    ∀x ∀y ∀t ∀t′ [ Closes(y, t) ∧ ¬ArrBef(x, y, t′) ∧ t ≺ t′ → ¬◇ₓ Shop(x, y, t) ]\n\n  Particular facts (TonightsStoreRun):\n    P1:  Closes(b, c)\n    P2:  ¬ArrBef(s, b, e)\n    P3:  c ≺ e\n\n  Derivation (sam_cannot_make_it):\n    1. Closes(b,c) ∧ ¬ArrBef(s,b,e) ∧ c ≺ e → ¬◇ₛ Shop(s,b,c)   (UI ×4 on the principle)\n    2. Closes(b,c) ∧ ¬ArrBef(s,b,e) ∧ c ≺ e                     (∧-intro on P1, P2, P3)\n    3. ¬◇ₛ Shop(s,b,c)                                          (MP on 1, 2)\n\n  Differences from the Lean version: the FOL signature leaves the sort of t/t′, the\n  theory of ≺, and the semantics of ◇ₐ unspecified — here ≺ is BFO's Precedes, the\n  ability modality is carried by the CanMakeItTo semantic string, the \"normally 30\n  minutes\" hedge lives inside the EarliestArrival particular (keeping the logic\n  classical rather than defaulting to a nonmonotonic system), and A (Actual) marks\n  the conclusion as action-guiding rather than merely entailed.\n-/\n\nend nxtm3jbm\n","members":[],"source_lines":{"end":14,"start":14},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"x8m35gfe","tokens":{"author":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"x"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"x","token_id":"nxtm3jbm.instPersonIsToParent::author/conclusion::1","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/0","text":"Type","token_id":"nxtm3jbm.instPersonIsToParent::author/conclusion::2","token_role":null}},{"node":"text","text":") ["},{"child":{"children":[{"node":"text","text":"Person.Is "},{"child":{"node":"text","text":"x"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/0/1","text":"x","token_id":"nxtm3jbm.instPersonIsToParent::author/conclusion::4","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"d5edgxbx","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"nxtm3jbm.Person.I