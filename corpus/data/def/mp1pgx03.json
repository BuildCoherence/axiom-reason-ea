  p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend n82pf9zy\n","members":[],"source_lines":{"end":13,"start":13},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"y9jcpp72","tokens":{"author":null,"empty":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"v"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"v","token_id":"n82pf9zy.instCoeMoralCharacterQuality._proof_1::empty/conclusion::1","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"n82pf9zy.MoralCharacter"},"node":"tag","tag":{"binder_role":"use_site","def_id":"v8xrkz0m","hover_kind":"term","inlined_type_summary":"Type 1","kind":"type","qualified_name":"n82pf9zy.MoralCharacter","subexpr_pos":"/0","text":"n82pf9zy.MoralCharacter","token_id":"n82pf9zy.instCoeMoralCharacterQuality._proof_1::empty/conclusion::2","token_role":null}},{"node":"text","text":"), "},{"child":{"children":[{"node":"text","text":"d4qbfhxh.Quality.Is "},{"child":{"children":[{"node":"text","text":"(Subtype.val "},{"child":{"node":"text","text":"v"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1","text":"v","token_id":"n82pf9zy.instCoeMoralCharacterQuality._proof_1::empty/conclusion::5","token_role":null}},{"node":"text","text":")"}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"stdlib","qualified_name":"Subtype.val","subexpr_p