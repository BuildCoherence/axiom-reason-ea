ral\", all_people_are_immoral), (\"i_am_a_person\", i_am_a_person), (\"metabias_is_a_person\", metabias_is_a_person), (\"everyone_makes_mistakes\", everyone_makes_mistakes)]\n\naxiom user_axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1783443201)\n\ndef userAxioms : UserAxioms \"sam\" 1783443201 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend xzhjkkyk\n","members":[],"source_lines":{"end":28,"start":27},"theorem_statement":null},"referenced_by":[{"def_id":"jvmeb207","display_kind":"definition","file_id":"xzhjkkyk","kind":"definition","local_name":"userAxioms","qualified_name":"xzhjkkyk.userAxioms"},{"def_id":"xjhv7w0r","display_kind":"axiom","file_id":"xzhjkkyk","kind":"axiom","local_name":"user_axioms_auth","qualified_name":"xzhjkkyk.user_axioms_auth"}]}
