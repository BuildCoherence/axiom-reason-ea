ummary":"String","kind":"string","qualified_name":null,"text":"\"mammal\"","token_id":"wbgpfv88.instCoeDepTypeMammalOfIs._proof_1::src::5","token_role":null}],"type_tokens":{"author":null,"empty":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"x"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"x","token_id":"wbgpfv88.instCoeDepTypeMammalOfIs._proof_1::empty/conclusion::1","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/0","text":"Type","token_id":"wbgpfv88.instCoeDepTypeMammalOfIs._proof_1::empty/conclusion::2","token_role":null}},{"node":"text","text":") ["},{"child":{"children":[{"node":"text","text":"wbgpfv88.Mammal.Is "},{"child":{"node":"text","text":"x"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/0/1","text":"x","token_id":"wbgpfv88.instCoeDepTypeMammalOfIs._proof_1::empty/conclusion::4","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"mez93qwn","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"wbgpfv88.Mammal.Is","subexpr_pos":"/1/0","text":"wbgpfv88.Mammal.Is x","token_id":"wbgpfv88.instCoeDepTypeMammalOfIs._proof_1::empty/conclusion::3","token_role":null}},{"node":"text","text":"], "},{"child":{"children":[{"node":"text","text":"wbgpfv88.Mammal.Is "},{"child":{"node":"text","text":"x"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1/1","text":"x","token_id":"wbgpfv88.instCoeDepTypeMamm