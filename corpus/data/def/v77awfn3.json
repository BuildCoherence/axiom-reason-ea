,"byte_start":457,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"kdvdwae2.CapabilityCompressionTransferObservation::src::40","token_role":null},{"binder_role":"use_site","byte_end":462,"byte_start":459,"def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"stdlib","qualified_name":"Nat","text":"Nat","token_id":"kdvdwae2.CapabilityCompressionTransferObservation::src::41","token_role":null},{"binder_role":"def_site","byte_end":489,"byte_start":465,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"stdlib","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.routedModelValidatedUses","text":"routedModelValidatedUses","token_id":"kdvdwae2.CapabilityCompressionTransferObservation::src::42","token_role":null},{"binder_role":null,"byte_end":491,"byte_start":490,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"kdvdwae2.CapabilityCompressionTransferObservation::src::43","token_role":null},{"binder_role":"use_site","byte_end":495,"byte_start":492,"def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"stdlib","qualified_name":"Nat","text":"Nat","token_id":"kdvdwae2.CapabilityCompressionTransferObservation::src::44","token_role":null}],"type_tokens":{"author":{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Type","token_id":"kdvdwae2.CapabilityCompressionTransferObservation::author/type::0","token_role":null}},"empty":{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Type","token_id":"kdvdwae2.CapabilityCompressionTransferObservation::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\n\nnamespace kdvdwae2\n\nstructure CapabilityCompressionTransferObservation where\n  sourceEntropyUnits : Nat\n  compressedSignalUnits : Nat\n  recipientNodes : Nat\n  transferredSignals : Nat\n  validatedRecipientUses : Nat\n  sourceCostCents : Nat\n  compressionCostCents : Nat\n  transferCostCents : Nat\n  validationCostCents : Nat\n  recipientCorrectionWork : Nat\n  isolatedModelCostCents : Nat\n  isolatedModelValidatedUses : Nat\n  routedModelCostCents : Nat\n  routedModelValidatedUses : Nat\n\n\ndef WellFormedCapabilityCompressionTransferObservation (o : CapabilityCompressionTransferObservation) : Prop :=\n  0 < o.sourceEntropyUnits ∧\n    0 < o.recipientNodes ∧\n    o.compressedSignalUnits ≤ o.sourceEntropyUnits ∧\n    o.validatedRecipientUses ≤ o.transferredSignals ∧\n    o.isolatedModelValidatedUses ≤ o.recipientNodes ∧\n    o.routedModelValidatedUses ≤ o.recipientNodes\n\n\ndef StephLikeNetworkCapabilityCost (o : CapabilityCompressionTransferObservation) : Nat :=\n  o.sourceCostCents +\n    o.compressionCostCents +\n    o.transferCostCents +\n    o.validationCostCents\n\n\ndef NetworkedCompressionReachesRecipients (o : CapabilityCompressionTransferObservation) : Prop :=\n  o.validatedRecipientUses * o.recipientNodes ≥\n    o.isolatedModelValidatedUses * o.recipientNodes ∧\n    o.validatedRecipientUses ≥ o.routedModelValidatedUses\n\n\ndef NetworkedCompressionHasLowerCost (o : CapabilityCompressionTransferObservation) : Prop :=\n  StephLikeNetworkCapabilityCost o < o.isolatedModelCostCents ∧\n    StephLikeNetworkCapabilityCost o < o.routedModelCostCents\n\ndef connected_compression_capabilityPayload :=\n  \"A connected human capability can add value beyond source-level reasoning when it absorbs high-entropy input, compresses it into a recipient-legible signal, selects or reaches connected recipient nodes, and produces validated recipient use. The capability therefore includes compression, translation, routing, and recipient absorption rather than summarization alone.\"\naxiom connected_compression_capability_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", connected_compression_capabilityPayload, 1786205891)\ndef connected_compression_capability : Axiom.Statement \"hitchhiker2thefuture\" connected_compression_capabilityPayload 1786205891 := ⟨connected_compression_capability_auth⟩\n\ndef isolated_model_is_not_network_parity_controlPayload :=\n  \"An isolated model is a necessary baseline for a connected-compression experiment, but it is not an equivalent network control. It receives the source task without the recipient graph, recipient-specific context, routing path, or downstream absorption receipts. A routed model control must be evaluated separately.\"\naxiom isolated_model_is_not_network_parity_control_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", isolated_model_is_not_network_parity_controlPayload, 1786205891)\ndef isolated_model_is_not_network_parity_control : Axiom.Statement \"hitchhiker2thefuture\" isolated_model_is_not_network_parity_controlPayload 1786205891 := ⟨isolated_model_is_not_network_parity_control_auth⟩\n\ndef capability_compression_transfer_protocolPayload :=\n  \"Evaluate a connected compression capability on redacted high-entropy source packets with a frozen recipient set. Compare a human source node, an isolated model, and a model with equivalent recipient profiles and routing. Measure source entropy, compressed signal size, transfer cost, recipient-specific translation, validated recipient uses, recipient correction work, source and model costs, and reuse. Do not count a summary as a successful transfer unless a recipient uses the signal or passes a blinded absorption test.\"\naxiom capability_compression_transfer_protocol_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", capability_compression_transfer_protocolPayload, 1786205891)\ndef capability_compression_transfer_protocol : Axiom.Statement \"hitchhiker2thefuture\" capability_compression_transfer_protocolPayload 1786205891 := ⟨capability_compression_transfer_protocol_auth⟩\n\ndef networked_capability_cost_boundaryPayload :=\n  \"The cost of a connected compression capability is source acquisition plus compression, transfer, and validation cost. A lower cost than an isolated or routed model is admissible only when recipient usefulness and correction burden are measured on the same task suite. A smaller message is not automatically better compression, and temporal proximity is not proof of causal transfer.\"\naxiom networked_capability_cost_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", networked_capability_cost_boundaryPayload, 1786205891)\ndef networked_capability_cost_boundary : Axiom.Statement \"hitchhiker2thefuture\" networked_capability_cost_boundaryPayload 1786205891 := ⟨networked_capability_cost_boundary_auth⟩\n\nend kdvdwae2\n","members":[{"def_id":"zwp3dtyb","display_kind":"constructor","kind":"constructor","local_name":"CapabilityCompressionTransferObservation.mk","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.mk"},{"def_id":"tp3mr75v","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.sourceEntropyUnits","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.sourceEntropyUnits"},{"def_id":"b5r6add8","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.compressedSignalUnits","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.compressedSignalUnits"},{"def_id":"erfe06ps","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.recipientNodes","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.recipientNodes"},{"def_id":"e63ncd5g","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.transferredSignals","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.transferredSignals"},{"def_id":"wjzw2w7y","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.validatedRecipientUses","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.validatedRecipientUses"},{"def_id":"cbk84xca","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.sourceCostCents","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.sourceCostCents"},{"def_id":"qdmdjnp3","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.compressionCostCents","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.compressionCostCents"},{"def_id":"yex4ft3q","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.transferCostCents","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.transferCostCents"},{"def_id":"s5g709yy","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.validationCostCents","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.validationCostCents"},{"def_id":"rz5rnqjd","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.recipientCorrectionWork","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.recipientCorrectionWork"},{"def_id":"v23t4v93","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.isolatedModelCostCents","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.isolatedModelCostCents"},{"def_id":"stpvfcan","display_kind":"field","kind":"definition","local_name":"CapabilityCompressionTransferObservation.isolatedModelValidatedUses","qualified_name":"kdvdwae2.CapabilityCompressionTransferObservation.isolatedModelValidatedUses"},{"def_id":"g6mrfkm1","display_kind":"field","kind":"definition","local_name":"CapabilityCompr