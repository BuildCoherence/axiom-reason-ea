s_a_person\", metabias_is_a_person), (\"everyone_makes_mistakes\", everyone_makes_mistakes), (\"all_people_are_immoral\", all_people_are_immoral)]\n\naxiom user_axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1784863655)\n\ndef userAxioms : UserAxioms \"sam\" 1784863655 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend zwwdymtt\n","members":[],"source_lines":{"end":28,"start":28},"theorem_statement":null},"referenced_by":[{"def_id":"td2we68h","display_kind":"definition","file_id":"zwwdymtt","kind":"definition","local_name":"userAxiomsList","qualified_name":"zwwdymtt.userAxiomsList"}]}
