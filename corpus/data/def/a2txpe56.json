ingCostCents"},{"def_id":"q0w04eag","display_kind":"field","kind":"definition","local_name":"CapabilityAdditionObservation.modelEvaluationCostCents","qualified_name":"tg09m0qk.CapabilityAdditionObservation.modelEvaluationCostCents"},{"def_id":"jza46a9t","display_kind":"field","kind":"definition","local_name":"CapabilityAdditionObservation.modelDeploymentCostCents","qualified_name":"tg09m0qk.CapabilityAdditionObservation.modelDeploymentCostCents"},{"def_id":"j6ebv5gj","display_kind":"field","kind":"definition","local_name":"CapabilityAdditionObservation.modelRegressionCostCents","qualified_name":"tg09m0qk.CapabilityAdditionObservation.modelRegressionCostCents"}],"source_lines":{"end":17,"start":5},"theorem_statement":null},"referenced_by":[{"def_id":"nhy47nt9","display_kind":"field","file_id":"tg09m0qk","kind":"definition","local_name":"CapabilityAdditionObservation.acquisitionCostCents","qualified_name":"tg09m0qk.CapabilityAdditionObservation.acquisitionCostCents"},{"def_id":"gg5cv2ch","display_kind":"field","file_id":"tg09m0qk","kind":"definition","local_name":"CapabilityAdditionObservation.coordinationCostCents","qualified_name":"tg09m0qk.CapabilityAdditionObservation.coordinationCostCents"},{"def_id":"xf274kdx","display_kind":"field","file_id":"tg09m0qk","kind":"definition","local_name":"CapabilityAdditionObservation.encodingCostCents","qualified_name":"tg09m0qk.CapabilityAdditionObservation.encodingCostCents"},{"def_id":"mdjtyy6w","display_kind":"field","file_id":"tg09m0qk","kind":"definition","local_name":"CapabilityAdditionObservation.modelDataCostCents","qualified_name":"tg09m0qk.CapabilityAdditionObservation.modelDataCostCents"},{"def_id":"jza46a9t","display_kind":"field","file_id":"tg09m0qk","kind":"definition","local_name":"CapabilityAdditionObservation.modelDeploymentCostCents","qualified_name":"tg09m0qk.CapabilityAdditionObservation.modelDeploymentCostCents"},{"def_id":"q0w04eag","display_kind":"field","file_id":"tg09m0qk","kind":"definition","local_name