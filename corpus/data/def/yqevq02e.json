itional dynamical assumptions and observations.\"\naxiom theorem_scope_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", theorem_scope_boundaryPayload, 1789061575)\ndef theorem_scope_boundary : Axiom.Statement \"hitchhiker2thefuture\" theorem_scope_boundaryPayload 1789061575 := ⟨theorem_scope_boundary_auth⟩\n\nend j1b75r6z\n","members":[],"source_lines":{"end":20,"start":15},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"ffcwsb5v","tokens":{"author":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"s"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"s","token_id":"j1b75r6z.headroom_transition_accounting::author/conclusion::1","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"CapacityLedger"},"node":"tag","tag":{"binder_role":"use_site","def_id":"afjfpdjr","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"j1b75r6z.CapacityLedger","subexpr_pos":"/0","text":"CapacityLedger","token_id":"j1b75r6z.headroom_transition_accounting::author/conclusion::2","token_role":null}},{"node":"text","text":") ("},{"child":{"node":"text","text":"deltaCapacity "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"deltaCapacity ","token_id":"j1b75r6z.headroom_transition_accounting::author/conclusion::3","token_role":null}},{"child":{"node":"text","text":"deltaBurden"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/0","text":"deltaBurden","token_id":"j1b75r6z.headroom_transition_accounting::author/conclusion::4","token_role":null}},{"node":"text","text":" : "},{"child":{"node