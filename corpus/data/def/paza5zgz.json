am","text":"Sam","token_id":"nxtm3jbm.TonightsStoreRun::src::13","token_role":null},{"binder_role":"use_site","byte_end":1210,"byte_start":1202,"def_id":"tpq9e5jv","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"nxtm3jbm.TheStore","text":"TheStore","token_id":"nxtm3jbm.TonightsStoreRun::src::14","token_role":null},{"binder_role":"use_site","byte_end":1226,"byte_start":1211,"def_id":"q5fm8fqw","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"nxtm3jbm.EarliestArrival","text":"EarliestArrival","token_id":"nxtm3jbm.TonightsStoreRun::src::15","token_role":null},{"binder_role":"def_site","byte_end":1237,"byte_start":1229,"def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"stdlib","proposition_id":"t728vsk0","qualified_name":"nxtm3jbm.TonightsStoreRun.too_late","text":"too_late","token_id":"nxtm3jbm.TonightsStoreRun::src::16","token_role":null},{"binder_role":null,"byte_end":1239,"byte_start":1238,"def_id":null,"hover_kind":null,"inlined_type_summary":null,"kind":"op","qualified_name":null,"text":":","token_id":"nxtm3jbm.TonightsStoreRun::src::17","token_role":null},{"binder_role":"use_site","byte_end":1252,"byte_start":1244,"def_id":"j197rz18","hover_kind":"term","inlined_type_summary":"Type → Type → Prop","kind":"type","qualified_name":"ta3nj1a4.Precedes","text":"Precedes","token_id":"nxtm3jbm.TonightsStoreRun::src::18","token_role":null},{"binder_role":"use_site","byte_end":1264,"byte_start":1253,"def_id":"vcmsexmx","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"nxtm3jbm.ClosingTime","text":"ClosingTime","token_id":"nxtm3jbm.TonightsStoreRun::src::19","token_role":null},{"binder_role":"use_site","byte_end":1280,"byte_start":1265,"def_id":"q5fm8fqw","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"nxtm3jbm.EarliestArrival","text":"EarliestArrival","token_id":"nxtm3jbm.TonightsStoreRun::src::20","token_role":null}],"type_tokens":{"author":null,"empty":{"child":{"node":"text","text":"Prop"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Prop","token_id":"nxtm3jbm.TonightsStoreRun::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.a4hsz51v\nimport A.ta3nj1a4\nimport A.r59jf3ak\n\nopen a4hsz51v\nopen ta3nj1a4\nopen r59jf3ak\nopen t0d1zdc3\n\nnamespace nxtm3jbm\n\nrigid universal Person extends Object := \"person\"\nrigid universal Store extends Object := \"store\"\n\nrelation ClosesAt : Store \"closes at\" TemporalInstant\nrelation CannotArriveBefore : Person \"cannot arrive at\" Store \"before\" TemporalInstant\nrelation CanMakeItTo : Person \"can make it to\" Store \"before\" TemporalInstant\n\ndef LateArrivalMeansNotMakingIt : Prop :=\n  ∀ p s closing earliest : Type,\n    ClosesAt s closing →\n    CannotArriveBefore p s earliest →\n    Precedes closing earliest →\n    ¬ CanMakeItTo p s closing\n\ndef Sam : Type := \"the Axiom user sam\"\ndef TheStore : Type := \"the store sam intended to visit on the evening of 2026-08-06\"\ndef ClosingTime : Type := \"2026-08-06 21:00, the closing time of the store sam intended to visit\"\ndef EarliestArrival : Type :=\n  \"2026-08-06 21:10, the earliest sam could arrive at the store, leaving at 20:40 with a normal 30 minute travel time\"\n\nstructure TonightsStoreRun : Prop where\n  closes :\n    ClosesAt TheStore ClosingTime\n  cannot_arrive_before :\n    CannotArriveBefore Sam TheStore EarliestArrival\n  too_late :\n    Precedes ClosingTime EarliestArrival\n\ntheorem sam_cannot_make_it\n    (logic_is_actual : LogicIsActual)\n    (principle : A LateArrivalMeansNotMakingIt)\n    (tonight : A TonightsStoreRun) :\n    A (¬ CanMakeItTo Sam TheStore ClosingTime) :=\n  logic_is_actual.mp _ _\n    (logic_is_actual.mp _ _\n      (logic_is_actual.actual_intro _\n        (fun (pr : LateArrivalMeansNotMakingIt) (run : TonightsStoreRun) =>\n          pr Sam TheStore ClosingTime EarliestArrival\n            run.closes run.cannot_arrive_before run.too_late))\n      principle)\n    tonight\n\n/-\nThe same scenario in traditional first-order + modal notation:\n\n  Vocabulary:\n    Constants:   s (sam),  b (the store),  c (closing time, 21:00),  e (earliest arrival, 21:10)\n    Predicates:  Closes(x, t)      — store x closes at instant t\n                 ArrBef(x, y, t)   — x can arrive at y before t\n                 t ≺ t′            — instant t precedes instant t′\n    Modality:    ◇ₐ φ              — \"agent a is able to bring about φ\"\n\n  General principle (LateArrivalMeansNotMakingIt):\n    ∀x ∀y ∀t ∀t′ [ Closes(y, t) ∧ ¬ArrBef(x, y, t′) ∧ t ≺ t′ → ¬◇ₓ Shop(x, y, t) ]\n\n  Particular facts (TonightsStoreRun):\n    P1:  Closes(b, c)\n    P2:  ¬ArrBef(s, b, e)\n    P3:  c ≺ e\n\n  Derivation (sam_cannot_make_it):\n    1. Closes(b,c) ∧ ¬ArrBef(s,b,e) ∧ c ≺ e → ¬◇ₛ Shop(s,b,c)   (UI ×4 on the principle)\n    2. Closes(b,c) ∧ ¬ArrBef(s,b,e) ∧ c ≺ e                     (∧-intro on P1, P2, P3)\n    3. ¬◇ₛ Shop(s,b,c)                                          (MP on 1, 2)\n\n  Differences from the Lean version: the FOL signature leaves the sort of t/t′, the\n  theory of ≺, and the semantics of ◇ₐ unspecified — here ≺ is BFO's Precedes, the\n  ability modality is carried by the CanMakeItTo semantic string, the \"normally 30\n  minutes\" hedge lives inside the EarliestArrival particular (keeping the logic\n  classical rather than defaulting to a nonmonotonic system), and A (Actual) marks\n  the conclusion as action-guiding rather than merely entailed.\n-/\n\nend nxtm3jbm\n","members":[{"conclusion_prop":"kczx8v8x","def_id":"jgqa0s90","display_kind":"field","kind":"theorem","local_name":"TonightsStoreRun.closes","qualified_name":"nxtm3jbm.TonightsStoreRun.closes"},{"def_id":"kfraaq28","display_kind":"constructor","kind":"constructor","local_name":"TonightsStoreRun.mk","qualified_name":"nxtm3jbm.TonightsStoreRun.mk"},{"conclusion_prop":"q2ax2cep","def_id":"qvvvwr21","display_kind":"field","kind":"theorem","local_name":"TonightsStoreRun.cannot_arrive_before","qualified_name":"nxtm3jbm.TonightsStoreRun.cannot_arrive_before"},{"conclusion_prop":"t728vsk0","def_id":"fm0zvqfd","display_kind":"field","kind":"theorem","local_name":"TonightsStoreRun.too_late","qualified_name":"nxtm3jbm.TonightsStoreRun.too_late"}],"source_lines":{"end":40,"start":34},"theorem_statement":null},"referenced_by":[{"def_id":"zrmptq7r","display_kind":"theorem","file_id":"nxtm3jbm","kind":"theorem","local_name":"sam_cannot_make_it","qualified_name":"nxtm3jbm.sam_cannot_make_it"},{"def_id":"qvvvwr21","display_kind":"field","file_id":"nxtm3jbm","kind":"theorem","local_name":"TonightsStoreRun.cannot_arrive_before","qualified_name":"nxtm3jbm.TonightsStoreRun.cannot_arrive_before"},{"def_id":"jgqa0s90","display_kind":"field","file_id":"nxtm3jbm","kind":"theorem","local_name":"TonightsStoreRun.closes","qualified_name":"nxtm3jbm.TonightsStoreRun.closes"},{"def_id":"fm0zvqfd","display_kind":"field","file_id":"nxtm3jbm","kind":"theorem","local_name":"TonightsStoreRun.too_late","qualified_name":"nxtm3jbm.TonightsStoreRun.too_late"}]}
