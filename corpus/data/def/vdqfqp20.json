over_kind":"term","inlined_type_summary":"Type → Prop","kind":"type","qualified_name":"c424c6bg.RigidlyIsUnder","subexpr_pos":"/","text":"c424c6bg.RigidlyIsUnder pv802k7b.MoralCharacter.At j12bzjgj.BFO.Quality.Is","token_id":"pv802k7b.MoralCharacter.Is::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.j12bzjgj\nimport A.azt4989z\n\nopen j12bzjgj\nopen azt4989z\nopen t0d1zdc3\nopen gwcwyrvb\nopen c424c6bg\n\nopen BFO\n\nnamespace pv802k7b\n\nrigid universal MoralCharacter extends Quality := \"moral character\"\n\nrelation Immoral : Person := \"is immoral\"\nrelation HasMoralCharacter : Person → MoralCharacter := \"has moral character\"\nrelation MoreMoralThan : MoralCharacter → MoralCharacter := \"is more moral than\"\n\npostfix:max \" is-immoral\" => Immoral\ninfix:50 \" has-moral-character \" => HasMoralCharacter\ninfix:50 \" more-moral-than \" => MoreMoralThan\n\nabbrev LessMoralThan (a b : Type) : Prop := MoreMoralThan b a\n\ninfix:50 \" less-moral-than \" => LessMoralThan\n\nstructure MoralComparisonIsCoherent : Prop where\n  more_moral_irreflexive : ∀ m : MoralCharacter, ¬ (m more-moral-than m)\n  more_moral_transitive :\n    ∀ a b c : MoralCharacter,\n      a more-moral-than b → b more-moral-than c → a more-moral-than c\n\ndef ImmoralBelowNonImmoral : Prop :=\n  ∀ (p q : Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend pv802k7b\n","members":[],"source_lines":{"end":15,"start":15},"theorem_statement":null},"referenced_by":[{"def_id":"jfqeaeeq","display_kind":"definition","file_id":"pv802k7b","kind":"definition","local_name":"HasMoralCharacter","qualified_name":"pv802k7b.HasMoralCharacter"},{"def_id":"hxvqzd7x","display_kind":"definition","file_id":"pv802k7b","kind":"definition","local_name":"ImmoralBelowNonImmoral","qualified_name":"pv802k7b.ImmoralBelowNonImmoral"},{"def_id":"h7jy5npm","display_kind":"definition","file_id":"pv802k7b","kind":"definition","local_name":"MoralCharacter","qualified_name":"pv802k7b.MoralCharacter"},{"def_id":"rn1cq8je","display_kind":"definition","file_id":"pv802k7b","kind":"definition","local_name":"MoralComparisonIsCoherent.casesOn","qualified_name":"pv802k7b.MoralComparisonIsCoherent.casesOn"},{"def_id":"e24fnxr1","display_kind":"constructor","file_id":"pv802k7b","kind":"constructor","local_name":"MoralComparisonIsCoherent.mk","qualified_name":"pv802k7b.MoralComparisonIsCoherent.mk"},{"def_id":"ajsxyb3f","display_kind":"field","file_id":"pv802k7b","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_irreflexive","qualified_name":"pv802k7b.MoralComparisonIsCoherent.more_moral_irreflexive"},{"def_id":"s5d6mykv","display_kind":"field","file_id":"pv802k7b","kind":"theorem","local_name":"MoralComparisonIsCoherent.more_moral_transitive","qualified_name":"pv802k7b.MoralComparisonIsCoherent.more_moral_transitive"},{"def_id":"nwgnd5kf","display_kind":"theorem","file_id":"pv802k7b","kind":"theorem","local_name":"more_moral_asymmetric","qualified_name":"pv802k7b.more_moral_asymmetric"},{"def_id":"xyqpvapn","display_kind":"definition","file_id":"pv802k7b","kind":"definition","local_name":"MoreMoralThan","qualified_name":"pv802k7b.MoreMoralThan"},{"def_id":"dj9993n7","display_kind":"field","file_id":"pv802k7b","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.at_most_one","qualified_name":"pv802k7b