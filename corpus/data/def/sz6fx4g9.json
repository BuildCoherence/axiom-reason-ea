axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1784865159)\n\ndef userAxioms : UserAxioms \"sam\" 1784865159 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend z1jy54jw\n","members":[],"source_lines":{"end":27,"start":27},"theorem_statement":null},"referenced_by":[{"def_id":"kx2c2ng8","display_kind":"definition","file_id":"z1jy54jw","kind":"definition","local_name":"userAxiomsList","qualified_name":"z1jy54jw.userAxiomsList"}]}
