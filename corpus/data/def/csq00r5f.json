otdog filling : Type,\n    Hotdog.Is hotdog → (filling is-the-filling-of hotdog) →\n      (filling is-a-discrete-preformed-unit)\n\ndef NoHotdogIsASandwich : Prop :=\n  ∀ hotdog : Type, Hotdog.Is hotdog → ¬ Sandwich hotdog\n\ntheorem no_hotdog_is_a_sandwich\n    (logic_is_actual : LogicIsActual)\n    (units_are_not_portions : A UnitsAreNotPortions)\n    (hotdogs_have_unit_fillings : A HotdogsHaveUnitFillings) :\n    A NoHotdogIsASandwich :=\n  logic_is_actual.mp _ _\n    (logic_is_actual.mp _ _\n      (logic_is_actual.actual_intro _\n        (fun unp hhuf hotdog hotdog_is h => by\n          obtain ⟨_bread, filling, _bread_of, filling_of, _bounds, portion⟩ := h\n          exact unp filling (hhuf hotdog filling hotdog_is filling_of) portion))\n      units_are_not_portions)\n    hotdogs_have_unit_fillings\n\nend Sandwich\n\nend v289fr59\n","members":[],"source_lines":{"end":16,"start":16},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"n5gf1ayy","tokens":{"author":null,"empty":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"v"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"v","token_id":"v289fr59.Sandwich.instCoeFoodObject._proof_1::empty/conclusion::1","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"v289fr59.Sandwich.Food"},"node":"tag","tag":{"binder_role":"use_site","def_id":"xetqee2z","hover_kind":"term","inlined_type_summary":"Type 1","kind":"type","qualified_name":"v289fr59.Sandwich.Food","subexpr_pos":"/0","text":"v289fr59.Sandwich.Food","token_id":"v289fr59.Sandwich.instCoeFoodObject._proof_1::empty/conclusion::2","token_role":null}},{"node":"text","text":"), "},{"child":{"children":[{"node":"text","text":"j12bzjgj.BFO.Object.Is "},{"child":{"children":[{"node":"text","text":"(Subtype.val "},{"child":{"node":"text","text":"v"}