ource_lines":{"end":17,"start":15},"theorem_statement":null},"referenced_by":[{"def_id":"kjc75qws","display_kind":"theorem","file_id":"ap91fkg6","kind":"theorem","local_name":"AxiomaticThinking.observations_can_update_beliefs_if_person_chooses","qualified_name":"ap91fkg6.AxiomaticThinking.observations_can_update_beliefs_if_person_chooses"},{"def_id":"r4ym77p8","display_kind":"theorem","file_id":"ap91fkg6","kind":"theorem","local_name":"AxiomaticThinking.observations_dont_update_beliefs_if_person_doesnt_choose","qualified_name":"ap91fkg6.AxiomaticThinking.observations_dont_update_beliefs_if_person_doesnt_choose"},{"def_id":"h58dkxbd","display_kind":"theorem","file_id":"rvxd5naf","kind":"theorem","local_name":"AxiomaticThinking.observations_can_update_beliefs_if_person_chooses","qualified_name":"rvxd5naf.AxiomaticThinking.observations_can_update_beliefs_if_person_chooses"},{"def_id":"thfem6yy","display_kind":"theorem","file_id":"rvxd5naf","kind":"theorem","local_name":"AxiomaticThinking.observations_dont_update_beliefs_if_person_doesnt_choose","qualified_name":"rvxd5naf.AxiomaticThinking.observations_dont_update_beliefs_if_person_doesnt_choose"}]}
