 : Prop where\n  mem : InstanceOf x u t\n  parent : parentAt x t\n\n/-- `x` is rigidly an instance of the universal with At-predicate `atPred`. -/\nclass RigidlyIs (atPred : Type → Type → Prop) (x : Type) : Prop where\n  mem : ∀ t : Type, InstanceOf t TemporalRegion t → ExistsAt x t → atPred x t\n\n/-- Rigid membership, plus rigid membership in the parent (via `parentIs`). -/\nclass RigidlyIsUnder (atPred : Type → Type → Prop) (parentIs : Type → Prop) (x : Type) : Prop where\n  mem : ∀ t : Type, InstanceOf t TemporalRegion t → ExistsAt x t → atPred x t\n  parent : parentIs x\n\nend mwh5b5da\n","members":[],"source_lines":{"end":23,"start":23},"theorem_statement":null},"referenced_by":[{"def_id":"cnxpd9xs","display_kind":"theorem","file_id":"c065ehm2","kind":"theorem","local_name":"instMoralCharacterIsToParent","qualified_name":"c065ehm2.instMoralCharacterIsToParent"},{"def_id":"nx37wav4","display_kind":"theorem","file_id":"c1n0kwdq","kind":"theorem","local_name":"Dictionary.instActionIsToParent","qualified_name":"c1n0kwdq.Dictionary.instActionIsToParent"},{"def_id":"hx7gbnn0","display_kind":"theorem","file_id":"c1n0kwdq","kind":"theorem","local_name":"Dictionary.instAgentIsToParent","qualified_name":"c1n0kwdq.Dictionary.instAgentIsToParent"},{"def_id":"hny1jvk6","display_kind":"theorem","file_id":"c1n0kwdq","kind":"theorem","local_name":"Dictionary.instBeliefIsToParent","qualified_name":"c1n0kwdq.Dictionary.instBeliefIsToParent"},{"def_id":"cy3x2ywe","display_kind":"theorem","file_id":"c1n0kwdq","kind":"theorem","local_name":"Dictionary.instBeliefSystemIsToParent","qualified_name":"c1n0kwdq.Dictionary.instBeliefSystemIsToParent"},{"def_id":"zmtvbnvn","display_kind":"theorem","file_id":"c1n0kwdq","kind":"theorem","local_name":"Dictionary.instCapabilityIsToParent","qualified_name":"c1n0kwdq.Dictionary.instCapabilityIsToParent"},{"def_id":"wxyp6r2m","display_kind":"theorem","file_id":"c1n0kwdq","kind":"theorem","local_name":"Dictionary.instCommunicationIsToParent","qua