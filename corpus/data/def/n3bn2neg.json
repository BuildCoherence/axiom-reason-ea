ice := by\n  intro h\n  have alice_is_daughter : Daughter.Is Alice := DaughterOf.inst0 h\n  exact dd ▸ alice_is_daughter\n\nend yvbc459t\n","members":[],"source_lines":{"end":26,"start":26},"theorem_statement":null},"referenced_by":[{"def_id":"j6bwzzvd","display_kind":"definition","file_id":"yvbc459t","kind":"definition","local_name":"Father.asUniversal","qualified_name":"yvbc459t.Father.asUniversal"}]}
