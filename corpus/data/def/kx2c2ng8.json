son\", i_am_a_person), (\"metabias_is_a_person\", metabias_is_a_person), (\"everyone_makes_mistakes\", everyone_makes_mistakes), (\"all_people_are_immoral\", all_people_are_immoral)]\n\naxiom user_axioms_auth : AuthenticatedTerm (\"sam\", userAxiomsList, 1784865159)\n\ndef userAxioms : UserAxioms \"sam\" 1784865159 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend z1jy54jw\n","members":[],"source_lines":{"end":33,"start":32},"theorem_statement":null},"referenced_by":[{"def_id":"s55daqzd","display_kind":"definition","file_id":"z1jy54jw","kind":"definition","local_name":"userAxioms","qualified_name":"z1jy54jw.userAxioms"},{"def_id":"f4rxkb8s","display_kind":"axiom","file_id":"z1jy54jw","kind":"axiom","local_name":"user_axioms_auth","qualified_name":"z1jy54jw.user_axioms_auth"}]}
