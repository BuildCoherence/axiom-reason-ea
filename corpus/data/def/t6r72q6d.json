,"token_role":null},{"binder_role":"use_site","byte_end":3012,"byte_start":3001,"def_id":"drc17y01","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"z2yhb66n.Example.AdultMurder","text":"AdultMurder","token_id":"z2yhb66n.Example.TwoConcreteMurderCases::src::60","token_role":null}],"type_tokens":{"author":null,"empty":{"child":{"node":"text","text":"Prop"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Prop","token_id":"z2yhb66n.Example.TwoConcreteMurderCases::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.mw1nngvh\nimport A.j12bzjgj\n\nopen t0d1zdc3\nopen gwcwyrvb\nopen mw1nngvh\nopen j12bzjgj\nopen c424c6bg\n\nnamespace z2yhb66n\n\n#check Person\n\nopen BFO\n\nrigid universal Murder extends Process := \"murder\"\nrigid universal PunishmentSpec extends GenericallyDependentContinuant := \"punishment specification\"\n\nrelation MurderInvolves : Murder \"involves the victim\" Person \"and murderer\" Person\nrelation DeservesPunishmentFor : Person \"derserves\" PunishmentSpec \"for\" Process\nrelation IsGreaterPunishmentThan : PunishmentSpec \"is greater than\" PunishmentSpec\nrelation MurderCircumstancesRelevantToTheDeservedPunishmentOtherThanVictimAge : Murder := \"circumstances relevant to the deserved punishment other than the victim's age\"\n\nstructure MurderCase where\n  murder : Murder\n  murderer : Person\n  victim : Person\n  punishment : PunishmentSpec\n  murders_involvement : MurderInvolves murder victim murderer\n  deserved_punishment : DeservesPunishmentFor murderer punishment murder\n\ndef VictimIsChild (mc : MurderCase) :=\n  ∃ t, Child.At mc.victim t ∧ ProcessOccupiesTemporalRegion mc.murder t\n  \ndef SameNonVictimAgeCircumstances (mc1 mc2 : MurderCase) :=\n  (MurderCircumstancesRelevantToTheDeservedPunishmentOtherThanVictimAge mc1.murder) ↔ (MurderCircumstancesRelevantToTheDeservedPunishmentOtherThanVictimAge mc2.murder)\n\ndef ChildMurderDeservesGreaterPunishmentThanNonChildMurder : Prop :=\n  ∀ mc1 mc2 : MurderCase, SameNonVictimAgeCircumstances mc1 mc2 →\n    VictimIsChild mc1 → ¬ VictimIsChild mc2 →\n      IsGreaterPunishmentThan mc1.punishment mc2.punishment\n\nnamespace Example\n\ndef Murderer : Type := \"The Marjory Stoneman Douglas High School shooter\"\ndef ChildVictim : Type := \"Alyssa Alhadeff\"\ndef ChildMurder : Type := \"the murder of Alyssa Alhadeff\"\ndef ChildCasePunishmentSpec : Type :=\n  \"the punishment specification deserved for the murder of Alyssa Alhadeff\"\n\ndef AdultVictim : Type := \"Chris Hixon\"\ndef AdultMurder : Type := \"the murder of Chris Hixon\"\ndef AdultCasePunishmentSpec : Type :=\n  \"the punishment specification deserved for the murder of Chris Hixon\"\n\nstructure TwoConcreteMurderCases : Prop where\n  child_case_involvement : \n    MurderInvolves ChildMurder ChildVictim Murderer\n  child_case_deserved_punishment :\n    DeservesPunishmentFor Murderer ChildCasePunishmentSpec ChildMurder\n  child_case_victim_is_child :\n    ∃ t, Child.At ChildVictim t ∧ ProcessOccupiesTemporalRegion ChildMurder t\n  non_child_case_involvement :\n    MurderInvolves AdultMurder AdultVictim Murderer\n  non_child_case_deserved_punishment :\n    DeservesPunishmentFor Murderer AdultCasePunishmentSpec AdultMurder\n  non_child_case_victim_is_not_child :\n    ¬ ∃ t, Child.At AdultVictim t ∧ ProcessOccupiesTemporalRegion AdultMurder t\n  same_non_victim_age_circumstances :\n    MurderCircumstancesRelevantToTheDeservedPunishmentOtherThanVictimAge ChildMurder ↔\n      MurderCircumstancesRelevantToTheDeservedPunishmentOtherThanVictimAge AdultMurder\n\ntheorem child_case_deserves_greater_punishment\n    (logic_is_actual : LogicIsActual)\n    (principle : A ChildMurderDeservesGreaterPunishmentThanNonChildMurder)\n    (cases : A TwoConcreteMurderCases) :\n    A (IsGreaterPunishmentThan\n      ChildCasePunishmentSpec\n      AdultCasePunishmentSpec) := by\n  exact\n    logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _\n          (fun principle cases => by\n            letI : Murder.Is ChildMurder := cases.child_case_involvement.inst0\n            letI : Person.Is ChildVictim := cases.child_case_involvement.inst1\n            letI : Person.Is Murderer := cases.child_case_involvement.inst2\n            letI : PunishmentSpec.Is ChildCasePunishmentSpec :=\n              cases.child_case_deserved_punishment.inst1\n            letI : Murder.Is AdultMurder := cases.non_child_case_involvement.inst0\n            letI : Person.Is AdultVictim := cases.non_child_case_involvement.inst1\n            letI : PunishmentSpec.Is AdultCasePunishmentSpec :=\n              cases.non_child_case_deserved_punishment.inst1\n            let childCase : MurderCase :=\n              { murder := ChildMurder\n                murderer := Murderer\n                victim := ChildVictim\n                punishment := ChildCasePunishmentSpec\n                murders_involvement := cases.child_case_involvement\n                deserved_punishment := cases.child_case_deserved_punishment }\n            let nonChildCase : MurderCase :=\n              { murder := AdultMurder\n                murderer := Murderer\n                victim := AdultVictim\n                punishment := AdultCasePunishmentSpec\n                murders_involvement := cases.non_child_case_involvement\n                deserved_punishment := cases.non_child_case_deserved_punishment }\n            have sameCircumstances : SameNonVictimAgeCircumstances childCase nonChildCase := by\n              simpa [SameNonVictimAgeCircumstances, childCase, nonChildCase]\n                using cases.same_non_victim_age_circumstances\n            have childVictimIsChild : VictimIsChild childCase := by\n              simpa [VictimIsChild, childCase] using cases.child_case_victim_is_child\n            have nonChildVictimIsNotChild : ¬ VictimIsChild nonChildCase := by\n              simpa [VictimIsChild, nonChildCase]\n                using cases.non_child_case_victim_is_not_child\n            exact principle childCase nonChildCase\n              sameCircumstances\n              childVictimIsChild\n              nonChildVictimIsNotChild))\n        principle)\n      cases\n\nend Example\n\n\nend z2yhb66n\n","members":[{"conclusion_prop":"jny8b7b2","def_id":"sr7cab1w","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_involvement","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.child_case_involvement"},{"def_id":"hfy2xm8b","display_kind":"constructor","kind":"constructor","local_name":"Example.TwoConcreteMurderCases.mk","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.mk"},{"conclusion_prop":"v11ffymw","def_id":"apyca5ab","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_deserved_punishment","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.child_case_deserved_punishment"},{"conclusion_prop":"hpazwhht","def_id":"s8kfwx3q","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_victim_is_child","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.child_case_victim_is_child"},{"conclusion_prop":"e7q8m52r","def_id":"ppr1j2r4","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_involvement","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.non_child_case_involvement"},{"conclusion_prop":"yjeeexa0","def_id":"qjc0kq9q","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_deserved_punishment","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.non_child_case_deserved_punishment"},{"conclusion_prop":"y2hp487y","def_id":"fkdmf376","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_victim_is_not_child","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.non_child_case_victim_is_not_child"},{"conclusion_prop":"skzze4w4","def_id":"kcx9zgb7","display_kind":"field","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.same_non_victim_age_circumstances","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.same_non_victim_age_circumstances"}],"source_lines":{"end":74,"start":59},"theorem_statement":null},"referenced_by":[{"def_id":"e5w3s77e","display_kind":"theorem","file_id":"z2yhb66n","kind":"theorem","local_name":"Example.child_case_deserves_greater_punishment","qualified_name":"z2yhb66n.Example.child_case_deserves_greater_punishment"},{"def_id":"apyca5ab","display_kind":"field","file_id":"z2yhb66n","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_deserved_punishment","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.child_case_deserved_punishment"},{"def_id":"sr7cab1w","display_kind":"field","file_id":"z2yhb66n","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_involvement","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.child_case_involvement"},{"def_id":"s8kfwx3q","display_kind":"field","file_id":"z2yhb66n","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.child_case_victim_is_child","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.child_case_victim_is_child"},{"def_id":"qjc0kq9q","display_kind":"field","file_id":"z2yhb66n","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_deserved_punishment","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.non_child_case_deserved_punishment"},{"def_id":"ppr1j2r4","display_kind":"field","file_id":"z2yhb66n","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_involvement","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.non_child_case_involvement"},{"def_id":"fkdmf376","display_kind":"field","file_id":"z2yhb66n","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.non_child_case_victim_is_not_child","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.non_child_case_victim_is_not_child"},{"def_id":"kcx9zgb7","display_kind":"field","file_id":"z2yhb66n","kind":"theorem","local_name":"Example.TwoConcreteMurderCases.same_non_victim_age_circumstances","qualified_name":"z2yhb66n.Example.TwoConcreteMurderCases.same_non_victim_age_circumstances"}]}
