 cdh3w951\n","members":[],"source_lines":{"end":19,"start":18},"theorem_statement":null},"referenced_by":[{"def_id":"d47xb8tk","display_kind":"theorem","file_id":"cdh3w951","kind":"theorem","local_name":"some_ai_will_be_conscious","qualified_name":"cdh3w951.some_ai_will_be_conscious"}]}
