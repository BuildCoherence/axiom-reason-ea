es of a natural-number headroom model. They do not prove that a real system's capacities are commensurable, that burden is fully observed, or that effective reachable futures are determined by one scalar.\"\naxiom headroom_theorem_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", headroom_theorem_boundaryPayload, 1789059159)\ndef headroom_theorem_boundary : Axiom.Statement \"hitchhiker2thefuture\" headroom_theorem_boundaryPayload 1789059159 := ⟨headroom_theorem_boundary_auth⟩\n\nend hmhhcnw7\n","members":[],"source_lines":{"end":34,"start":30},"theorem_statement":{"conclusion":{"author_byte_range":null,"name":null,"proposition_id":"w4nwcqfp","tokens":{"author":{"child":{"children":[{"node":"text","text":"∀ ("},{"child":{"node":"text","text":"releasedBurden "},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"releasedBurden ","token_id":"hmhhcnw7.safe_retirement_gain_of_burden_release::author/conclusion::1","token_role":null}},{"child":{"node":"text","text":"capabilityLoss"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/","text":"capabilityLoss","token_id":"hmhhcnw7.safe_retirement_gain_of_burden_release::author/conclusion::2","token_role":null}},{"node":"text","text":" : "},{"child":{"node":"text","text":"Nat"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type","kind":"stdlib","qualified_name":"Nat","subexpr_pos":"/1/0","text":"Nat","token_id":"hmhhcnw7.safe_retirement_gain_of_burden_release::author/conclusion::3","token_role":null}},{"node":"text","text":"),\n  "},{"child":{"children":[{"child":{"children":[{"child":{"node":"text","text":"capabilityLoss"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summa