ode":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.getSemantics","subexpr_pos":"/1/1","text":"Axiom.getSemantics \"has a serious moral claim not to be intentionally killed\" arg0","token_id":"mnpz4yrv.HumanLifeMoralWorth.HasSeriousMoralClaimNotToBeIntentionallyKilled::empty/value::5","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"And","subexpr_pos":"/1","text":"mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.Is arg0 ∧\n    Axiom.getSemantics \"has a serious moral claim not to be intentionally killed\" arg0","token_id":"mnpz4yrv.HumanLifeMoralWorth.HasSeriousMoralClaimNotToBeIntentionallyKilled::empty/value::2","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type → Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun arg0 =>\n  mnpz4yrv.HumanLifeMoralWorth.HumanOrganism.Is arg0 ∧\n    Axiom.getSemantics \"has a serious moral claim not to be intentionally killed\" arg0","token_id":"mnpz4yrv.HumanLifeMoralWorth.HasSeriousMoralClaimNotToBeIntentionallyKilled::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\nimport A.j12bzjgj\n\nopen t0d1zdc3\nopen gwcwyrvb\nopen j12bzjgj\nopen c424c6bg\nopen BFO\n\nnamespace mnpz4yrv\n\nnamespace HumanLifeMoralWorth\n\nrigid universal HumanOrganism extends Object := \"living human organism\"\nrigid universal Fertilization extends Process := \"fertilization\"\n\nrelation BeginsToExistWhenFertilizationIsComplete :\n  HumanOrganism → Fertilization := \"begins to exist when fertilization is complete\"\nrelation HasInherentMoralWorth : HumanOrganism :=\n  \"has inherent moral worth regardless of developmental stage, size, ability, health, or dependence\"\nrelation HasSeriousMoralClaimNotToBeIntentionallyKilled : HumanOrganism :=\n  \"has a serious moral claim not to be intentionally killed\"\n\ndef FertilizationBeginsHumanOrganismExistence : Prop :=\n  ∀ h : HumanOrganism, ∃ f : Fertilization,\n    BeginsToExistWhenFertilizationIsComplete h f\n\ndef EveryHumanOrganismHasInherentMoralWorth : Prop :=\n  ∀ h : HumanOrganism, HasInherentMoralWorth h\n\ndef InherentMoralWorthGivesSeriousClaimNotToBeIntentionallyKilled : Prop :=\n  ∀ h : HumanOrganism,\n    HasInherentMoralWorth h →\n      HasSeriousMoralClaimNotToBeIntentionallyKilled h\n\ndef EveryHumanOrganismHasSeriousMoralClaimFromFertilization : Prop :=\n  ∀ h : HumanOrganism,\n    (∃ f : Fertilization, BeginsToExistWhenFertilizationIsComplete h f) ∧\n      HasSeriousMoralClaimNotToBeIntentionallyKilled h\n\ntheorem human_organism_has_serious_moral_claim_from_fertilization\n    (logic_is_actual : LogicIsActual)\n    (fertilization_begins_human_organism_existence :\n      A FertilizationBeginsHumanOrganismExistence)\n    (every_human_organism_has_inherent_moral_worth :\n      A EveryHumanOrganismHasInherentMoralWorth)\n    (inherent_moral_worth_gives_serious_claim_not_to_be_intentionally_killed :\n      A InherentMoralWorthGivesSeriousClaimNotToBeIntentionallyKilled) :\n    A EveryHumanOrganismHasSeriousMoralClaimFromFertilization := by\n  exact\n    logic_is_actual.mp _ _\n      (logic_is_actual.mp _ _\n        (logic_is_actual.mp _ _\n          (logic_is_actual.actual_intro _\n            (by\n              intro begins hasWorth worthGivesClaim h\n              exact ⟨begins h, worthGivesClaim h (hasWorth h)⟩))\n          fertilization_begins_human_organism_existence)\n        every_human_organism_has_inherent_moral_worth)\n      inherent_moral_worth_gives_serious_claim_not_to_be_intentionally_killed\n\nend HumanLifeMoralWorth\n\nend mnpz4yrv\n","members":[],"source_lines":{"end":24,"start":23},"theorem_statement":null},"referenced_by":[{"def_id":"dcxc0rjy","display_kind":"definition","file_id":"mnpz4yrv","kind":"definition","local_name":"HumanLifeMoralWorth.EveryHumanOrganismHasSeriousMoralClaimFromFertilization","qualified_name":"mnpz4yrv.HumanLifeMoralWorth.EveryHumanOrganismHasSeriousMoralClaimFromFertilization"},{"def_id":"nj497mbx","display_kind":"theorem","file_id":"mnpz4yrv","kind":"theorem","local_name":"HumanLifeMoralWorth.human_organism_has_serious_moral_claim_from_fertilization","qualified_name":"mnpz4yrv.HumanLifeMoralWorth.human_organism_has_serious_moral_claim_from_fertilization"},{"def_id":"yvzr8xk1","display_kind":"definition","file_id":"mnpz4yrv","kind":"definition","local_name":"HumanLifeMoralWorth.InherentMoralWorthGivesSeriousClaimNotToBeIntentionallyKilled","qualified_name":"mnpz4yrv.HumanLifeMoralWorth.InherentMoralWorthGivesSeriousClaimNotToBeIntentionallyKilled"}]}
