litySet::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.t0d1zdc3\nimport A.gwcwyrvb\n\nopen t0d1zdc3\nopen gwcwyrvb\n\nnamespace g5rfy225\n\n-- Hunter Ash: https://x.com/ArtemisConsort/status/2030019327928492320\n\ndef IsAISystem : Type → Prop := \"is an AI system\"\ndef IsConscious : Type → Prop := \"is conscious\"\ndef IsCapabilitySet : Type → Prop := \"is a set of capabilities\"\ndef Possesses : Type → Type → Prop := \"possesses\"\n\ndef AICanNeverBeConscious : Prop :=\n  ∀ s : Type, IsAISystem s → ¬ IsConscious s\n\ndef SufficesForConsciousness (c : Type) : Prop :=\n  ∀ s : Type, Possesses s c → IsConscious s\n\ndef SomeCapabilitiesSufficeForConsciousness : Prop :=\n  ∃ c : Type, IsCapabilitySet c ∧ SufficesForConsciousness c\n\ndef ConsciousnessLinkedToCapabilitiesAIWillNeverPossess : Prop :=\n  ∃ c : Type, IsCapabilitySet c ∧ SufficesForConsciousness c ∧\n    ∀ s : Type, IsAISystem s → ¬ Possesses s c\n\ntheorem denying_ai_consciousness_requires_one_of_two_beliefs\n    (logic_is_actual : LogicIsActual)\n    (skeptic : A AICanNeverBeConscious) :\n    A ConsciousnessLinkedToCapabilitiesAIWillNeverPossess ∨\n      A (¬ SomeCapabilitiesSufficeForConsciousness) :=\n  (Classical.em SomeCapabilitiesSufficeForConsciousness).elim\n    (fun suff =>\n      Or.inl (logic_is_actual.mp _ _\n        (logic_is_actual.actual_intro _\n          (fun never_conscious =>\n            suff.elim fun c hc =>\n              ⟨c, hc.1, hc.2, fun s s_ai s_has =>\n                never_conscious s s_ai (hc.2 s s_has)⟩))\n        skeptic))\n    (fun not_suff => Or.inr (logic_is_actual.actual_intro _ not_suff))\n\nend g5rfy225\n","members":[],"source_lines":{"end":14,"start":14},"theorem_statement":null},"referenced_by":[{"def_id":"r3p1heby","display_kind":"definition","file_id":"cdh3w951","kind":"definition","local_name":"AIWillPossessCapabilitiesLinkedToConsciousness","qualified_name":"cdh3w951.AIWillPossessCapabilitiesLinkedToConsciousness"},{"def_id":"d47xb8tk","display_kind":"theorem","file_id":"cdh3w951","kind":"theorem","local_name":"some_ai_will_be_conscious","qualified_name":"cdh3w951.some_ai_will_be_conscious"},{"def_id":"rkyb1v31","display_kind":"definition","file_id":"g5rfy225","kind":"definition","local_name":"ConsciousnessLinkedToCapabilitiesAIWillNeverPossess","qualified_name":"g5rfy225.ConsciousnessLinkedToCapabilitiesAIWillNeverPossess"},{"def_id":"wb9wvr5k","display_kind":"theorem","file_id":"g5rfy225","kind":"theorem","local_name":"denying_ai_consciousness_requires_one_of_two_beliefs","qualified_name":"g5rfy225.denying_ai_consciousness_requires_one_of_two_beliefs"},{"def_id":"xnrs9r48","display_kind":"definition","file_id":"g5rfy225","kind":"definition","local_name":"SomeCapabilitiesSufficeForConsciousness","qualified_name":"g5rfy225.SomeCapabilitiesSufficeForConsciousness"}]}
