e":"String","text":"String","token_id":"wrzynm4z.NetworkRelativityDecoderProtocol::src::27","token_role":null}],"type_tokens":{"author":{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Type","token_id":"wrzynm4z.NetworkRelativityDecoderProtocol::author/type::0","token_role":null}},"empty":{"child":{"node":"text","text":"Type"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type 1","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"Type","token_id":"wrzynm4z.NetworkRelativityDecoderProtocol::empty/type::0","token_role":null}}},"value_tokens":null},"file_content":"import Axiom\n\nnamespace wrzynm4z\n\nstructure NetworkRelativityDecoderProtocol where\n  currentTopicSnapshot : String\n  historicalArchive : String\n  retrievalMethods : List String\n  oracleDefinition : String\n  boundedBudget : Nat\n  adjudicationMethod : String\n  primaryOutcome : String\n  falsifier : String\n\n\ndef WellFormedNetworkRelativityDecoderProtocol\n    (p : NetworkRelativityDecoderProtocol) : Prop :=\n  p.currentTopicSnapshot ≠ \"\" ∧\n    p.historicalArchive ≠ \"\" ∧\n    0 < p.boundedBudget ∧\n    p.retrievalMethods ≠ [] ∧\n    p.oracleDefinition ≠ \"\" ∧\n    p.adjudicationMethod ≠ \"\" ∧\n    p.primaryOutcome ≠ \"\" ∧\n    p.falsifier ≠ \"\"\n\n\ndef BoundedDecoderOutperformsRandomBaseline\n    (boundedScore randomScore : Nat) : Prop :=\n  boundedScore > randomScore\n\n\ndef BoundedDecoderRecoversOracleCandidates\n    (boundedRecovered oracleRecovered : Nat) : Prop :=\n  boundedRecovered = oracleRecovered\n\n\ndef ComputationalRetrievalGap\n    (boundedRecovered oracleRecovered : Nat) : Prop :=\n  boundedRecovered < oracleRecovered\n\n\ndef network_relativity_decoder_protocolPayload :=\n  \"The first Network Relativity decoder experiment freezes a current-topic snapshot and historical archive, then compares random, lexical, semantic, bilateral, and expensive-oracle retrieval under a declared bounded budget. Retrieval generates candidates only; blinded human adjudication determines whether a candidate is relevant, partially relevant, a miss, unresolved, or not a prediction.\"\naxiom network_relativity_decoder_protocol_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_decoder_protocolPayload, 1786316117)\ndef network_relativity_decoder_protocol : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_decoder_protocolPayload 1786316117 := ⟨network_relativity_decoder_protocol_auth⟩\n\ndef network_relativity_measurement_boundaryPayload :=\n  \"The primary outcome is recovery of blinded, receipt-backed candidates at bounded computational cost. Semantic similarity, bilateral relevance, engagement, and query rank are retrieval features, not evidence of truth, prediction, cross-pole convergence, or downstream usefulness.\"\naxiom network_relativity_measurement_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_measurement_boundaryPayload, 1786316117)\ndef network_relativity_measurement_boundary : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_measurement_boundaryPayload 1786316117 := ⟨network_relativity_measurement_boundary_auth⟩\n\ndef network_relativity_falsifierPayload :=\n  \"The bounded decoder hypothesis is weakened or rejected if bilateral retrieval does not outperform the declared baselines on blinded adjudication, if an expensive oracle provides no recoverable candidates that bounded methods miss, or if apparent gains disappear under unrelated-topic and random-archive controls.\"\naxiom network_relativity_falsifier_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_falsifierPayload, 1786316117)\ndef network_relativity_falsifier : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_falsifierPayload 1786316117 := ⟨network_relativity_falsifier_auth⟩\n\ndef network_relativity_convergence_boundaryPayload :=\n  \"Cross-polarity penetration is not convergence. A successful intervention requires a separate post-intervention receipt showing reduced explanatory disagreement or validated transfer of the missing evidence; immediate agreement, likes, reposts, or emotional intensity do not establish it.\"\naxiom network_relativity_convergence_boundary_auth : Axiom.AuthenticatedTerm (\"hitchhiker2thefuture\", network_relativity_convergence_boundaryPayload, 1786316117)\ndef network_relativity_convergence_boundary : Axiom.Statement \"hitchhiker2thefuture\" network_relativity_convergence_boundaryPayload 1786316117 := ⟨network_relativity_convergence_boundary_auth⟩\n\nend wrzynm4z\n","members":[{"def_id":"sxypam68","display_kind":"field","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.currentTopicSnapshot","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.currentTopicSnapshot"},{"def_id":"y0c9sqch","display_kind":"constructor","kind":"constructor","local_name":"NetworkRelativityDecoderProtocol.mk","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.mk"},{"def_id":"stme6ehd","display_kind":"field","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.historicalArchive","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.historicalArchive"},{"def_id":"ycqpdmz3","display_kind":"field","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.retrievalMethods","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.retrievalMethods"},{"def_id":"ns51tmkk","display_kind":"field","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.oracleDefinition","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.oracleDefinition"},{"def_id":"j6sjb7xj","display_kind":"field","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.boundedBudget","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.boundedBudget"},{"def_id":"ezy5gdmx","display_kind":"field","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.adjudicationMethod","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.adjudicationMethod"},{"def_id":"ssv5s19w","display_kind":"field","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.primaryOutcome","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.primaryOutcome"},{"def_id":"xszcg3qg","display_kind":"field","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.falsifier","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.falsifier"}],"source_lines":{"end":13,"start":5},"theorem_statement":null},"referenced_by":[{"def_id":"ezy5gdmx","display_kind":"field","file_id":"wrzynm4z","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.adjudicationMethod","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.adjudicationMethod"},{"def_id":"j6sjb7xj","display_kind":"field","file_id":"wrzynm4z","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.boundedBudget","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.boundedBudget"},{"def_id":"sxypam68","display_kind":"field","file_id":"wrzynm4z","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.currentTopicSnapshot","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.currentTopicSnapshot"},{"def_id":"xszcg3qg","display_kind":"field","file_id":"wrzynm4z","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.falsifier","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.falsifier"},{"def_id":"stme6ehd","display_kind":"field","file_id":"wrzynm4z","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.historicalArchive","qualified_name":"wrzynm4z.NetworkRelativityDecoderProtocol.historicalArchive"},{"def_id":"ns51tmkk","display_kind":"field","file_id":"wrzynm4z","kind":"definition","local_name":"NetworkRelativityDecoderProtocol.oracleDefinition","qualified_na