pr_pos":"/1/0/1","text":"\"occurred before 1939\"","token_id":"fk6d4gb9.HypotheticalWorldExample.OccurredBefore1939::empty/value::3","token_role":null}},{"node":"text","text":" "},{"child":{"node":"text","text":"arg0"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":null,"kind":"identifier","qualified_name":null,"subexpr_pos":"/1/1","text":"arg0","token_id":"fk6d4gb9.HypotheticalWorldExample.OccurredBefore1939::empty/value::4","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop","kind":"stdlib","qualified_name":"Axiom.getSemantics","subexpr_pos":"/1","text":"Axiom.getSemantics \"occurred before 1939\" arg0","token_id":"fk6d4gb9.HypotheticalWorldExample.OccurredBefore1939::empty/value::2","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Prop → Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun arg0 => Axiom.getSemantics \"occurred before 1939\" arg0","token_id":"fk6d4gb9.HypotheticalWorldExample.OccurredBefore1939::empty/value::0","token_role":null}}}},"file_content":"import Axiom.Types.Actual\nimport Axiom.Types.SemanticStrings\nimport A.h96pgtwf\nimport A.gwcwyrvb\nimport A.c424c6bg\n\nopen h96pgtwf\nopen gwcwyrvb\nopen c424c6bg\n\nopen Axiom\n\nnamespace fk6d4gb9\n\n-- The example claim we are formalizing.\ndef NazisWonUSASpeakGerman : Prop :=\n  \"if the Nazi's won WWII, German would be the official language of the USA in 2026\"\n\nnamespace HypotheticalWorldExample\n\ndef NazisWon : Prop := \"Nazis won WWII\"\n\nrelation OccurredBefore1939 : Prop := \"occurred before 1939\"\n\ndef GermanOfficialLanguageUSA2026 : Prop :=\n  \"German is the official language of the USA in 2026\"\n\nstructure NazisWonWWIIWorld extends ModalWorld where\n  holds_eq : holds = (\"world where Nazis won WWII\" : Prop → Prop)\n  nazis_won : holds NazisWon\n  -- This world is a \"fork\" of the actual world.\n  -- This Prop asserts it's the exact same as the actual world up until 1939.\n  pre1939 : ∀ p, A p → A (OccurredBefore1939 p) → holds p\n\n-- The more formal version of the example claim.\ndef NazisWonUSASpeakGerman :=\n  ∀ w : NazisWonWWIIWorld, w.holds GermanOfficialLanguageUSA2026\n\nend HypotheticalWorldExample\n\n-- Optionally, one could assert that the semantic string is definitionally equal to the more formal version.\ndef NazisWonUSASpeakGermanDef : Prop :=\n  NazisWonUSASpeakGerman = HypotheticalWorldExample.NazisWonUSASpeakGerman\n\n\nend fk6d4gb9\n","members":[],"source_lines":{"end":23,"start":23},"theorem_statement":null},"referenced_by":[{"def_id":"p64ygnwa","display_kind":"definition","file_id":"fk6d4gb9","kind":"definition","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.casesOn","qualified_name":"fk6d4gb9.HypotheticalWorldExample.NazisWonWWIIWorld.casesOn"},{"def_id":"jd525mkc","display_kind":"constructor","file_id":"fk6d4gb9","kind":"constructor","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.mk","qualified_name":"fk6d4gb9.HypotheticalWorldExample.NazisWonWWIIWorld.mk"},{"def_id":"azcshpr7","display_kind":"field","file_id":"fk6d4gb9","kind":"theorem","local_name":"HypotheticalWorldExample.NazisWonWWIIWorld.pre1939","qualified_name":"fk6d4gb9.HypotheticalWorldExample.NazisWonWWIIWorld.pre1939"}]}
