od_is_good\", god_is_good), (\"i_am_a_person\", i_am_a_person), (\"metabias_is_a_person\", metabias_is_a_person), (\"everyone_makes_mistakes\", everyone_makes_mistakes), (\"all_people_are_immoral\", all_people_are_immoral)]\n\naxiom user_axioms_auth : Axiom.AuthenticatedTerm (\"sam\", userAxiomsList, 1785015567)\n\ndef userAxioms : Axiom.UserAxioms \"sam\" 1785015567 :=\n  ⟨userAxiomsList, user_axioms_auth⟩\n\nend jn8vb7yj\n","members":[],"source_lines":{"end":33,"start":33},"theorem_statement":null},"referenced_by":[{"def_id":"dv3hjbnw","display_kind":"definition","file_id":"jn8vb7yj","kind":"definition","local_name":"userAxiomsList","qualified_name":"jn8vb7yj.userAxiomsList"}]}
