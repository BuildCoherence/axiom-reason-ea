,"kind":"stdlib","qualified_name":"And","subexpr_pos":"/1/1","text":"nwtxrh89.Person.Is arg0 ∧ n82pf9zy.MoralCharacter.Is arg1 ∧ Axiom.getSemantics \"has moral character\" arg0 arg1","token_id":"n82pf9zy.HasMoralCharacter::empty/value::3","token_role":null}}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":null,"hover_kind":"term","inlined_type_summary":"Type → Type → Prop","kind":"op","qualified_name":null,"subexpr_pos":"/","text":"fun arg0 arg1 =>\n  nwtxrh89.Person.Is arg0 ∧ n82pf9zy.MoralCharacter.Is arg1 ∧ Axiom.getSemantics \"has moral character\" arg0 arg1","token_id":"n82pf9zy.HasMoralCharacter::empty/value::0","token_role":null}}}},"file_content":"import Axiom\nimport A.d4qbfhxh\nimport A.xhnxzf59\nimport A.nwtxrh89\n\nopen nwtxrh89\n\nopen d4qbfhxh\nopen xhnxzf59\n\nnamespace n82pf9zy\n\nrigid universal MoralCharacter extends Quality := \"moral character\"\n\nrelation Immoral : Person := \"is immoral\"\nrelation HasMoralCharacter : Person → MoralCharacter := \"has moral character\"\nrelation MoreMoralThan : MoralCharacter → MoralCharacter := \"is more moral than\"\n\nscoped postfix:max \" is-immoral\" => Immoral\nscoped infix:50 \" has-moral-character \" => HasMoralCharacter\nscoped infix:50 \" more-moral-than \" => MoreMoralThan\n\nabbrev LessMoralThan (a b : Type) : Prop := MoreMoralThan b a\n\nscoped infix:50 \" less-moral-than \" => LessMoralThan\n\nstructure MoralComparisonIsCoherent : Prop where\n  more_moral_irreflexive : ∀ m : MoralCharacter, ¬ (m more-moral-than m)\n  more_moral_transitive :\n    ∀ a b c : MoralCharacter,\n      a more-moral-than b → b more-moral-than c → a more-moral-than c\n\ndef ImmoralBelowNonImmoral : Prop :=\n  ∀ (p q : Person) (mp mq : MoralCharacter),\n    p has-moral-character mp →\n    q has-moral-character mq →\n    p is-immoral →\n    ¬ (q is-immoral) →\n    mq more-moral-than mp\n\nstructure PersonsHaveExactlyOneMoralCharacter : Prop where\n  has_one : ∀ p : Person, ∃ m : MoralCharacter, p has-moral-character m\n  at_most_one :\n    ∀ (p : Person) (m m' : MoralCharacter),\n      p has-moral-character m → p has-moral-character m' → m = m'\n\ntheorem more_moral_asymmetric\n    (coherent : MoralComparisonIsCoherent)\n    (a b : MoralCharacter) (h : a more-moral-than b) :\n    ¬ (b more-moral-than a) :=\n  fun h' =>\n    coherent.more_moral_irreflexive a\n      (coherent.more_moral_transitive a b a h h')\n\nend n82pf9zy\n","members":[],"source_lines":{"end":16,"start":16},"theorem_statement":null},"referenced_by":[{"def_id":"a8expf4s","display_kind":"definition","file_id":"n82pf9zy","kind":"definition","local_name":"ImmoralBelowNonImmoral","qualified_name":"n82pf9zy.ImmoralBelowNonImmoral"},{"def_id":"hpejzzjh","display_kind":"field","file_id":"n82pf9zy","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.at_most_one","qualified_name":"n82pf9zy.PersonsHaveExactlyOneMoralCharacter.at_most_one"},{"def_id":"xey32ab9","display_kind":"definition","file_id":"n82pf9zy","kind":"definition","local_name":"PersonsHaveExactlyOneMoralCharacter.casesOn","qualified_name":"n82pf9zy.PersonsHaveExactlyOneMoralCharacter.casesOn"},{"def_id":"jgnwvqfb","display_kind":"field","file_id":"n82pf9zy","kind":"theorem","local_name":"PersonsHaveExactlyOneMoralCharacter.has_one","qualified_name":"n82pf9zy.PersonsHaveExactlyOneMoralCharacter.has_one"},{"def_id":"hbatzn1n","display_kind":"constructor","file_id":"n82pf9zy","kind":"constructor","local_name":"PersonsHaveExactlyOneMoralCharacter.mk","qualified_name":"n82pf9zy.PersonsHaveExactlyOneMoralCharacter.mk"},{"def_id":"r80vm3h5","display_kind":"definition","file_id":"qfqvcx4c","kind":"definition","local_name":"TwoPeopleDifferingInWealth.casesOn","qualified_name":"qfqvcx4c.TwoPeopleDifferingInWealth.casesOn"},{"def_id":"kx8vwzdm","display_kind":"constructor","file_id":"qfqvcx4c","kind":"constructor","local_name":"TwoPeopleDifferingInWealth.mk","qualified_name":"qfqvcx4c.TwoPeopleDifferingInWealth.mk"},{"def_id":"jbk0r5ga","