ksKnowledgeAndUnderstanding : Person := \"lacks knowledge and understanding\"\n\npostfix:max \" makes-mistakes\" => MakesMistakes\npostfix:max \" should-work-toward-correcting-their-mistakes\" =>\n  ShouldWorkTowardCorrectingTheirMistakes\npostfix:max \" lacks-knowledge-and-understanding\" => LacksKnowledgeAndUnderstanding\n\ndef EveryoneMakesMistakes : Prop := ∀ p : Person, p makes-mistakes\n\ndef IShouldWorkTowardCorrectingMyMistakes : Prop :=\n  MetaBias should-work-toward-correcting-their-mistakes\n\ndef ILackKnowledgeAndUnderstanding : Prop :=\n  MetaBias lacks-knowledge-and-understanding\n\ntheorem i_make_mistakes\n    (logic_is_actual : LogicIsActual)\n    (i_am_a_person : A (Person.Is MetaBias))\n    (everyone_makes_mistakes : A EveryoneMakesMistakes) :\n    A (MetaBias makes-mistakes) :=\n  logic_is_actual.mp _ _\n    (logic_is_actual.mp _ _\n      (logic_is_actual.actual_intro _\n        (fun everyone_including h => everyone_including ⟨MetaBias, h⟩))\n      everyone_makes_mistakes)\n    i_am_a_person\n\nend rwj5ranz\n","members":[],"source_lines":{"end":38,"start":28},"theorem_statement":{"conclusion":{"author_byte_range":{"end":1073,"start":1046},"name":null,"proposition_id":"d2x0fc7s","tokens":{"author":{"child":{"children":[{"node":"text","text":"A "},{"child":{"children":[{"child":{"node":"text","text":"MetaBias"},"node":"tag","tag":{"binder_role":"use_site","def_id":"fvjq0y6b","hover_kind":"term","inlined_type_summary":"Type","kind":"type","qualified_name":"rwj5ranz.MetaBias","subexpr_pos":"/1/1","text":"MetaBias","token_id":"rwj5ranz.i_make_mistakes::author/conclusion::2","token_role":null}},{"node":"text","text":" makes-mistakes"}],"node":"append"},"node":"tag","tag":{"binder_role":"use_site","def_id":"wzaf2hpr","hover_kind":"term","inlined_type_summary":"Prop","kind":"type","qualified_name":"rwj5ranz.MakesMistakes","subexpr_pos":"/1","text":"MetaBias makes-mistakes","token_id":"rwj5ranz.i_make_mistakes::author/conclusion::1","token_role":null}}],"n